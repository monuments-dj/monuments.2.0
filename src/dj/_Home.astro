document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// velocity marquee with decay back to base
(function(){
  let ly=scrollY,decaying=false;
  const anims=()=>[...document.querySelectorAll('.tiles .track')].map(el=>el.getAnimations&&el.getAnimations()[0]).filter(Boolean);
  function decay(){
    let live=false;
    anims().forEach(a=>{if(a.playbackRate>1.03){a.playbackRate=1+(a.playbackRate-1)*0.92;live=true}else a.playbackRate=1});
    decaying=live;if(live)requestAnimationFrame(decay);
  }
  addEventListener('scroll',()=>{
    const vel=Math.min(3,Math.abs(scrollY-ly)/18);ly=scrollY;
    anims().forEach(a=>a.playbackRate=Math.max(a.playbackRate,1+vel));
    if(!decaying){decaying=true;requestAnimationFrame(decay)}
  },{passive:true});
})();
function clock(){
  const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});
  document.getElementById('clock').textContent='LA '+t;
}
clock();setInterval(clock,30000);

// reel: background video header + sound-on showreel (self-hosted cuts)
(function(){
  const hm=document.getElementById('heroMedia');
  if(hm && matchMedia('(pointer:fine)').matches && innerWidth>900 && !matchMedia('(prefers-reduced-motion:reduce)').matches){
    const v=document.createElement('video');
    v.src='/reel/work-reel.mp4';v.muted=true;v.loop=true;v.autoplay=true;
    v.playsInline=true;v.setAttribute('playsinline','');v.setAttribute('aria-hidden','true');
    hm.appendChild(v);
    const go=()=>hm.classList.add('live');
    v.addEventListener('playing',go,{once:true});
    v.play().catch(()=>{});
    setTimeout(go,1800);
  }
  const rp=document.getElementById('rrPanel');
  if(rp){
    const rv=rp.querySelector('video');
    let live=false;
    rp.addEventListener('click',()=>{
      if(!rv||live)return;
      live=true;
      rp.closest('.rr').classList.add('rr-live');
      rp.style.transform='translate(-50%,-50%) scale(1)';
      rv.pause();
      rv.src='/reel/full-reel.mp4';
      rv.muted=false;rv.loop=false;rv.controls=true;rv.preload='auto';
      rv.removeAttribute('aria-hidden');
      rv.play();
      new IntersectionObserver(es=>es.forEach(e=>{
        if(!e.isIntersecting&&!rv.paused)rv.pause();
      }),{threshold:.2}).observe(rp.closest('.rr'));
    });
  }
})();

// footer under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  if(!uf||!over)return;
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
// spark companion: drifts + rotates with scroll
(function(){
  const c=document.querySelector('.companion');
  if(!c||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let cTick=false;
  addEventListener('scroll',()=>{
    if(cTick)return;cTick=true;
    requestAnimationFrame(()=>{
      c.style.transform=`translateY(${(Math.sin(scrollY/420)*34).toFixed(1)}px) rotate(${(scrollY*0.22).toFixed(1)}deg)`;
      cTick=false;
    });
  },{passive:true});
})();

// reel cards: hover panel + persistent proof line + visible-mount snips
(function(){
  document.querySelectorAll('.reel-card').forEach(function(card){
    var imgs=card.querySelector('.imgs'); if(!imgs) return;
    var role=card.dataset.role, stats=(card.dataset.stats||'').split('|').filter(Boolean);
    if(role||stats.length){
      var panel=document.createElement('div'); panel.className='rc-panel';
      panel.innerHTML=(role?'<span class="role">'+role+'</span>':'')+(stats.length?'<ul>'+stats.map(function(x){return '<li>'+x+'</li>';}).join('')+'</ul>':'');
      imgs.appendChild(panel);
    }
    var meta=card.querySelector('.rc-meta');
    if(meta&&(role||stats.length)){
      var proof=document.createElement('span'); proof.className='rc-proof mono';
      proof.textContent=[role,stats[0]].filter(Boolean).join(' · ');
      var code=meta.querySelector(':scope > .mono');
      meta.insertBefore(proof, code||null);
    }
    var snip=card.dataset.snip;
    if(snip&&!matchMedia('(prefers-reduced-motion:reduce)').matches){
      new IntersectionObserver(function(es,o){
        es.forEach(function(e){
          if(!e.isIntersecting||card.querySelector('.imgs video'))return;
          var v=document.createElement('video'); v.src=snip; v.muted=true; v.loop=true; v.playsInline=true;
          v.setAttribute('autoplay',''); v.setAttribute('playsinline',''); v.setAttribute('aria-hidden','true'); v.preload='none';
          imgs.appendChild(v); v.play().then(function(){v.classList.add('live');}).catch(function(){});
          o.disconnect();
        });
      },{threshold:.25}).observe(card);
    }
  });
})();

// pinned reel scrub
(function(){
  const sec=document.querySelector('.reel'),track=document.getElementById('reelTrack'),
        word=document.getElementById('feelWord'),lead=document.getElementById('feelLead'),
        fto=document.getElementById('feelTo'),ticks=document.getElementById('ticks');
  if(!sec||!track)return;
  const cards=[...track.querySelectorAll('.reel-card:not(.spacer)')];
  ticks.innerHTML=cards.map(()=>'<i></i>').join('');
  const tickEls=[...ticks.children];
  let cur=-1;
  function setWord(i){
    if(i===cur)return;cur=i;
    word.textContent=cards[i].dataset.word;
    if(fto)fto.textContent=cards[i].dataset.to||'to';
    if(lead)lead.textContent=('lead' in cards[i].dataset)?cards[i].dataset.lead:'be';
    word.classList.remove('swap');void word.offsetWidth;word.classList.add('swap');
    tickEls.forEach((el,j)=>el.classList.toggle('on',j===i));
  }
  setWord(0);
  if(matchMedia('(prefers-reduced-motion:reduce)').matches||innerWidth<=900)return;
  let rTick=false;
  addEventListener('scroll',()=>{
    if(rTick)return;rTick=true;
    requestAnimationFrame(()=>{
      const vh=innerHeight,r=sec.getBoundingClientRect();
      const total=r.height-vh;
      const p0=Math.min(1,Math.max(0,-r.top/total));
      const p=Math.min(1,p0/0.94);
      const lastC=cards[cards.length-1];
      const off=lastC.getBoundingClientRect().left-track.getBoundingClientRect().left;
      const max=Math.max(0,off+lastC.offsetWidth/2-innerWidth/2);
      track.style.transform=`translateX(${-p*max}px)`;
      const rv=(p-(window.__rp||p))*140;window.__rp=p;
      cards.forEach((c,i)=>{c.style.transform=`translateY(${(Math.sin(p*5+i*1.7)*12).toFixed(1)}px) rotate(${(Math.max(-2.4,Math.min(2.4,rv))*(i%2?-.5:.5)).toFixed(2)}deg)`});
      setWord(Math.min(cards.length-1,Math.floor(p*cards.length)));
      rTick=false;
    });
  },{passive:true});
})();

// hero parallax: media drifts, lockup counter-drifts
if(!matchMedia('(prefers-reduced-motion:reduce)').matches){
  const hT=document.querySelector('.hero .t');
  let hTick=false;
  addEventListener('scroll',()=>{
    if(hTick)return;hTick=true;
    requestAnimationFrame(()=>{
      const y=scrollY;
      if(y<innerHeight){
        const hm=document.getElementById('heroMedia');
        if(hm)hm.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        if(hT)hT.style.transform=`translateY(${y*-.1}px)`;
        if(hT)hT.style.opacity=String(Math.max(0,1-y/(innerHeight*.9)));
      }
      hTick=false;
    });
  },{passive:true});
}
</script>

<script is:inline>
// Trusted By The Best - Solari-board rotator (6 cells, 13 brands, one roll at a time)
(function(){
  // TWO POOLS (DJ 2026-08-13: "randomize, but keep the more impressive brands
  // at the top"): the top row only ever shows the global names, the bottom row
  // rotates the rest. Both pools shuffle per visit; hover also rolls a cell.
  var TOP=[
    ['sony','Sony',532,94],['intel','Intel',551,214],['adorama','Adorama',576,94],
    ['msi','MSI',549,184],['lexar','Lexar',535,142],['dw-drums','DW Drums',400,214]
  ];
  var REST=[
    ['art-of-visuals','Art of Visuals',707,99],['flashpoint','Flashpoint',591,52],
    ['donut-media','Donut Media',1200,561],['blue-cross','Blue Cross of Idaho',761,147],
    ['ac-boise','AC Boise',989,1200],['against','Against',560,163],
    ['cwi','College of Western Idaho',174,72]
  ];
  function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}
  shuffle(TOP); shuffle(REST);
  var grid=document.getElementById('tbGrid'); if(!grid) return;
  var cells=[].slice.call(grid.querySelectorAll('.tb-cell'));
  if(cells.length!==6) return;
  var ptrs={t:0,r:0}, timer=null, rolling={};
  // what each cell shows now, so a roll never duplicates a visible brand
  var current=cells.map(function(c){var im=c.querySelector('img');return im?im.alt:''});
  function next(ci){
    var P=ci<3?TOP:REST, k=ci<3?'t':'r', b;
    for(var tries=0;tries<P.length;tries++){
      b=P[ptrs[k]%P.length]; ptrs[k]++;
      if(current.indexOf(b[1])===-1) return b;
    }
    return b;
  }
  function roll(ci){
    if(rolling[ci]) return;
    var cell=cells[ci], b=next(ci);
    current[ci]=b[1];
    var old=cell.querySelector('.tb-flap');
    var nf=document.createElement('span'); nf.className='tb-flap in';
    var img=document.createElement('img');
    img.src='/logos/'+b[0]+'-black.png'; img.alt=b[1]; img.decoding='async';
    img.width=b[2]; img.height=b[3];
    img.className='b-'+b[0]+(b[0]==='ac-boise'?' tall':'');
    nf.appendChild(img); cell.appendChild(nf);
    cell.setAttribute('aria-label',b[1]+' · tap for the next brand');
    rolling[ci]=true;
    requestAnimationFrame(function(){requestAnimationFrame(function(){
      old.classList.add('out'); nf.classList.add('go');
    });});
    setTimeout(function(){
      if(old.parentNode) old.parentNode.removeChild(old);
      nf.classList.remove('in','go'); rolling[ci]=false;
    },620);
  }
  cells.forEach(function(c,i){
    c.addEventListener('click',function(){roll(i);});
    if(matchMedia('(pointer:fine)').matches)c.addEventListener('pointerenter',function(){roll(i);});
  });
  var reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
  function start(){ if(timer||reduced) return;
    timer=setInterval(function(){ if(document.hidden) return; roll(Math.floor(Math.random()*6)); },3000); }
  function stop(){ if(timer){clearInterval(timer); timer=null;} }
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es){
      es.forEach(function(e){ e.isIntersecting?start():stop(); });
    },{threshold:.25}).observe(document.getElementById('trusted'));
  } else start();
})();
</script>
</body>
