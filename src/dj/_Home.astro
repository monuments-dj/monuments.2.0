<script is:inline>
// hero: mouse-tracked rigid tilt on the lockup (the monuments move)
(function(){
  const inner=document.getElementById('hero-tilt');
  if(!inner||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  if(!matchMedia('(pointer:fine)').matches)return;
  let mx=0,my=0,cx=0,cy=0;
  const MAX_Y=18,MAX_X=12,SHIFT=26;
  addEventListener('mousemove',(e)=>{mx=(e.clientX/innerWidth-0.5)*2;my=(e.clientY/innerHeight-0.5)*2;},{passive:true});
  (function tick(){
    cx+=(mx-cx)*0.09;cy+=(my-cy)*0.09;
    const ry=cx*MAX_Y,rx=-cy*MAX_X,tx=cx*SHIFT,ty=cy*SHIFT*0.5;
    inner.style.transform=`translate3d(${tx}px,${ty}px,0) rotateX(${rx}deg) rotateY(${ry}deg)`;
    requestAnimationFrame(tick);
  })();
})();
</script>
<script is:inline>
// Play/Reel scrub, the exact monuments timing (measured off monuments.cc)
(function(){
  const sec=document.querySelector('.rr');
  if(!sec||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  const panel=document.getElementById('rrPanel'),wl=sec.querySelector('.rr-l'),wr=sec.querySelector('.rr-r');
  let raf=null;
  function upd(){
    raf=null;
    if(sec.classList.contains('rr-live'))return;
    const r=sec.getBoundingClientRect();
    const total=r.height-innerHeight; if(total<=0)return;
    const ih=innerHeight;
    const raw=(ih-r.top)/ih;
    const p=Math.min(1,Math.max(0,-r.top/total));
    const wp=Math.min(1,Math.max(0,(raw-0.28)/0.30));
    const wo=Math.max(0,1-Math.max(0,(raw-1.25)/0.35));
    const wx=(1-wp)*260;
    wl.style.transform=`translate(${-wx}%,-50%)`;
    wr.style.transform=`translate(${wx}%,-50%)`;
    wl.style.opacity=wr.style.opacity=(Math.min(1,wp*1.5)*wo).toFixed(3);
    const arrive=Math.min(1,Math.max(0,raw));
    const s=p>0 ? Math.min(1,0.573+0.64*p) : 0.525+0.048*arrive;
    const dy=(1-arrive)*10;
    panel.style.transform=`translate(-50%,-50%) translateY(${dy.toFixed(2)}vh) scale(${s.toFixed(4)})`;
  }
  function req(){if(!raf)raf=requestAnimationFrame(upd)}
  addEventListener('scroll',req,{passive:true});addEventListener('resize',req,{passive:true});
  upd();
})();
</script>
