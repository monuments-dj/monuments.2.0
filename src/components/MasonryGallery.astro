---
// MasonryGallery.astro - Kit ELEMENT 26: a masonry grid that opens a lightbox
// (click a cell, ← → or arrows to move, esc / click-out to close). Optional camera
// EXIF rides in the caption. Self-contained + multi-instance safe (one shared
// lightbox built once, nav scoped to the grid you clicked). Replaces the .frames
// contact sheet sitewide.
//
// v2 (2026-07-27): video cells + dark tone + build-time dims.
//   - { video:'/x.mp4', w, h } renders a muted looping cell; the lightbox plays it
//     with controls + sound (the click IS the tap-for-sound gesture).
//   - { href } adds an outbound "On Instagram ↗" link in the lightbox caption.
//   - tone="dark" flips the section to ink for dark bands (flow rule intact).
//   - Cells missing w/h get intrinsic dims at build via src/lib/imgdims.mjs -
//     every img/video ships width/height (packer + unsized-images insurance).
//
//   <MasonryGallery
//     title="Contact sheet"
//     note="12 frames"
//     images={[{ src:'/…/01.jpg', cap:'Campaign', cam:'Sony A7R III · 35mm · f/1.4' }]}
//   />
import { imgDims } from '../lib/imgdims.mjs';
interface Cell { src?: string; video?: string; w?: number; h?: number; cap?: string; cam?: string; alt?: string; href?: string; }
interface Props { images: Cell[]; title?: string; note?: string; tone?: 'light' | 'dark'; }
const { images = [], title = 'Gallery', note, tone = 'light' } = Astro.props;
const cells = images.map(c => {
  if (!c.video && c.src && (!c.w || !c.h)) { const d = imgDims(c.src); if (d) return { ...c, ...d }; }
  return c;
});
---
<section class={tone === 'dark' ? 'mzn mzn-dark' : 'mzn'}><div class="wrap">
  <div class="mzn-bar">
    <span class="mono"><b>{title}</b></span>
    {note && <span class="mono mzn-note">{note}</span>}
  </div>
  <div class="mzn-grid">
    {cells.map((m, i) => (
      <button class="mzn-cell" type="button" data-full={m.video ? '' : m.src} data-video={m.video || ''} data-cap={m.cap || ''} data-cam={m.cam || ''} data-href={m.href || ''} aria-label={`Open ${m.cap || (m.video ? 'video ' : 'image ') + (i + 1)}`}>
        {m.video
          ? <video src={m.video} width={m.w} height={m.h} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
          : <img src={m.src} alt={m.alt || m.cap || `Gallery image ${i + 1}`} width={m.w} height={m.h} loading="lazy" decoding="async">}
      </button>
    ))}
  </div>
</div></section>
<style is:global>
.mzn{background:var(--paper,#F5F3EF);color:var(--ink,#161514);padding:9vh 0}
.mzn .mzn-bar{max-width:var(--wrap,1380px);display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;padding-bottom:14px;border-bottom:1px solid var(--line,#dcd9d2);margin-bottom:22px}
.mzn .mzn-bar b{color:var(--red,#E0311A);font-weight:400}
.mzn .mzn-note{color:#6c6a64}
.mzn-dark{background:var(--ink,#161514);color:var(--paper,#F5F3EF)}
.mzn-dark .mzn-bar{border-bottom-color:var(--lined,#2c2b29)}
.mzn-dark .mzn-bar b{color:var(--spark,#EFA1AD)}
.mzn-dark .mzn-note{color:#8f8d88}
.mzn-grid{columns:3;column-gap:14px}
.mzn-cell{display:block;width:100%;padding:0;margin:0 0 14px;border:0;background:none;cursor:zoom-in;break-inside:avoid;overflow:hidden;border-radius:2px}
.mzn-cell img,.mzn-cell video{width:100%;height:auto;display:block;transition:transform .6s cubic-bezier(.22,1,.36,1),filter .4s;filter:saturate(.97)}
.mzn-cell:hover img,.mzn-cell:hover video{transform:scale(1.04);filter:saturate(1.05)}
@media(max-width:820px){.mzn-grid{columns:2}}
@media(max-width:480px){.mzn-grid{columns:1}}
.mzn-lbox{position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;background:rgba(8,8,8,.93);opacity:0;pointer-events:none;transition:opacity .32s}
.mzn-lbox.on{opacity:1;pointer-events:auto}
.mzn-lbox .mzn-fig{margin:0;display:inline-flex;flex-direction:column;max-width:92vw;max-height:88vh}
.mzn-lbox img,.mzn-lbox video{max-width:92vw;max-height:80vh;width:auto;object-fit:contain;box-shadow:0 20px 70px rgba(0,0,0,.6)}
.mzn-lbox .mzn-cap{width:100%;margin-top:13px;display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap}
.mzn-cap .mzn-camp{font-family:var(--mono,monospace);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#fff}
.mzn-cap .mzn-camp:empty{display:none}
.mzn-cap .mzn-lnk{font-family:var(--mono,monospace);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:underline;text-underline-offset:3px}
.mzn-cap .mzn-cam{font-family:var(--mono,monospace);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,243,239,.4);margin-left:auto}
.mzn-cap .mzn-cam:empty{display:none}
.mzn-lbox>button{position:absolute;background:none;border:0;color:#fff;cursor:pointer;font-family:var(--mono,monospace)}
.mzn-lbox .mzn-close{top:20px;right:26px;font-size:24px}
.mzn-lbox .mzn-prev{left:18px;top:50%;transform:translateY(-50%);font-size:44px;padding:12px}
.mzn-lbox .mzn-next{right:18px;top:50%;transform:translateY(-50%);font-size:44px;padding:12px}
@media(prefers-reduced-motion:reduce){.mzn-cell img,.mzn-cell video{transition:none}}
</style>
<script is:inline>
(function(){
  if(window.__mznInit)return; window.__mznInit=1;
  function boot(){
    var grids=[].slice.call(document.querySelectorAll('.mzn-grid'));
    if(!grids.length)return;
    var lb=document.createElement('div');
    lb.className='mzn-lbox'; lb.setAttribute('role','dialog'); lb.setAttribute('aria-label','Media viewer');
    lb.innerHTML='<button class="mzn-close" type="button" aria-label="Close">✕</button><button class="mzn-prev" type="button" aria-label="Previous">←</button><button class="mzn-next" type="button" aria-label="Next">→</button><figure class="mzn-fig"><img alt="" style="display:none"><video controls playsinline loop style="display:none"></video><figcaption class="mzn-cap"><span class="mzn-camp"></span><span class="mzn-lnkslot"></span><span class="mzn-cam"></span></figcaption></figure>';
    document.body.appendChild(lb);
    var img=lb.querySelector('img'),vid=lb.querySelector('video'),camp=lb.querySelector('.mzn-camp'),cam=lb.querySelector('.mzn-cam'),lnkslot=lb.querySelector('.mzn-lnkslot'),group=[],idx=0;
    function stopVid(){vid.pause();vid.removeAttribute('src');vid.load();vid.style.display='none';}
    function show(n){
      idx=(n+group.length)%group.length;var c=group[idx];
      var vsrc=c.getAttribute('data-video');
      if(vsrc){img.style.display='none';img.src='';vid.style.display='';if(vid.getAttribute('src')!==vsrc){vid.setAttribute('src',vsrc);}vid.muted=false;vid.play().catch(function(){});}
      else{stopVid();img.style.display='';img.src=c.getAttribute('data-full');}
      camp.textContent=c.getAttribute('data-cap')||'';cam.textContent=c.getAttribute('data-cam')||'';
      // the anchor exists ONLY while a linked cell is open - an href-less template
      // <a> in the DOM flags crawlable-anchors on every page carrying a gallery
      var h=c.getAttribute('data-href');
      lnkslot.innerHTML=h?'<a class="mzn-lnk" href="'+h+'" target="_blank" rel="noopener">On Instagram ↗</a>':'';
    }
    function open(cells,n){group=cells;show(n);lb.classList.add('on');document.body.style.overflow='hidden';}
    function close(){lb.classList.remove('on');img.src='';stopVid();document.body.style.overflow='';}
    grids.forEach(function(grid){
      var cells=[].slice.call(grid.querySelectorAll('.mzn-cell'));
      cells.forEach(function(c,n){c.addEventListener('click',function(){open(cells,n);});});
    });
    lb.querySelector('.mzn-close').addEventListener('click',close);
    lb.querySelector('.mzn-next').addEventListener('click',function(){show(idx+1);});
    lb.querySelector('.mzn-prev').addEventListener('click',function(){show(idx-1);});
    lb.addEventListener('click',function(e){if(e.target===lb)close();});
    document.addEventListener('keydown',function(e){if(!lb.classList.contains('on'))return;if(e.key==='Escape')close();else if(e.key==='ArrowRight')show(idx+1);else if(e.key==='ArrowLeft')show(idx-1);});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script>
