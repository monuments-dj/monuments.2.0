---
// PageFooter.astro · the one true footer, one baseline, centered.
// `tag` is the per-page sign-off (DJ likes that it differs on every page:
// "Photography", "About", "Case file MC-2023-05"...). Styling lives HERE so
// pages can never drift apart again. Self-contained: no reliance on page .wrap.
import MenuTakeover from './MenuTakeover.astro';
interface Props { tag: string; }
const { tag } = Astro.props;
---
<MenuTakeover />
<footer class="pfoot">
  <div class="row">
    <span>Monuments &copy; MMXXVI &middot; ELMT.NO.004259</span>
    <span class="blk">built to be remembered</span>
    <span>{tag}</span>
  </div>
</footer>

<!-- TEMP design tool: accent + type switcher (remove before launch, see LAUNCH.md).
     Accent: B/W is the working default (DJ 2026-07-09: kill the pink for now, let the
     work speak); rose/cobalt/red stay for comparison. B/W = struct+quote go ink, spark
     goes paper, band text rides --on-rgb. Type: display-font candidates, all free
     (Google/Fontshare); serif + mono stay, they are identity anchors. -->
<div class="acctool" id="acctool">
  <span class="acctool-l">accent</span>
  <button data-acc="bw" style="--sw:linear-gradient(135deg,#161514 50%,#F5F3EF 50%)" title="Black + white" aria-label="Black and white accent"></button>
  <button data-acc="rose" style="--sw:#EFA1AD" title="Rose" aria-label="Rose accent"></button>
  <button data-acc="cobalt" style="--sw:#2438E8" title="Cobalt" aria-label="Cobalt accent"></button>
  <button data-acc="red" style="--sw:#E0311A" title="Red" aria-label="Red accent"></button>
  <span class="acctool-l acctool-div">type</span>
  <button data-font="cut" title="01 CUT (current) · Bricolage Grotesque everything + Instrument Serif accent">01</button>
  <button data-font="tiny" title="02 TINY · Inter headers + body, Fraunces italic accent · tinywins DNA (Suisse Intl x ABC Gramercy)">02</button>
  <button data-font="haus" title="03 HAUS · Instrument Sans headers + body, Instrument Serif accent · one foundry, Lausanne/Aeonik lane (Unusual, lusion)">03</button>
  <button data-font="wide" title="04 WIDE · Archivo Expanded headers, Archivo body, Spectral italic accent · GT America lane (mssngpeces) + Against's serif">04</button>
  <button data-font="mdrn" title="05 MDRN · Satoshi headers + body, Gambetta italic accent · Fontshare, portfolio-modern">05</button>
  <button class="acctool-x" title="Hide (until you clear site data)" aria-label="Hide switcher">&times;</button>
</div>

<style>
.pfoot{background:var(--ink,#161514);color:var(--dim,#8f8d88);border-top:1px solid var(--lined,#2c2b29);padding:34px 0 18px;position:relative;z-index:3}
.pfoot .row{display:flex;justify-content:center;align-items:baseline;flex-wrap:wrap;gap:8px 22px;
  max-width:var(--wrap,1380px);margin:0 auto;padding-left:var(--pad,clamp(22px,4.6vw,44px));padding-right:var(--pad,clamp(22px,4.6vw,44px))}
.pfoot span{font-family:var(--mono,'Fragment Mono',monospace);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim,#8f8d88)}
.pfoot .blk{text-transform:none}

.acctool{position:fixed;left:50%;bottom:12px;transform:translateX(-50%);z-index:90;display:flex;align-items:center;gap:8px;
  padding:7px 9px 7px 12px;background:rgba(22,21,20,.82);backdrop-filter:blur(8px);border:1px solid rgba(245,243,239,.16);border-radius:99px;
  font-family:var(--mono,monospace);opacity:.42;transition:opacity .3s}
.acctool:hover{opacity:1}
.acctool-l{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#8f8d88;margin-right:2px}
.acctool-div{margin-left:8px;padding-left:10px;border-left:1px solid rgba(245,243,239,.18)}
.acctool [data-acc]{width:16px;height:16px;border-radius:50%;border:1px solid rgba(245,243,239,.25);background:var(--sw);cursor:pointer;padding:0;transition:transform .2s}
.acctool [data-acc]:hover{transform:scale(1.18)}
.acctool [data-acc].on{box-shadow:0 0 0 2px rgba(22,21,20,.82),0 0 0 3.5px #F5F3EF}
.acctool [data-font]{background:none;border:1px solid rgba(245,243,239,.22);border-radius:6px;color:#b5b2ac;font-family:var(--mono,monospace);font-size:8.5px;letter-spacing:.06em;padding:3px 5px;cursor:pointer;transition:color .2s,border-color .2s}
.acctool [data-font]:hover{color:#F5F3EF;border-color:rgba(245,243,239,.5)}
.acctool [data-font].on{color:#161514;background:#F5F3EF;border-color:#F5F3EF}
.acctool-x{background:none;border:0;color:#8f8d88;font-size:15px;line-height:1;cursor:pointer;padding:0 2px 0 4px}
.acctool-x:hover{color:#F5F3EF}
@media (max-width:680px){.acctool{bottom:8px;padding:6px 8px}.acctool-l{display:none}}
</style>

<script is:inline>
(function(){
  // accents: [struct, on-rgb, spark]. B/W is the working default: pink dies, the
  // accent bands go ink with paper type, the quote bands flip via the injected guard.
  var ACC={
    bw:['#201e1d','245,243,239','#F5F3EF'],
    rose:['#EFA1AD','22,21,20','#EFA1AD'],
    cobalt:['#2438E8','245,243,239','#EFA1AD'],
    red:['#E0311A','245,243,239','#EFA1AD']
  };
  // type PAIRINGS, grounded in the 2026-07-09 recon of DJ's target agencies +
  // taste refs. Each is a full three-font system: disp (headers/titles),
  // body (copy), serif (the italic accent voice). Fragment Mono stays: it is
  // the fourth voice (meta), and the market runs the same play (lusion, D1A,
  // The Many all pair a grotesk with a mono).
  // {d:[family,dispw,dispw2], b:family|null, s:family|null, css:[hrefs]}
  // null = page default (Bricolage / Instrument Serif).
  var PAIRS={
    cut:{d:["'Bricolage Grotesque',sans-serif",'800','600'],b:null,s:null,css:[]},
    tiny:{d:["'Inter',sans-serif",'800','650'],b:"'Inter',sans-serif",s:"'Fraunces',serif",
      css:['https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&display=swap']},
    haus:{d:["'Instrument Sans',sans-serif",'700','600'],b:"'Instrument Sans',sans-serif",s:"'Instrument Serif',serif",
      css:['https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wdth,wght@0,75..100,400..700;1,75..100,400..700&display=swap']},
    wide:{d:["'Archivo',sans-serif",'800','600'],b:"'Archivo',sans-serif",s:"'Spectral',serif",
      css:['https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Spectral:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&display=swap']},
    mdrn:{d:["'Satoshi',sans-serif",'900','700'],b:"'Satoshi',sans-serif",s:"'Gambetta',serif",
      css:['https://api.fontshare.com/v2/css?f[]=satoshi@400,401,500,700,701,900,901&f[]=gambetta@400,401,500,501&display=swap']}
  };
  var root=document.documentElement, tool=document.getElementById('acctool');
  // guard rules for B/W: the rose quote bands flip to ink so nothing renders pink
  if(!document.getElementById('mnmt-bw-guard')){
    var g=document.createElement('style');g.id='mnmt-bw-guard';
    g.textContent='html[data-accent="bw"] .quote{background:var(--paper)!important;color:var(--ink)!important}'+
      'html[data-accent="bw"] .quote .who{color:rgba(22,21,20,.55)!important}'+
      'html[data-accent="bw"] .statrow{border-top:1px solid rgba(245,243,239,.14)}'+
      'html[data-accent="bw"] .cta[class]{border-top:1px solid rgba(245,243,239,.1)}'+
      // the scoreboard: on case pages (statrow + rolerow pair) the band inverts to paper
      'html[data-accent="bw"] .statrow:has(+ .rolerow){background:var(--paper)!important;color:#161514!important;border-top:none!important;border-bottom:none!important}'+
      'html[data-accent="bw"] .statrow:has(+ .rolerow) .stat b{color:#161514!important}'+
      'html[data-accent="bw"] .statrow:has(+ .rolerow) .stat span,html[data-accent="bw"] .statrow:has(+ .rolerow) .stat .note{color:rgba(22,21,20,.62)!important}'+
      'html[data-accent="bw"] .statrow:has(+ .rolerow) .stat .note b{color:#161514!important}';
    document.head.appendChild(g);
  }
  function applyAcc(a){
    if(a==='ink')a='bw'; // migrate the old saved value
    var v=ACC[a]||ACC.bw;
    root.style.setProperty('--struct',v[0]);
    root.style.setProperty('--on-rgb',v[1]);
    root.style.setProperty('--spark',v[2]);
    root.setAttribute('data-accent',a);
    if(tool)tool.querySelectorAll('[data-acc]').forEach(function(b){b.classList.toggle('on',b.dataset.acc===a);});
  }
  function applyFont(f){
    if(!PAIRS[f])f='cut';
    var v=PAIRS[f];
    v.css.forEach(function(href,i){
      var id='mnmt-font-'+f+'-'+i;
      if(!document.getElementById(id)){
        var l=document.createElement('link');l.id=id;l.rel='stylesheet';l.href=href;
        document.head.appendChild(l);
      }
    });
    root.style.setProperty('--disp',v.d[0]);
    root.style.setProperty('--dispw',v.d[1]);
    root.style.setProperty('--dispw2',v.d[2]);
    if(v.b)root.style.setProperty('--body',v.b);else root.style.removeProperty('--body');
    if(v.s)root.style.setProperty('--serif',v.s);else root.style.removeProperty('--serif');
    root.setAttribute('data-font',f);
    if(tool)tool.querySelectorAll('[data-font]').forEach(function(b){b.classList.toggle('on',b.dataset.font===f);});
  }
  applyAcc(localStorage.getItem('mnmt-accent')||'bw');
  applyFont(localStorage.getItem('mnmt-font')||'cut');
  if(!tool)return;
  if(localStorage.getItem('mnmt-acctool')==='off'){tool.style.display='none';}
  tool.querySelectorAll('[data-acc]').forEach(function(b){
    b.addEventListener('click',function(){applyAcc(b.dataset.acc);localStorage.setItem('mnmt-accent',b.dataset.acc);});
  });
  tool.querySelectorAll('[data-font]').forEach(function(b){
    b.addEventListener('click',function(){applyFont(b.dataset.font);localStorage.setItem('mnmt-font',b.dataset.font);});
  });
  tool.querySelector('.acctool-x').addEventListener('click',function(){tool.style.display='none';localStorage.setItem('mnmt-acctool','off');});
})();
</script>

<script is:inline>
// play-when-visible: the sitewide default for every autoplay loop. Videos keep
// their autoplay attribute (progressive enhancement if this script dies), but
// the observer pauses anything off-screen and resumes it on entry. Dynamic
// videos (hover snips, grid cards) are adopted via MutationObserver. Reduced
// motion means decorative loops stay paused entirely.
(function(){
  var reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){
      var v=e.target;
      if(reduced){v.pause();return;}
      if(e.isIntersecting){if(v.paused)v.play().catch(function(){});}
      else if(!v.paused)v.pause();
    });
  },{rootMargin:'220px 340px',threshold:0.01});
  function adopt(v){
    if(v.__vio)return; v.__vio=true;
    io.observe(v);
    if(reduced)v.removeAttribute('autoplay');
  }
  function scan(root){(root.querySelectorAll?root:document).querySelectorAll('video[autoplay]').forEach(adopt);}
  scan(document);
  new MutationObserver(function(ms){
    ms.forEach(function(m){m.addedNodes.forEach(function(n){
      if(n.nodeType!==1)return;
      if(n.tagName==='VIDEO'&&n.hasAttribute('autoplay'))adopt(n);
      else if(n.querySelectorAll)n.querySelectorAll('video[autoplay]').forEach(adopt);
    });});
  }).observe(document.body,{childList:true,subtree:true});
})();
</script>
