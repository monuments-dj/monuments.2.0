---
// PageFooter.astro · the one true footer, one baseline, centered.
// `tag` is the per-page sign-off (DJ likes that it differs on every page:
// "Photography", "About", "Case file MC-2023-05"...). Styling lives HERE so
// pages can never drift apart again. Self-contained: no reliance on page .wrap.
import MenuTakeover from './MenuTakeover.astro';
interface Props { tag: string; }
const { tag } = Astro.props;
---
<MenuTakeover />
<footer class="pfoot">
  <div class="row">
    <span>Monuments &copy; MMXXVI &middot; ELMT.NO.004259</span>
    <span class="blk">built to be remembered</span>
    <span>{tag}</span>
  </div>
</footer>

<!-- accent + type switcher DELETED 2026-07-22 (LAUNCH item): accent BAKED bw,
     font BAKED cut (01, Bricolage + Instrument Serif - DJ's pick 2026-07-28;
     the 2026-07-22 tiny bake was wrong). History: LAUNCH.md D2. -->

<style>
.pfoot{background:var(--ink,#161514);color:var(--dim,#8f8d88);border-top:1px solid var(--lined,#2c2b29);padding:34px 0 18px;position:relative;z-index:3}
.pfoot .row{display:flex;justify-content:center;align-items:baseline;flex-wrap:wrap;gap:8px 22px;
  max-width:var(--wrap,1380px);margin:0 auto;padding-left:var(--pad,clamp(22px,4.6vw,44px));padding-right:var(--pad,clamp(22px,4.6vw,44px))}
.pfoot span{font-family:var(--mono,'Fragment Mono',monospace);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim,#8f8d88)}
.pfoot .blk{text-transform:none}

</style>

<script is:inline>
(function(){
  // accents: [struct, on-rgb, spark]. B/W is the working default: pink dies, the
  // accent bands go ink with paper type, the quote bands flip via the injected guard.
  // --accent = THE accent / emphasis colour (the pop on the closer's key word, the
  // hand-drawn CTA circle, accent marks). Red for now, but it is a TOKEN, not a
  // hardcode: change ACCENT here (or per-preset below) and it swaps everywhere,
  // live, on every page. Consumers must read var(--accent), never a literal.
  var ACCENT='#E0311A';
  //        [ --struct , --on-rgb      , --spark  , --accent ]
  var ACC={
    bw:    ['#201e1d','245,243,239','#F5F3EF',ACCENT],
    rose:  ['#EFA1AD','22,21,20'   ,'#EFA1AD',ACCENT],
    cobalt:['#2438E8','245,243,239','#EFA1AD',ACCENT],
    red:   ['#E0311A','245,243,239','#EFA1AD',ACCENT]
  };
  // type PAIRINGS, grounded in the 2026-07-09 recon of DJ's target agencies +
  // taste refs. Each is a full three-font system: disp (headers/titles),
  // body (copy), serif (the italic accent voice). Fragment Mono stays: it is
  // the fourth voice (meta), and the market runs the same play (lusion, D1A,
  // The Many all pair a grotesk with a mono).
  // {d:[family,dispw,dispw2], b:family|null, s:family|null, css:[hrefs]}
  // null = page default (Bricolage / Instrument Serif).
  var PAIRS={
    cut:{d:["'Bricolage Grotesque',sans-serif",'800','600'],b:null,s:null,css:[]},
    tiny:{d:["'Inter',sans-serif",'800','650'],b:"'Inter',sans-serif",s:"'Fraunces',serif",
      css:['https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&display=swap']},
    haus:{d:["'Instrument Sans',sans-serif",'700','600'],b:"'Instrument Sans',sans-serif",s:"'Instrument Serif',serif",
      css:['https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wdth,wght@0,75..100,400..700;1,75..100,400..700&display=swap']},
    wide:{d:["'Archivo',sans-serif",'800','600'],b:"'Archivo',sans-serif",s:"'Spectral',serif",
      css:['https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Spectral:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&display=swap']},
    mdrn:{d:["'Satoshi',sans-serif",'900','700'],b:"'Satoshi',sans-serif",s:"'Gambetta',serif",
      css:['https://api.fontshare.com/v2/css?f[]=satoshi@400,401,500,700,701,900,901&f[]=gambetta@400,401,500,501&display=swap']},
    // round two (2026-07-11): DJ passed on 01-05 ("still bullshit"), so three
    // pairings from lanes the first five never touched:
    // 06 GRIT = condensed poster caps, the old-site hero DNA (Anton is the free
    //    Founders-Condensed lane), quiet Inter body, Instrument Serif stays.
    grit:{d:["'Anton',sans-serif",'400','400'],b:"'Inter',sans-serif",s:null,
      css:['https://fonts.googleapis.com/css2?family=Anton&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap']},
    // 07 CLSH = Clash Display, the character-grotesk portfolio lane (Fontshare),
    //    General Sans body, Sentient italic accent.
    clsh:{d:["'Clash Display',sans-serif",'600','500'],b:"'General Sans',sans-serif",s:"'Sentient',serif",
      css:['https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=general-sans@400,401,500,501&f[]=sentient@400,401&display=swap']},
    // 08 SPCE = Space Grotesk, the technical-quirk lane (lusion adjacent),
    //    Inter body, Instrument Serif stays.
    spce:{d:["'Space Grotesk',sans-serif",'700','500'],b:"'Inter',sans-serif",s:null,
      css:['https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap']}
  };
  var root=document.documentElement;
  // guard rules for B/W: the rose quote bands flip to ink so nothing renders pink
  if(!document.getElementById('mnmt-bw-guard')){
    var g=document.createElement('style');g.id='mnmt-bw-guard';
    g.textContent='html[data-accent="bw"] .quote{background:var(--paper)!important;color:var(--ink)!important}'+
      'html[data-accent="bw"] .quote .who{color:rgba(22,21,20,.55)!important}'+
      'html[data-accent="bw"] .statrow{border-top:1px solid rgba(245,243,239,.14)}'+
      'html[data-accent="bw"] .cta[class]{border-top:1px solid rgba(245,243,239,.1)}'+
    document.head.appendChild(g);
  }
  // type guard: nearly every headline on the site declares only a WEIGHT and
  // inherits its family from body - so display fonts never landed on display
  // type when a pairing split them (DJ: "don't see any fonts changing").
  // This binds all display-role type to the --disp token. .serif spans keep
  // their own family (higher specificity + own declaration).
  if(!document.getElementById('mnmt-type-guard')){
    var tg=document.createElement('style');tg.id='mnmt-type-guard';
    tg.textContent='h1,h2,h3,h4,.big,.hero .t,.rowp .t,.rc-meta .t,.capcard .t,.gcard .band .t,'+
      '.rcard b,.tst-big,.tst-name .tst-nm,.tst-n,.rr-word,.reel-head h2,.refuse li,'+
      '.lclose,.rec-row .v{font-family:var(--disp,\'Bricolage Grotesque\',sans-serif)}';
    document.head.appendChild(tg);
  }
  function applyAcc(a){
    if(a==='ink')a='bw'; // migrate the old saved value
    var v=ACC[a]||ACC.bw;
    root.style.setProperty('--struct',v[0]);
    root.style.setProperty('--on-rgb',v[1]);
    root.style.setProperty('--spark',v[2]);
    root.style.setProperty('--accent',v[3]);   // the emphasis/pop colour — swappable on the fly
    root.setAttribute('data-accent',a);
  }
  function applyFont(f){
    if(!PAIRS[f])f='cut';
    var v=PAIRS[f];
    v.css.forEach(function(href,i){
      var id='mnmt-font-'+f+'-'+i;
      if(!document.getElementById(id)){
        var l=document.createElement('link');l.id=id;l.rel='stylesheet';l.href=href;
        document.head.appendChild(l);
      }
    });
    root.style.setProperty('--disp',v.d[0]);
    root.style.setProperty('--dispw',v.d[1]);
    root.style.setProperty('--dispw2',v.d[2]);
    if(v.b)root.style.setProperty('--body',v.b);else root.style.removeProperty('--body');
    if(v.s)root.style.setProperty('--serif',v.s);else root.style.removeProperty('--serif');
    root.setAttribute('data-font',f);
  }
  applyAcc('bw');   // BAKED (DJ 2026-07-13); switcher deleted 2026-07-22, localStorage picks retired
  applyFont('cut'); // BAKED: 01 CUT, Bricolage + Instrument Serif (DJ 2026-07-28 - the 07-22
                    // tiny bake did not match his Kit pick; re-picked from the full visual menu)
})();
</script>

<script is:inline>
// play-when-visible: the sitewide default for every autoplay loop. Videos keep
// their autoplay attribute (progressive enhancement if this script dies), but
// the observer pauses anything off-screen and resumes it on entry. Dynamic
// videos (hover snips, grid cards) are adopted via MutationObserver. Reduced
// motion means decorative loops stay paused entirely.
(function(){
  var reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){
      var v=e.target;
      if(reduced){v.pause();return;}
      if(e.isIntersecting){if(v.paused)v.play().catch(function(){});}
      else if(!v.paused)v.pause();
    });
  },{rootMargin:'220px 340px',threshold:0.01});
  function adopt(v){
    if(v.__vio)return; v.__vio=true;
    io.observe(v);
    if(reduced)v.removeAttribute('autoplay');
  }
  function scan(root){(root.querySelectorAll?root:document).querySelectorAll('video[autoplay]').forEach(adopt);}
  scan(document);
  new MutationObserver(function(ms){
    ms.forEach(function(m){m.addedNodes.forEach(function(n){
      if(n.nodeType!==1)return;
      if(n.tagName==='VIDEO'&&n.hasAttribute('autoplay'))adopt(n);
      else if(n.querySelectorAll)n.querySelectorAll('video[autoplay]').forEach(adopt);
    });});
  }).observe(document.body,{childList:true,subtree:true});
})();
</script>

<script is:inline>
// ═ THE BAND PARALLAX ENGINE (2026-07-20) ═══════════════════════════════════
// Sitewide parallax for full-bleed photo bands: every img inside .break or
// .crew drifts against scroll (the clothing-merch math, promoted here as THE
// single engine - its and giving's page-local copies are retired so nothing
// double-drives a transform). The .plx tags scattered across 16 files finally
// mean something. Reduced-motion = static. Pure function of scroll position,
// so it reverses on the way up like everything else.
(function(){
  if(window.__bandPlx)return; window.__bandPlx=1;
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var imgs=[].slice.call(document.querySelectorAll('.break img,.crew img'));
  if(!imgs.length)return;
  var tick=false;
  function upd(){
    tick=false;
    var vh=innerHeight;
    imgs.forEach(function(b){
      var r=b.parentElement.getBoundingClientRect();
      if(r.bottom>0&&r.top<vh){
        var p=(r.top+r.height/2-vh/2)/vh;
        b.style.transform='translateY('+(p*-56).toFixed(1)+'px)';
      }
    });
  }
  addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(upd)}},{passive:true});
  addEventListener('resize',function(){if(!tick){tick=true;requestAnimationFrame(upd)}},{passive:true});
  upd();
})();
</script>
<script is:inline>
// masonry packer: the .frames contact sheets use CSS columns as the no-JS
// fallback; this converts each sheet to a dense row-span grid so no column
// ends early. Spans are ESTIMATED from width/height attributes before media
// loads, then corrected on every load + resize until stable.
(function(){
  var UNIT=8;
  function span(it,gap){
    // grid stretches items to their span, so rect.height lies: content height
    // lives in scrollHeight (or the attr-based estimate before media loads)
    var r=it.getBoundingClientRect();
    var h=it.scrollHeight;
    var media=it.querySelector('img,video');
    if(media){
      var mr=media.getBoundingClientRect();
      var w0=parseFloat(media.getAttribute('width')),h0=parseFloat(media.getAttribute('height'));
      if(mr.height<20&&w0>0&&h0>0){
        var cs=getComputedStyle(it);
        var padV=(parseFloat(cs.paddingTop)||0)+(parseFloat(cs.paddingBottom)||0);
        var padH=(parseFloat(cs.paddingLeft)||0)+(parseFloat(cs.paddingRight)||0);
        h=Math.max(h,(r.width-padH)*h0/w0+padV);
      }
    }
    return Math.max(2,Math.round((h+gap)/(UNIT+gap)));
  }
  function pack(el){
    if(el.children.length<2)return; // single-item containers stay as authored
    if(!el.dataset.cols){
      var pre=getComputedStyle(el);
      el.dataset.cols=parseInt(pre.columnCount)||3;
      var g=parseFloat(pre.columnGap);el.dataset.gap=isNaN(g)?14:g;
    }
    // re-read the responsive column count from the fallback stylesheet each time
    el.style.columns='';el.style.display='';
    var cols=parseInt(getComputedStyle(el).columnCount)||parseInt(el.dataset.cols)||3;
    // thin sheets read better one column narrower (5 tiles across 3 cols = a dead column)
    if(cols>2&&el.children.length<=cols+2)cols=cols-1;
    var gap=parseFloat(el.dataset.gap);
    el.style.display='grid';
    el.style.columns='auto';
    el.style.gridTemplateColumns='repeat('+cols+',1fr)';
    el.style.gridAutoRows=UNIT+'px';
    el.style.alignItems='start';
    el.style.gap=gap+'px';
    // shortest-column placement: even bottoms beat strict source order
    var colH=[];for(var i=0;i<cols;i++)colH.push(0);
    [...el.children].forEach(function(it){
      var sp=span(it,gap);
      var c=0;for(var i=1;i<cols;i++)if(colH[i]<colH[c])c=i;
      it.style.marginBottom='0';
      it.style.gridColumn=String(c+1);
      it.style.gridRowStart=String(colH[c]+1);
      it.style.gridRowEnd='span '+sp;
      colH[c]+=sp;
    });
  }
  function packAll(){document.querySelectorAll('.frames').forEach(pack);}
  var t;function lazyPack(){clearTimeout(t);t=setTimeout(packAll,100);}
  function boot(){
    packAll();
    [400,1000,2200,4000].forEach(function(ms){setTimeout(packAll,ms);});
    document.addEventListener('load',function(e){
      if(e.target&&e.target.matches&&e.target.matches('.frames img'))lazyPack();
    },true);
    document.addEventListener('loadedmetadata',function(e){
      if(e.target&&e.target.matches&&e.target.matches('.frames video'))lazyPack();
    },true);
    addEventListener('resize',lazyPack);
    new MutationObserver(lazyPack).observe(document.body,{childList:true,subtree:true});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script>

