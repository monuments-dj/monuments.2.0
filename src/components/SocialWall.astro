---
// SocialWall.astro · "A look beyond the numbers" — the audience-reaction wall
// AOV ran on its case pages. Real community comments as social proof; the metric
// a campaign can't chart. Pass {title, intro, comments:[{u,t,l}]}.
interface Comment { u: string; t: string; l?: number; }
interface Props { title?: string; intro?: string; comments: Comment[]; }
const { title = 'A look beyond the numbers', intro, comments } = Astro.props;
---
<section class="swall">
  <div class="wrap">
    <div class="swall-head rv">
      <span class="mono k">\ Beyond the numbers</span>
      <h2>{title}</h2>
      {intro && <p class="swall-intro">{intro}</p>}
    </div>
    <div class="swall-grid">
      {comments.map((c) => (
        <figure class="scomment rv">
          <span class="su"><span class="sa" aria-hidden="true">{c.u.charAt(0).toUpperCase()}</span>{c.u}</span>
          <p>{c.t}</p>
          {c.l ? <span class="sl"><b>&#9829;</b> {c.l}</span> : null}
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .swall{background:var(--ink);color:var(--paper);padding:12vh 0}
  .swall-head{max-width:62ch;margin-bottom:5vh}
  .swall .k{color:var(--spark);display:block;margin-bottom:14px}
  .swall h2{font-weight:var(--dispw);font-size:clamp(30px,4.6vw,66px);letter-spacing:-.035em;line-height:.98;text-transform:uppercase}
  .swall-intro{margin-top:20px;color:rgba(245,243,239,.74);font-size:clamp(16px,1.5vw,19px);line-height:1.6;max-width:58ch}
  .swall-grid{columns:4;column-gap:16px}
  .scomment{break-inside:avoid;margin:0 0 16px;background:rgba(245,243,239,.05);border:1px solid rgba(245,243,239,.1);border-radius:11px;padding:15px 16px 13px}
  .scomment .su{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-size:10px;letter-spacing:.03em;color:rgba(245,243,239,.92)}
  .scomment .sa{width:22px;height:22px;border-radius:50%;background:var(--spark);color:var(--ink);display:grid;place-items:center;font-size:10px;flex:none;font-family:var(--disp);font-weight:var(--dispw)}
  .scomment p{margin-top:11px;font-size:14.5px;line-height:1.45;color:var(--paper)}
  .scomment .sl{display:inline-block;margin-top:10px;font-family:var(--mono);font-size:9px;letter-spacing:.08em;color:rgba(245,243,239,.5)}
  .scomment .sl b{color:var(--red);font-weight:400}
  @media (max-width:1100px){.swall-grid{columns:3}}
  @media (max-width:760px){.swall-grid{columns:2}}
  @media (max-width:460px){.swall-grid{columns:1}}
  @media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none}}
</style>
