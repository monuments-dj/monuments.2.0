---
// Testimonials.astro · "In their words" — shared by Home + About.
// THEATER is DJ's pick (2026-07-11) — the wall/roster/crawl variants + picker
// are deleted. One voice center stage, auto-advance, arrows.
// ⛔ NO PLACEHOLDER COPY, EVER. DJ is collecting the real quotes; until one
// lands the slide shows the name/role + a dimmed “ … ” + the "quote incoming"
// chip. NEVER put words (lorem or otherwise) under a real person's name.
// When a quote lands: fill `q` for that person. Links open the person's page.
// TYPE NOTE: quotes render SANS (display face) until copy locks — DJ 2026-07-11
// "the typography isnt working. make these sans serif for now till we lock copy."
interface Person { name: string; role: string; q?: string; link?: string; }
interface Props { tag?: string; }
const { tag = 'pull quotes · incoming' } = Astro.props;
// DJ's outreach list 2026-07-11 (roles his words; links verified before adding —
// unverified handles stay off the site, see TODO.md outreach block)
const people: Person[] = [
  { name: 'Prince McClinton', role: 'CEO · Art of Visuals',                          link: 'https://www.instagram.com/artofvisuals/' },
  { name: 'Krizia Vega',      role: 'Director · Native Saints',                      link: 'https://www.instagram.com/kriziavega/' },
  { name: 'Jennie Myers',     role: 'CEO · Against',                                 link: 'https://goagainst.com' },
  { name: 'Nathan Zanders',   role: 'CEO · MOX' },
  { name: 'Jake Goble',       role: 'CEO · Rad Animal + Creative Hotline · Collaborator' },
  { name: 'Alex Stevens',     role: 'CEO · Bluepixel' },
  { name: 'Mitch Khun',       role: 'Creative Director · Stoltz Marketing Group' },
  { name: 'Tommy Lundberg',   role: 'Photographer · Art Director · Collaborator' },
  { name: 'Andrea Cenon',     role: 'Creative Director · Day One Agency' },
];
---
<section class="tst" id="tst">
  <div class="wrap">
    <div class="tst-bar">
      <span class="mono"><b>\ In their words</b> · the people in the room</span>
      <span class="mono tst-tag">{tag}</span>
    </div>

    <!-- THEATER · one voice at a time, center stage -->
    <div class="tst-thr">
      <div class="tst-stage" id="thrStage" aria-live="polite">
        {people.map((p, i) => (
          <figure class={`tst-slide ${i === 0 ? 'live' : ''}`} data-i={i}>
            <p class={`tst-big ${p.q ? '' : 'ph'}`}><span class="tst-ln"><span>{p.q ? `“${p.q}”` : '“ … ”'}</span></span></p>
            <figcaption>
              {p.link
                ? <a class="tst-n tst-link" href={p.link} target="_blank" rel="noopener">{p.name} ↗</a>
                : <span class="tst-n">{p.name}</span>}
              <span class="tst-r mono">{p.role}</span>
              {!p.q && <span class="tst-chip mono">quote incoming</span>}
            </figcaption>
          </figure>
        ))}
      </div>
      <div class="tst-thr-nav">
        <button class="tst-arrow mono" id="thrPrev" aria-label="Previous quote">←</button>
        <span class="tst-ticks" id="thrTicks" aria-hidden="true">
          {people.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}
        </span>
        <button class="tst-arrow mono" id="thrNext" aria-label="Next quote">→</button>
      </div>
    </div>
  </div>
</section>

<style>
.tst{background:var(--ink,#161514);color:var(--paper,#F5F3EF);padding:8vh 0 7vh}
.tst-bar{display:flex;justify-content:space-between;align-items:baseline;gap:14px 20px;flex-wrap:wrap;padding-bottom:14px;border-bottom:1px solid var(--lined,#2c2b29);margin-bottom:26px}
.tst-bar .mono b{color:var(--spark,#EFA1AD)}
.tst-tag{color:#8f8d88}

.tst-n{font-weight:var(--dispw2,600);font-size:15.5px;letter-spacing:-.01em}
.tst-link{border-bottom:1px solid rgba(245,243,239,.3);padding-bottom:2px;transition:border-color .25s,color .25s}
.tst-link:hover{color:var(--spark,#EFA1AD);border-color:var(--spark,#EFA1AD)}
.tst-r{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:#8f8d88}
.tst-chip{align-self:center;margin-top:6px;font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--spark,#EFA1AD);border:1px solid color-mix(in srgb, var(--spark,#EFA1AD) 42%, transparent);border-radius:99px;padding:3px 9px;width:max-content}

/* THEATER · quotes render SANS until the copy locks (serif returns then) */
.tst-thr{padding:5vh 0 2vh}
.tst-stage{position:relative;min-height:clamp(230px,30vw,330px)}
.tst-slide{position:absolute;inset:0;margin:0;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:22px;visibility:hidden}
.tst-slide.live{visibility:visible}
.tst-big{font-family:var(--disp,'Bricolage Grotesque',sans-serif);font-weight:var(--dispw2,600);font-style:normal;font-size:clamp(24px,3.2vw,42px);line-height:1.22;letter-spacing:-.02em;max-width:30ch;margin:0}
.tst-big.ph{color:rgba(245,243,239,.34)}
.tst-ln{display:block;overflow:hidden;padding-bottom:.18em;margin-bottom:-.18em}
.tst-ln>span{display:block;transform:translateY(115%)}
.tst-slide.live .tst-ln>span{animation:tstRise .8s cubic-bezier(.22,1,.36,1) forwards}
@keyframes tstRise{to{transform:translateY(0)}}
.tst-slide figcaption{display:flex;flex-direction:column;align-items:center;gap:4px}
.tst-thr-nav{display:flex;justify-content:center;align-items:center;gap:22px;margin-top:26px}
.tst-arrow{background:none;border:1px solid rgba(245,243,239,.3);border-radius:50%;width:38px;height:38px;color:var(--paper,#F5F3EF);cursor:pointer;transition:background .25s,color .25s}
.tst-arrow:hover{background:var(--paper,#F5F3EF);color:var(--ink,#161514)}
.tst-ticks{display:flex;gap:6px}
.tst-ticks i{display:block;width:14px;height:2px;background:rgba(245,243,239,.22);transition:background .3s}
.tst-ticks i.on{background:var(--spark,#EFA1AD)}

@media (prefers-reduced-motion:reduce){
  .tst-ln>span{transform:none;animation:none!important}
}
</style>

<script is:inline>
// THEATER: auto-advance while visible; arrows; mask re-rise per swap.
(function(){
  if(window.__tstInit)return; window.__tstInit=1;
  var sec=document.getElementById('tst'); if(!sec)return;
  var reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var slides=[...sec.querySelectorAll('.tst-slide')],ticks=[...sec.querySelectorAll('.tst-ticks i')],ti=0,timer=null;
  function show(i){
    ti=(i+slides.length)%slides.length;
    slides.forEach(function(s,j){
      var live=j===ti;
      s.classList.remove('live');
      if(live){void s.offsetWidth;s.classList.add('live');} // retrigger the rise
    });
    ticks.forEach(function(t,j){t.classList.toggle('on',j===ti);});
  }
  function arm(){if(timer||reduced)return;timer=setInterval(function(){show(ti+1);},6200);}
  function disarm(){clearInterval(timer);timer=null;}
  var prev=document.getElementById('thrPrev'),next=document.getElementById('thrNext');
  if(prev)prev.addEventListener('click',function(){disarm();show(ti-1);});
  if(next)next.addEventListener('click',function(){disarm();show(ti+1);});
  new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting)arm();else disarm();});
  },{threshold:.25}).observe(sec);
  var thr=sec.querySelector('.tst-thr');
  if(thr){thr.addEventListener('mouseenter',disarm);thr.addEventListener('mouseleave',arm);}
})();
</script>
