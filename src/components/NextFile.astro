---
// NextFile.astro · shared bottom-of-page NEXT CASE FILE closer for the cut pages.
// Dark ink band: mono kicker with the red spark, giant next-project name, a white-
// framed cover thumb, and a thin rail that fills as the visitor DELIBERATELY over-
// scrolls at the very bottom. The fill is capped per gesture, drains continuously,
// and must be held at full for a beat before it carries over, so a stray flick or
// momentum scroll can't trigger it by accident. The foot carries explicit "Back"
// (browser history) and "Open file" controls so there is always a way back.
//   <NextFile href name img code threshold />
interface Props {
  href: string;
  name: string;
  img: string;
  code: string;
  threshold?: number; // overscroll px that must be sustained before it carries over
}
const { href, name, img, code, threshold = 300 } = Astro.props;
const words = name.trim().split(/\s+/);
const last = words.pop();
const head = words.join(' ');
---
<section class="nextfile" data-nextfile data-nf-href={href} data-nf-threshold={threshold}>
  <div class="nf-wrap">
    <a class="nf-link" href={href} data-nf-link aria-label={`Next case file: ${name}`}>
      <div class="nf-kicker mono"><i class="mk" aria-hidden="true">&#10035;</i> Next case file &middot; {code}</div>
      <div class="nf-row">
        <span class="nf-thumb" aria-hidden="true">
          <img src={img} alt="" loading="lazy" decoding="async" />
          <span class="nf-thumbcap mono">{code}</span>
        </span>
        <span class="nf-name">{head ? head + ' ' : ''}<span class="serif">{last}</span></span>
      </div>
    </a>
    <div class="nf-rail" data-nf-rail aria-hidden="true"><span class="nf-fill" data-nf-fill></span></div>
    <div class="nf-foot mono">
      <button type="button" class="nf-back" data-nf-back>&larr; Back</button>
      <span class="nf-hint nf-hint-scroll">keep scrolling to open, or click</span>
      <span class="nf-hint nf-hint-click">click to open the file</span>
      <a class="nf-open" href={href}>Open file <i class="nf-arrow" aria-hidden="true">&rarr;</i></a>
    </div>
  </div>
</section>

<style>
.nextfile{position:relative;background:var(--ink,#161514);color:var(--paper,#F5F3EF);overflow:hidden}
.nf-wrap{max-width:var(--wrap,1380px);margin:0 auto;padding:clamp(60px,11vh,120px) var(--pad,clamp(22px,4.6vw,44px)) clamp(44px,8vh,84px)}
.nf-link{display:block;color:inherit;text-decoration:none}
.mono{font-family:var(--mono,'Fragment Mono',monospace);font-size:11px;letter-spacing:.09em;text-transform:uppercase;font-weight:400}
.nf-kicker{color:var(--dim,#8f8d88)}
.nf-kicker .mk{font-style:normal;color:var(--red,#E0311A)}

.nf-row{display:flex;align-items:center;gap:clamp(20px,3.4vw,48px);margin-top:clamp(22px,4vh,38px)}
.nf-thumb{position:relative;flex:0 0 auto;width:clamp(88px,10.5vw,150px);background:#FCFBF7;padding:6px 6px 20px;transform:rotate(-2.2deg);box-shadow:0 2px 4px rgba(0,0,0,.4),0 14px 34px rgba(0,0,0,.5);transition:transform .5s cubic-bezier(.22,1,.36,1)}
.nf-thumb img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;filter:saturate(.96)}
.nf-thumbcap{position:absolute;left:7px;bottom:4px;font-size:7.5px;letter-spacing:.14em;color:var(--dim,#8f8d88)}
.nf-link:hover .nf-thumb{transform:rotate(1deg) scale(1.05)}
.nf-name{display:block;font-family:var(--disp,'Bricolage Grotesque',sans-serif);font-weight:var(--dispw,800);font-size:clamp(44px,8.4vw,124px);line-height:.9;letter-spacing:-.035em;text-transform:uppercase;transition:color .3s}
.nf-name .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:-.01em}
.nf-link:hover .nf-name{color:var(--spark,#EFA1AD)}

.nf-rail{position:relative;height:2px;margin-top:clamp(30px,5.5vh,54px);background:rgba(245,243,239,.16);overflow:hidden}
.nf-fill{position:absolute;top:0;left:0;bottom:0;width:calc(var(--nf-fill,0)*100%);background:var(--spark,#EFA1AD);transition:width .12s linear}
.nf-foot{display:flex;justify-content:space-between;align-items:baseline;gap:18px;margin-top:14px;color:var(--dim,#8f8d88)}
.nf-back{font-family:var(--mono,'Fragment Mono',monospace);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--dim,#8f8d88);background:none;border:0;padding:0;cursor:pointer;transition:color .3s}
.nf-back:hover{color:var(--paper,#F5F3EF)}
.nf-hint-click{display:none}
.nf-open{color:var(--paper,#F5F3EF);text-decoration:none}
.nf-arrow{font-style:normal;display:inline-block;transition:transform .4s cubic-bezier(.22,1,.36,1)}
.nf-open:hover .nf-arrow{transform:translateX(6px)}
.nextfile.is-full .nf-hint-scroll,.nextfile.is-full .nf-open{color:var(--spark,#EFA1AD)}
.nextfile.is-full .nf-arrow{animation:nfPulse 1s ease-in-out infinite}
@keyframes nfPulse{0%,100%{transform:translateX(6px)}50%{transform:translateX(14px)}}

@media (max-width:700px){
  .nf-row{align-items:flex-start;gap:18px}
  .nf-thumb{margin-top:6px}
  .nf-foot{flex-wrap:wrap;gap:10px 18px}
}
@media (prefers-reduced-motion:reduce){
  .nf-rail{display:none}
  .nf-hint-scroll{display:none}
  .nf-hint-click{display:inline}
  .nf-thumb,.nf-arrow{transition:none}
  .nextfile.is-full .nf-arrow{animation:none}
}
</style>

<script is:inline>
// Deliberate scroll-to-end hand-off. At the very bottom, extra downward scroll fills
// the rail, but: each gesture adds only a capped amount, the rail drains continuously
// when you stop, and it must sit FULL for ~0.5s before it carries over. So a flick or
// momentum scroll can't trigger it; only a sustained, intentional push does. The foot
// "Back" always returns you where you came from. Reduced motion = click only.
(function () {
  var nf = document.querySelector('[data-nextfile]');
  if (!nf) return;
  var href = nf.getAttribute('data-nf-href');
  if (!href) return;

  var back = nf.querySelector('[data-nf-back]');
  if (back) back.addEventListener('click', function (e) {
    e.preventDefault();
    if (history.length > 1) history.back(); else location.href = '/work';
  });

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var threshold = Number(nf.getAttribute('data-nf-threshold')) || 300;
  var CAP = 34;        // most one wheel/touch event can add
  var DRAIN = 9;       // px bled off per frame when not actively pushing
  var HOLD = 520;      // ms the rail must stay full before it carries over
  var over = 0, fired = false, lastPush = 0, fullSince = 0;

  function atBottom() {
    var d = document.documentElement;
    return window.scrollY + window.innerHeight >= d.scrollHeight - 2;
  }
  function locked() { return document.body.style.overflow === 'hidden'; }
  function render() {
    var p = Math.min(1, over / threshold);
    nf.style.setProperty('--nf-fill', p.toFixed(3));
    nf.classList.toggle('is-full', p >= 1);
  }
  function drainNow() { if (!fired) { over = 0; fullSince = 0; render(); } }
  function push(dy) {
    if (fired || locked() || !atBottom()) return;
    over = Math.min(threshold * 1.06, over + Math.min(dy, CAP));
    lastPush = performance.now();
    render();
  }
  function tick(now) {
    if (fired) return;
    if (over > 0 && now - lastPush > 90) { over = Math.max(0, over - DRAIN); render(); }
    if (over >= threshold) {
      if (!fullSince) fullSince = now;
      else if (now - fullSince >= HOLD) { fired = true; location.href = href; return; }
    } else { fullSince = 0; }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  addEventListener('wheel', function (e) {
    if (e.deltaY > 0) push(e.deltaY); else if (e.deltaY < 0) drainNow();
  }, { passive: true });

  var ty = null;
  addEventListener('touchstart', function (e) { ty = e.touches[0].clientY; }, { passive: true });
  addEventListener('touchmove', function (e) {
    if (ty === null) return;
    var y = e.touches[0].clientY, dy = ty - y; ty = y;
    if (dy > 0) push(dy); else if (dy < 0) drainNow();
  }, { passive: true });
  addEventListener('touchend', function () { ty = null; }, { passive: true });
  addEventListener('scroll', function () { if (!atBottom()) drainNow(); }, { passive: true });
})();
</script>
