---
// HeroHeader.astro — the work-page header (from Kit ELEMENT 24, made static per page).
// Big left-aligned name with a small brand lead, the logline blurb, and the role line
// with the FIRST service hand-circled. Logo image if the brand has one, else brand text.
// Pull the fields straight from src/data/work.js for the page's slug.
//
//   <HeroHeader hLead="Albertson Foundation" hName="Buck the Quo"
//     logline="A statewide campaign…" role="Campaign Development · Shooting · Editing"
//     img="/case-studies/buck-the-quo/gallery/keep-pushing-poster.jpg" />
interface Props {
  hLead?: string; hName: string; logline?: string; role?: string;
  img: string; vid?: string; logo?: string; logoColor?: boolean; logoText?: boolean;
  brand?: string; client?: string;
}
const { hLead, hName, logline, role = '', img, vid, logo, logoColor, logoText, brand, client } = Astro.props;
const parts = role.split(' · ').filter(Boolean);
const first = parts.shift() || '';
const rest = parts.length ? ' · ' + parts.join(' · ') : '';
const logoSrc = (logo && !logoText) ? `/logos/${logo}-${logoColor ? 'color' : 'white'}.png` : '';
---
<header class="hh">
  {vid
    ? <video class="hh-bg" src={vid} poster={img} autoplay muted loop playsinline aria-hidden="true"></video>
    : <img class="hh-bg" src={img} alt={hName} />}
  <div class="hh-in wrap">
    <h2 class="hh-h">
      {hLead && <span class="hh-lead">{hLead}:</span>}
      <span class="hh-name">{hName}</span>
    </h2>
    {logline && <p class="hh-blurb">{logline}</p>}
    {(first || logoSrc || brand || client) && (
      <div class="hh-role">
        {logoSrc
          ? <img class="hh-logo" src={logoSrc} alt={brand || client} loading="lazy" decoding="async" />
          : <span class="hh-logotext mono">{brand || client}</span>}
        {first && (
          <span class="hh-did mono"><span class="hh-circ"><svg class="hh-oval" viewBox="0 0 280 88" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M30,54 C15,28 76,13 152,13 C230,13 270,28 259,52 C251,72 189,82 118,79 C56,77 20,66 21,45 C22,31 43,21 68,18"/></svg>{first}</span>{rest}</span>
        )}
      </div>
    )}
  </div>
</header>
<style>
.hh{position:relative;height:82svh;min-height:560px;overflow:hidden;background:var(--ink,#161514);display:flex;align-items:stretch}
.hh-bg{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;filter:contrast(1.03) brightness(.3)}
.hh-in{position:relative;z-index:2;width:100%;max-width:var(--wrap,1380px);margin:0 auto;padding-left:var(--pad,clamp(22px,5vw,40px));padding-right:var(--pad,clamp(22px,5vw,40px));display:flex;flex-direction:column;justify-content:center}
.hh-h{margin:0;font-family:var(--disp,sans-serif);font-weight:var(--dispw2,600);text-transform:uppercase;letter-spacing:-.02em;color:#fff}
.hh-lead{display:block;font-size:clamp(18px,2.4vw,34px);line-height:1;color:rgba(245,243,239,.6);margin-bottom:.16em;letter-spacing:-.01em}
.hh-name{display:block;font-size:var(--fs-display,clamp(46px,9vw,132px));line-height:.94;color:#fff}
.hh-blurb{margin-top:22px;max-width:54ch;color:rgba(245,243,239,.82);font-size:clamp(14px,1.1vw,16px);line-height:1.62}
.hh-role{display:flex;align-items:center;gap:20px;margin-top:26px;flex-wrap:wrap}
.hh-logo{height:24px;width:auto;opacity:.95;filter:brightness(0) invert(1)}
.hh-logotext{font-size:14px;letter-spacing:.04em;color:#fff;text-transform:uppercase}
.hh-did{display:inline-block;font-family:var(--mono,monospace);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:rgba(245,243,239,.82)}
.hh-circ{position:relative;display:inline-block;padding:5px 15px}
.hh-oval{position:absolute;inset:-6px -9px;width:calc(100% + 18px);height:calc(100% + 12px);overflow:visible;pointer-events:none;transform:rotate(-1.6deg)}
.hh-oval path{fill:none;stroke:var(--marker,#e7e4dc);stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;opacity:0;animation:hhDraw 5s ease-in-out .4s infinite}
@keyframes hhDraw{0%{stroke-dashoffset:1;opacity:0}7%{opacity:1}32%{stroke-dashoffset:0;opacity:1}86%{stroke-dashoffset:0;opacity:1}95%{stroke-dashoffset:0;opacity:0}100%{stroke-dashoffset:1;opacity:0}}
@media (max-width:680px){.hh-name{font-size:clamp(40px,13vw,64px)}.hh-role{gap:14px}}
@media (prefers-reduced-motion:reduce){.hh-oval path{stroke-dashoffset:0;opacity:1;animation:none}}
</style>
