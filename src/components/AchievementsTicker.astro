---
// Achievements ticker — a marquee of DJ's career milestones that drifts RIGHT,
// intentionally counter to the brand-logo slider (BrandTicker drifts left).
// Replaces the old static stat bar. Content duplicated once for a seamless loop.
const items = [
  { k: '✳',      v: 'Emmy-winning Know Vape campaign' },
  { k: '4x',     v: 'agency revenue grown' },
  { k: '3.6M+',  v: 'impressions on a single launch' },
  { k: '2 to 30+', v: 'creatives led per team' },
  { k: '2M+',    v: 'brand audience engaged' },
  { k: 'Roster', v: 'Sony · Intel · Adorama + more' },
];
---
<div class="ach-ticker" aria-label="Selected achievements">
  <div class="ach-track">
    {[0, 1].map(() => items.map((a) => (
      <span class="ach-item"><b>{a.k}</b> {a.v}</span>
    )))}
  </div>
</div>
<style>
  .ach-ticker { background: var(--struct); color: rgb(var(--on-rgb)); overflow: hidden; }
  .ach-track { display: flex; align-items: center; width: max-content; animation: achDriftR 46s linear infinite; will-change: transform; }
  .ach-ticker:hover .ach-track { animation-play-state: paused; }
  .ach-item {
    flex: 0 0 auto; display: inline-flex; align-items: center; gap: 9px;
    padding: 17px 32px; font-family: var(--mono); font-size: 11.5px;
    letter-spacing: .08em; text-transform: uppercase; color: rgba(var(--on-rgb), .72);
    border-left: 1px solid rgba(var(--on-rgb), .2); white-space: nowrap;
  }
  .ach-item b { color: rgb(var(--on-rgb)); font-weight: 400; }
  /* drift RIGHT — opposite the brand slider */
  @keyframes achDriftR { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) { .ach-track { animation: none; transform: none; } }
</style>
