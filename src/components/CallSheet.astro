---
// CallSheet.astro · concept C "The Call Sheet" from public/redesign/credits-mockup.html
// The one credits treatment for every work page: an archival production slip,
// taped to the page, red rule, cobalt-ruled rows, rubber stamp.
// Self-contained: tokens resolve on the cut pages, fallbacks carry Base-layout pages.
interface Row {
  k: string;
  v: string;
  select?: boolean;
}
interface Props {
  code?: string;
  sub?: string;
  rows: Row[];
  filed?: string;
  rotate?: number;
  tone?: 'dark' | 'light';
}
const { code, sub, rows, filed, rotate = -1.4, tone = 'dark' } = Astro.props;
const crew = String(rows.length).padStart(2, '0');
---
<div class="callsheet">
  <div class={`sheet ${tone}`} style={`--rot:${rotate}deg`}>
    <span class="tape" aria-hidden="true"></span>
    <div class="shead">
      <span class="lft">Crew manifest</span>
      {code && <span class="rgt">{code}</span>}
    </div>
    {sub && <div class="ssub">{sub}</div>}
    <div class="redrule" aria-hidden="true"></div>
    {rows.map((row) => (
      <div class="srow">
        <span class="r">{row.k}</span>
        <span class="n">{row.select ? <><i class="mk">✳</i>{' '}</> : ''}{row.v}</span>
      </div>
    ))}
    {filed && <span class="sfoot">Filed {filed} · Crew of {crew}</span>}
    <span class="stamp">Monuments<small>Archive</small></span>
  </div>
</div>

<style>
.callsheet{display:flex;justify-content:center}
.sheet{position:relative;width:430px;max-width:100%;background:#FCFBF7;color:var(--ink,#161514);padding:24px 28px 66px;transform:rotate(var(--rot,-1.4deg))}
.sheet.light{box-shadow:0 1px 2px rgba(22,21,20,.14),0 6px 14px rgba(22,21,20,.12),0 22px 48px rgba(22,21,20,.20)}
.sheet.dark{box-shadow:0 1px 2px rgba(0,0,0,.4),0 10px 24px rgba(0,0,0,.45),0 30px 70px rgba(0,0,0,.55)}
.tape{position:absolute;top:-13px;left:50%;transform:translateX(-50%) rotate(-2deg);width:96px;height:27px;background:rgba(230,222,203,.6);box-shadow:0 1px 2px rgba(22,21,20,.08);backdrop-filter:blur(1px)}
.sheet.dark .tape{background:rgba(230,222,203,.5)}
.shead{display:flex;justify-content:space-between;align-items:baseline;font-family:var(--mono,'Fragment Mono',monospace);font-size:10px;letter-spacing:.16em;text-transform:uppercase}
.shead .lft{font-weight:400}
.shead .rgt{color:var(--dim,#8f8d88)}
.ssub{font-family:var(--mono,'Fragment Mono',monospace);font-size:8.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--dim,#8f8d88);margin-top:5px}
.redrule{border-top:2px solid var(--red,#E0311A);margin:12px -28px 6px;opacity:.85}
.srow{display:flex;justify-content:space-between;align-items:baseline;gap:18px;padding:10px 0 8px;border-bottom:1px solid rgba(36,56,232,.18)}
.srow .r{font-family:var(--mono,'Fragment Mono',monospace);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim,#8f8d88);flex-shrink:0}
.srow .n{font-family:var(--mono,'Fragment Mono',monospace);font-size:11.5px;letter-spacing:.04em;color:var(--ink,#161514);text-align:right}
.srow .n .mk{font-style:normal;color:var(--red,#E0311A)}
.sfoot{position:absolute;left:28px;right:150px;bottom:16px;font-family:var(--mono,'Fragment Mono',monospace);font-size:7.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim,#8f8d88);line-height:1.7}
.stamp{position:absolute;right:16px;bottom:22px;transform:rotate(-7deg);border:2px solid var(--red,#E0311A);border-radius:4px;color:var(--red,#E0311A);font-family:var(--mono,'Fragment Mono',monospace);font-size:10px;letter-spacing:.2em;text-transform:uppercase;padding:7px 12px 6px;text-align:center;opacity:.55;mix-blend-mode:multiply;line-height:1.6}
.stamp small{display:block;font-size:7px;letter-spacing:.3em}
</style>
