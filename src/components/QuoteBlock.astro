---
// QuoteBlock.astro — a pull quote + attribution. Serif italic, with optional
// <b> for a display-type emphasis. Self-contained.
//
//   <QuoteBlock quote={`The line that <b>sums it up</b>.`} who="What the quote is" tone="accent" />
//
// tone: 'accent' (default, spark ground) | 'paper' | 'ink'
interface Props { quote: string; who?: string; tone?: 'accent' | 'paper' | 'ink'; }
const { quote, who, tone = 'accent' } = Astro.props;
---
<section class:list={["qb", `qb-${tone}`]}>
  <div class="qb-in">
    <p class="qb-q" set:html={quote} />
    {who && <p class="qb-who">{who}</p>}
  </div>
</section>
<style>
.qb { padding: clamp(60px, 13vh, 140px) 0; }
.qb-accent { background: var(--spark, #EFA1AD); color: var(--ink, #161514); }
.qb-paper  { background: var(--paper, #F5F3EF); color: var(--ink, #161514); }
.qb-ink    { background: var(--ink, #161514); color: var(--paper, #F5F3EF); }
.qb-in { max-width: var(--wrap, 1300px); margin: 0 auto; padding: 0 var(--pad, clamp(22px,5vw,40px)); }
.qb-q { margin: 0; font-family: var(--serif, 'Instrument Serif', serif); font-style: italic; font-weight: 400; font-size: clamp(26px, 4vw, 54px); line-height: 1.15; max-width: 24ch; }
.qb-q :global(b) { font-family: var(--disp, sans-serif); font-style: normal; font-weight: var(--dispw, 800); text-transform: uppercase; font-size: .82em; letter-spacing: -.02em; }
.qb-who { margin: 26px 0 0; font-family: var(--mono, monospace); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; opacity: .62; }
</style>
