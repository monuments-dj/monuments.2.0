---
// page-template.astro — a WORKED EXAMPLE, built from the block system with real
// copy (Art of Visuals). Copy this file, rename it under src/pages/work/, and
// swap the copy + images in each block. Every section is a named, self-contained
// block (src/components/): PageHero · StatRow · TextBlock · MediaBlock ·
// LedgerBlock · QuoteBlock · CallSheet · CtaBlock · NextFile · PageFooter.
// Compose in any order; alternate light and dark for rhythm. Nothing is bespoke,
// so swapping copy or images can't break the layout.
// Not linked in nav + noindexed — reference only.
import PageHero from '../components/PageHero.astro';
import StatRow from '../components/StatRow.astro';
import TextBlock from '../components/TextBlock.astro';
import MediaBlock from '../components/MediaBlock.astro';
import LedgerBlock from '../components/LedgerBlock.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import CallSheet from '../components/CallSheet.astro';
import CtaBlock from '../components/CtaBlock.astro';
import NextFile from '../components/NextFile.astro';
import PageFooter from '../components/PageFooter.astro';
const AOV = '/case-studies/art-of-visuals';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Page template · Art of Visuals · Monuments</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Fragment+Mono:ital@0;1&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style is:global>
:root{
  --ink:#161514; --paper:#F5F3EF; --rose:#EFA1AD; --red:#E0311A;
  --dim:#8f8d88; --line:#dcd9d2; --lined:#2c2b29;
  --wrap:1380px; --pad:clamp(22px,4.6vw,44px);
  --disp:'Bricolage Grotesque',sans-serif; --dispw:800; --dispw2:600;
  --serif:'Instrument Serif',serif;
  --mono:'Fragment Mono',monospace;
  --spark:var(--rose); --struct:var(--rose); --on-rgb:22,21,20;
}
*{margin:0;box-sizing:border-box}
body{background:var(--ink);color:var(--paper);font-family:var(--disp);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}html{overflow-x:clip}
a{color:inherit;text-decoration:none}
.corners{position:fixed;inset:0;z-index:60;pointer-events:none;mix-blend-mode:difference}
.corners span{position:absolute;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#fff}
.corners .c1{top:20px;left:38px;pointer-events:auto}
.corners .c1 b{font-family:var(--disp);font-weight:var(--dispw);font-size:34px;letter-spacing:-.01em}
.corners .c1 i{font-style:normal;color:#fff;display:inline-block;animation:tplspin 7s linear infinite}
.corners .c2{top:26px;right:22px;pointer-events:auto}
.corners .c2 a{font-size:15px;letter-spacing:.06em;margin-left:22px}
.corners .c3{bottom:20px;left:22px}
.corners .c4{bottom:20px;right:22px}
@keyframes tplspin{to{transform:rotate(360deg)}}
.tpl-credits{background:var(--paper);color:var(--ink)}
.tpl-credits .in{max-width:var(--wrap);margin:0 auto;padding:clamp(48px,9vh,90px) var(--pad)}
@media (max-width:680px){.corners .c2,.corners .c3{display:none}}
</style>
</head>
<body>
<div class="corners">
  <span class="c1"><a href="/"><b>M<i>✳</i>NUMENTS</b></a></span>
  <span class="c2"><a href="/work">Work</a><a href="/about">About</a><a href="/contact">Contact</a></span>
  <span class="c3">MC-AOV-01 · Art of Visuals · Worked example</span>
  <span class="c4" id="clock">LA --:--</span>
</div>

<PageHero
  image={`${AOV}/hero-poster.jpg`}
  title={`From community, <span class="serif">to agency.</span>`}
  kicker={`<b>\\ Case file</b><br>Art of Visuals<br>Creative direction · Four years`}
  role="creative director · art of visuals"
  nfoHead="NFO"
  nfo={["Client · Art of Visuals", "Role · Creative Director", "Scope · The agency build", "Frame · MC-AOV-01"]}
/>

<StatRow
  stats={[
    { value: "4x", label: "agency revenue growth" },
    { value: "2M+", label: "the community behind the agency" },
    { value: "$200K+", label: "commercial budgets by the end" },
  ]}
  note="Roster · Sony · Adorama · MSI · Intel · Lexar · Peak Design · WANDRD"
/>

<TextBlock tone="light" variant="statement" kicker="\ The insight" heading={`Brands don't know <span class="tb-serif">how to be cool.</span>`}>
  <p>That's not an insult. It's a market.</p>
  <p>Sony and MSI would show up with a product built for creators and the same questions every time: how do we talk to them, what reads as real, which voices actually matter? AOV had the audience, the data, and years of making the content, so we weren't guessing. We were a voice of authority, and we knew the others. We sold strategy and consulting on culture, made the introductions, and managed the influencers.</p>
  <p>That's why the work compounded. We weren't a vendor renting out a camera crew. We were the translator between brands and the creator world.</p>
</TextBlock>

<MediaBlock layout="trio" images={[
  { src: `${AOV}/msi/msi-02.jpg`, alt: "MSI campaign still", caption: "MSI · a campaign that launched in Times Square" },
  { src: `${AOV}/msi/msi-04.jpg`, alt: "MSI campaign still", caption: "MSI · on the shoot" },
  { src: `${AOV}/msi/msi-08.jpg`, alt: "MSI campaign still", caption: "MSI · the boards" },
]} />

<TextBlock tone="dark" kicker="\ The number" heading={`A community, turned into a <span class="tb-serif">creative business.</span>`}>
  <p>When I joined Art of Visuals, it was a community page with a massive audience, pushing two million, sharing inspiration, reposting, and running giveaways. Every piece of work lived on AOV's own channels.</p>
  <p>Four years later it was a working agency: commercials with budgets north of $200K, influencer campaigns with the biggest voices in tech, an MSI campaign that launched in Times Square, and a global client roster. Revenue was 4x.</p>
  <p>The audience was mostly there before me. Some of the brands were too. What changed was how we engaged them: bigger pitches, more multi-platform work. The agency is what we built, and the creative was my lane.</p>
</TextBlock>

<LedgerBlock
  kicker="\ The book of business"
  heading={`Not one campaign. <span class="lb-serif">A book of business.</span>`}
  rows={[
    { href: "/work/sony-this-moment", img: `/case-studies/sony-this-moment/gallery/tm-05.jpg`, title: "Sony · This Moment", meta: "XM4 · national campaign film · director + CD" },
    { href: "/work/sony-xm5", img: `${AOV}/gallery/xm5-01.jpg`, title: "Sony · XM5", meta: "Headphone launch · cast as talent · 1.3M impressions" },
    { href: "/work/sony-xperia", img: `${AOV}/gallery/xperia-01.jpg`, title: "Sony · Xperia", meta: "Five launches, four years · films + stills" },
    { href: "/work/adorama-music", img: `/case-studies/adorama-music/gallery/am-01.jpg`, title: "Adorama · Create No Matter What", meta: "Content series · Shorty finalist" },
    { href: "/work/on-camera", img: `${AOV}/gallery/podcast-cover.jpg`, title: "On Camera · Creator Clubhouse", meta: "Weekly podcast · 30K monthly listeners" },
  ]}
/>

<MediaBlock layout="duo" images={[
  { src: `${AOV}/gallery/xm4-01.jpg`, alt: "Sony XM4 campaign film still", caption: "The XM4 film, shot on the a7S III" },
  { src: `${AOV}/gallery/xm5-01.jpg`, alt: "Sony XM5 launch still", caption: "The XM5 launch, influencers cast as talent" },
]} />

<QuoteBlock
  tone="ink"
  quote={`Growth like that is not a lucky project. It is <b>an offer brands keep buying</b>, and creative good enough that the first job turns into the next one.`}
  who="The agency era, in one sentence"
/>

<section class="tpl-credits">
  <div class="in">
    <CallSheet
      code="MC-AOV-01"
      sub="Art of Visuals · credits"
      filed="MMXXV"
      tone="light"
      rows={[
        { k: 'Strategy', v: 'Shaped what the agency sold, then packaged it into an offer brands actually bought', select: true },
        { k: 'Creative direction', v: 'Owned all creative on the agency side, first pitch to final delivery' },
        { k: 'Team', v: 'Ran a core crew of five, scaling with crew and designers per production' },
        { k: 'New business', v: 'Turned the community and the reel into a pipeline, the engine behind the 4x' },
        { k: 'Client lead', v: 'The point of contact brands trusted, the reason they kept us as their AOR' },
      ]}
    />
  </div>
</section>

<CtaBlock heading={`Let's build something <span class="serif">worth remembering.</span>`} />

<NextFile href="/work/sony-this-moment" name="Sony · This Moment" img={`/case-studies/sony-this-moment/gallery/tm-05.jpg`} code="MC-AOV-01" />
<PageFooter tag="Art of Visuals" />

<script is:inline>
(function(){var c=document.getElementById('clock');function t(){if(!c)return;c.textContent='LA '+new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});}t();setInterval(t,30000);})();
</script>
</body>
</html>
