---
// page-template.astro - THE FLOWING PATTERN. One real case page (Art of Visuals),
// curated, with a deliberate light / accent / dark rhythm so the page MOVES: no two
// content bands share a ground, breaks + accent bands beat between the light sections.
// This is the arrangement to copy for a new work page. Real copy, real elements.
// Named element index (pull-from reference) lives on the Kit (/template) + /page-elements.
// Not linked in nav + noindexed.
import CallSheet from '../components/CallSheet.astro';
import NextFile from '../components/NextFile.astro';
import PageFooter from '../components/PageFooter.astro';
import RoleTag from '../components/RoleTag.astro';
import MasonryGallery from '../components/MasonryGallery.astro';
import TextColumns from '../components/TextColumns.astro';
const AOV = '/case-studies/art-of-visuals';
// the section rhythm, top to bottom: D=dark A=accent L=light
// HERO(D) · STATROW(A) · NUMBER(L) · BREAK(D) · HOW(L) · BEAT(A) · INSIGHT(D) · SHEET(L) · QUOTE(A) · LEDGER(L) · BREAK(D) · CTA(A) · NEXT(D)
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Page template · Monuments</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Fragment+Mono:ital@0;1&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style is:global>
:root{
  --ink:#161514; --paper:#F5F3EF; --rose:#EFA1AD; --red:#E0311A;
  --dim:#8f8d88; --line:#dcd9d2; --lined:#2c2b29;
  --wrap:1380px; --pad:clamp(22px,4.6vw,44px);
  --disp:'Bricolage Grotesque',sans-serif; --dispw:800; --dispw2:600;
  --serif:'Instrument Serif',serif; --mono:'Fragment Mono',monospace;
  --spark:var(--rose); --struct:var(--rose); --on-rgb:22,21,20;
}
*{margin:0;box-sizing:border-box}
body{background:var(--ink);color:var(--paper);font-family:var(--disp);font-size:17px;line-height:1.6;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}html{overflow-x:clip}
.mono{font-family:var(--mono);font-size:11px;letter-spacing:.07em;text-transform:uppercase;font-weight:400}
.wrap{max-width:var(--wrap);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}
a{color:inherit;text-decoration:none}

/* chrome */
.corners{position:fixed;inset:0;z-index:60;pointer-events:none;mix-blend-mode:difference}
.corners span{position:absolute;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#fff}
.corners .c1{top:20px;left:38px;pointer-events:auto}
.corners .c1 b{font-family:var(--disp);font-weight:var(--dispw);font-size:34px;letter-spacing:-.01em}
.corners .c1 i{font-style:normal;display:inline-block;animation:spin 7s linear infinite}
.corners .c2{top:26px;right:22px;pointer-events:auto}
.corners .c2 a{font-size:15px;letter-spacing:.06em;margin-left:22px}
.corners .c3{bottom:20px;left:22px}
.corners .c4{bottom:20px;right:22px}
@keyframes spin{to{transform:rotate(360deg)}}
.companion{position:fixed;right:24px;top:50%;z-index:58;font-size:20px;color:#fff;mix-blend-mode:difference;pointer-events:none;will-change:transform;line-height:1}
@media (max-width:900px){.companion{display:none}}

/* HERO · dark */
.hero{position:relative;height:80svh;min-height:560px;overflow:hidden;background:var(--ink)}
.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:contrast(1.02) brightness(0.55)}
.hero .t{z-index:72;position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);width:104%;text-align:center;color:var(--paper);font-weight:var(--dispw);font-size:clamp(56px,10.6vw,140px);line-height:.9;letter-spacing:-.035em;text-transform:uppercase;mix-blend-mode:screen}
.hero .t .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:-.01em}
.hero .t .spark{color:var(--spark);mix-blend-mode:normal}
.hero .t .ln{display:block;overflow:hidden;padding-bottom:.18em;margin-bottom:-.18em}
.hero .t .ln>span{display:block;transform:translateY(125%);animation:rise 1s cubic-bezier(.22,1,.36,1) forwards}
.hero .t .ln:nth-child(2)>span{animation-delay:.12s}
@keyframes rise{to{transform:translateY(0)}}
.hero .nfo{z-index:72;position:absolute;right:var(--pad);bottom:10vh;text-align:left;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;line-height:1.9;color:var(--paper);opacity:0;animation:fade 1s .8s forwards}
.hero .nfo .h{color:var(--struct);background:var(--paper);padding:1px 7px;display:inline-block;margin-bottom:8px}
.hero .kck{z-index:72;position:absolute;left:var(--pad);bottom:10vh;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--paper);opacity:0;animation:fade 1s .7s forwards;line-height:1.9}
.hero .kck b{color:var(--spark);font-weight:400}
@keyframes fade{to{opacity:1}}

/* STAT ROW · accent band */
.statrow{background:var(--struct);color:rgb(var(--on-rgb));border-bottom:1px solid rgba(var(--on-rgb),.18)}
.statrow>.in{display:flex;justify-content:center;align-items:flex-end;gap:clamp(30px,4.6vw,64px);flex-wrap:wrap;padding:20px var(--pad) 18px}
.stat b{display:block;font-weight:var(--dispw);font-size:clamp(26px,2.7vw,42px);letter-spacing:-.03em;line-height:.92}
.stat span{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:rgba(var(--on-rgb),.66);display:block;margin-top:8px}
.stat .note{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:rgba(var(--on-rgb),.66);line-height:1.9;max-width:30ch;text-align:right}
.stat .note b{font-family:var(--mono);font-size:11px;font-weight:400;letter-spacing:.08em;color:rgb(var(--on-rgb));display:inline}

/* STORY · light */
.paper{background:var(--paper);color:var(--ink)}
.story{display:grid;grid-template-columns:.62fr 1.38fr;gap:56px 64px;padding-top:11vh;padding-bottom:11vh;align-items:start}
.story .side .k{color:var(--red)}
.story h2{font-weight:var(--dispw);font-size:clamp(26px,3.2vw,44px);letter-spacing:-.03em;line-height:1.02;text-transform:uppercase;margin-top:14px}
.story h2 .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.story .body p{color:#4c4a45;max-width:60ch;margin-bottom:1.2em;font-size:18px}
.story .body p:first-child{font-size:clamp(19px,1.8vw,24px);line-height:1.5;color:var(--ink)}
@media (max-width:900px){.story{grid-template-columns:1fr}}

/* TWO-COLUMN · light + dark variant */
.block{padding-top:11vh;padding-bottom:11vh}
.block .k{color:var(--red);display:block;margin-bottom:12px}
.block h2{font-weight:var(--dispw);font-size:clamp(26px,3.2vw,44px);letter-spacing:-.03em;line-height:1.02;text-transform:uppercase;max-width:24ch;margin:0}
.block h2 .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.block .cols{columns:2;column-gap:64px;margin-top:40px}
.block .cols p{color:#4c4a45;font-size:16.5px;line-height:1.62;margin:0 0 1.25em;break-inside:avoid}
.block .cols p b{color:var(--ink);font-weight:600}
.block-dark{background:var(--ink);color:var(--paper)}
.block-dark .k{color:var(--spark)}
.block-dark h2{color:var(--paper)}
.block-dark .cols p{color:rgba(245,243,239,.74)}
.block-dark .cols p b{color:var(--paper)}
@media(max-width:820px){.block .cols{columns:1}}

/* STAT BEAT · accent */
.statbeat{background:var(--struct);color:rgb(var(--on-rgb))}
.statbeat .in{display:flex;justify-content:center;gap:clamp(34px,7vw,100px);flex-wrap:wrap;text-align:center;padding:11vh var(--pad)}
.statbeat b{display:block;font-weight:var(--dispw);font-size:clamp(40px,5.6vw,86px);letter-spacing:-.04em;line-height:.85}
.statbeat span{display:block;margin-top:14px;font-family:var(--mono);font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:rgba(var(--on-rgb),.72);max-width:22ch}

/* FULL-BLEED BREAK · dark */
.break{position:relative;height:56svh;overflow:hidden}
.break img{position:absolute;inset:-12% 0;width:100%;height:124%;object-fit:cover;object-position:50% 50%;will-change:transform}
.break .cap{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center;font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(245,243,239,.92);background:rgba(22,21,20,.42);padding:6px 12px;backdrop-filter:blur(2px)}

/* CONTACT SHEET · light */
.gal{padding:11vh 0}
.gal .bar{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:12px;border-bottom:2px solid var(--ink);margin-bottom:16px}
.gal .bar .mono b{color:var(--red)}
.frames{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;grid-auto-flow:dense}
.fr{position:relative;background:#fff;border:1px solid var(--line);padding:8px 8px 26px;opacity:0;transform:translateY(16px) rotate(-.6deg)}
.frames.show .fr{opacity:1;transform:none;transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1),box-shadow .35s;transition-delay:var(--d,0ms)}
.fr img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;filter:saturate(.96)}
.fr .cap{position:absolute;left:9px;bottom:6px;font-family:var(--mono);font-size:9px;color:var(--dim);text-transform:uppercase}
.frames.show .fr:hover{transform:rotate(-1deg) scale(1.03);box-shadow:0 16px 40px rgba(20,20,20,.18);z-index:2;transition-delay:0ms}
.fr.wide{grid-column:span 2}.fr.wide img{aspect-ratio:8/4.6}
@media (max-width:900px){.frames{grid-template-columns:1fr 1fr}}

/* QUOTE · accent */
.quote{background:var(--spark);color:var(--ink);padding:15vh 0}
.quote p.q{font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(28px,4vw,58px);line-height:1.14;max-width:26ch}
.quote p.q b{font-style:normal;font-family:var(--disp);font-weight:var(--dispw);text-transform:uppercase;font-size:.86em;letter-spacing:-.02em}
.quote .who{margin-top:28px;color:rgba(22,21,20,.6)}

/* LEDGER · light */
.bob{padding:2vh 0 11vh}
.bob .bar{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:12px;margin-bottom:4px}
.bob .bar .mono b{color:var(--red)}
.bob-rows{border-top:2px solid var(--ink)}
.bob-row{display:grid;grid-template-columns:118px 1fr auto 28px;align-items:center;gap:18px 26px;padding:14px 2px;border-bottom:1px solid var(--line);transition:background .3s}
.bob-row img{width:118px;aspect-ratio:16/9;object-fit:cover;display:block;border-radius:5px;filter:grayscale(1) contrast(1.04);transition:filter .35s}
.bob-row .bt{font-weight:var(--dispw2);font-size:clamp(17px,1.7vw,23px);letter-spacing:-.015em;line-height:1.05;text-transform:uppercase}
.bob-row .bm{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:#8f8d88;text-align:right}
.bob-row .ba{font-size:14px;color:var(--red);transition:transform .35s cubic-bezier(.22,1,.36,1)}
.bob-row:hover{background:rgba(22,21,20,.035)}.bob-row:hover img{filter:none}.bob-row:hover .ba{transform:translate(4px,-3px)}
@media (max-width:680px){.bob-row{grid-template-columns:86px 1fr 20px}.bob-row .bm{display:none}.bob-row img{width:86px}}

/* CTA BAND · accent */
.cta{background:var(--struct);color:rgb(var(--on-rgb));padding:13vh 0}
.cta .in{display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap}
.cta .big{font-weight:var(--dispw);font-size:clamp(28px,4.2vw,60px);letter-spacing:-.03em;line-height:1;text-transform:uppercase;max-width:16ch}
.cta .ck{display:block;font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:rgba(var(--on-rgb),.7);margin-bottom:14px}
.cta .big .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.cta a.talk{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;border:1.5px solid rgba(var(--on-rgb),.75);padding:16px 26px;border-radius:50%;transition:background .3s,color .3s,transform .3s;display:inline-block}
.cta a.talk:hover{background:rgb(var(--on-rgb));color:var(--struct);transform:scale(1.05)}

.credits{padding:11vh 0}
.rv{opacity:0;transform:translateY(28px);transition:opacity .85s cubic-bezier(.22,1,.36,1),transform .85s cubic-bezier(.22,1,.36,1)}
.rv.in{opacity:1;transform:none}

@media (max-width:680px){.corners .c2,.corners .c3,.corners .c4{display:none}.corners .c1 b{font-size:23px}.hero .t{width:100%!important;font-size:clamp(32px,8.8vw,48px)!important;padding:0 16px}.hero .kck{display:none}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.hero .t .ln>span{transform:none}.hero .nfo,.hero .kck{opacity:1}.rv{opacity:1;transform:none}.frames .fr{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="companion" aria-hidden="true">✳</div>
<div class="corners">
  <span class="c1"><a href="/"><b>M<i>✳</i>NUMENTS</b></a></span>
  <span class="c2"><a href="/work">Work</a><a href="/about">About</a><a href="/contact">Contact</a></span>
  <span class="c3">MC-2024-01 · Art of Visuals · The 4x era</span>
  <span class="c4" id="clock">LA --:--</span>
</div>

<!-- 1 · HERO · dark -->
<header class="hero">
  <img src={`${AOV}/hero-poster.jpg`} alt="Art of Visuals campaign work">
  <div class="t">
    <span class="ln"><span>From community</span></span>
    <span class="ln"><span>to <span class="serif">agency</span><span class="spark">.</span></span></span>
    <RoleTag text="creative director" />
  </div>
  <div class="kck"><b>\ Case file</b><br>Art of Visuals · Agency growth<br>Not one campaign. A book of business.</div>
  <div class="nfo"><span class="h">NFO</span><br>Agency · Art of Visuals<br>Role · Creative Director<br>Roster · Sony, Adorama, MSI, Intel +<br>Frame · MC-2024-01</div>
</header>

<!-- 2 · STAT ROW · accent -->
<div class="statrow"><div class="wrap in">
  <div class="stat"><b>4x</b><span>agency revenue growth</span></div>
  <div class="stat"><b>2M+</b><span>the community behind it</span></div>
  <div class="stat"><b>$200K+</b><span>commercial budgets</span></div>
  <div class="stat"><p class="note">Roster · <b>Sony · Adorama · MSI · Intel · Lexar · Peak Design · WANDRD</b></p></div>
</div></div>

<!-- 3 · THE NUMBER · light -->
<section class="paper"><div class="wrap story">
  <div class="side rv">
    <span class="k mono">\ The number</span>
    <h2>A community, turned into a <span class="serif">creative business.</span></h2>
  </div>
  <div class="body rv">
    <p>When I joined Art of Visuals, it was a community page with a massive audience, pushing two million, sharing inspiration, reposting, and running giveaways. Every piece of work lived on AOV's own channels.</p>
    <p>Four years later it was a working agency: commercials with budgets north of $200K, influencer campaigns with the biggest voices in tech, an MSI campaign that launched in Times Square, and a global client roster. Revenue was 4x.</p>
    <p>The audience was mostly there before me. Some of the brands were too. What changed was how we engaged them. The agency is what we built, and the creative was my lane.</p>
  </div>
</div></section>

<!-- 4 · BREAK · dark -->
<div class="break">
  <img loading="lazy" decoding="async" src={`${AOV}/gallery/xm4-01.jpg`} alt="Sony XM4 campaign still">
  <span class="cap">✳ Sony × Art of Visuals · the reel that sold the room</span>
</div>

<!-- 5 · HOW IT HAPPENED · simple two-column text block · LIGHT (TextColumns.astro) -->
<TextColumns tone="light" kicker="\ How it happened" heading="Everything culture touches.">
  <p><b>The offer:</b> retainers, campaigns, one-off ads, distribution on AOV's channels, strategy and consulting. Weekly content that lived on brands' channels and in their ad accounts, focused on the outdoor space and consumer electronics.</p>
  <p><b>The wins:</b> Sony, Adorama, MSI, Intel, Lexar, Peak Design, WANDRD. Clients from LA and New York to Japan and China. By the end: $200K+ commercials, and an MSI campaign launching in Times Square.</p>
  <p><b>The team:</b> direct reports across the video team, scaled with crew and designers per production. I ran all creative on the agency side and carried the pitches, the sales, and the client relationships.</p>
  <p><b>The community:</b> it never stopped being one. Workshops, meetups, a weekly podcast at 30K monthly listeners. That is exactly what made the agency credible.</p>
</TextColumns>

<!-- 6 · STAT BEAT · accent -->
<section class="statbeat"><div class="in">
  <div><b>1.3M</b><span>impressions from one XM5 shoot, influencers cast as talent</span></div>
  <div><b>9%</b><span>engagement, against a 2x branded-social benchmark</span></div>
</div></section>

<!-- 7 · GALLERY · light (masonry + lightbox) -->
<MasonryGallery title="Frames from the 4x era" note="07 frames · click to enlarge" images={[
  { src: `${AOV}/gallery/xperia-01.jpg`, cap: 'Sony Xperia' },
  { src: `${AOV}/gallery/xm4-01.jpg`, cap: 'Sony XM4' },
  { src: `${AOV}/gallery/xperia-02.jpg`, cap: 'Sony Xperia' },
  { src: `${AOV}/gallery/xm3-bts.jpg`, cap: 'XM3 · behind the scenes' },
  { src: `${AOV}/gallery/yt-thismoment.jpg`, cap: 'Sony · This Moment' },
  { src: `${AOV}/gallery/stansport-01.jpg`, cap: 'Stansport' },
  { src: `${AOV}/gallery/podcast-cover.jpg`, cap: 'Creator Clubhouse' },
]} />

<!-- 8 · THE INSIGHT · simple two-column text block · DARK (TextColumns.astro) -->
<TextColumns tone="dark" kicker="\ The insight" heading="Brands don't know how to be cool.">
  <p>That's not an insult. It's a market. Sony and MSI would show up with a product built for creators and the same questions every time: how do we talk to them, what reads as real, which voices actually matter?</p>
  <p>AOV had the audience, the data, and years of making the content, so we weren't guessing. We sold strategy and consulting on culture, made the introductions, and managed the influencers. We weren't renting out a camera crew. We were the translator between brands and the creator world.</p>
</TextColumns>

<!-- 9 · QUOTE · accent -->
<section class="quote"><div class="wrap">
  <p class="q rv">"Growth like that is not a lucky project. It is an offer brands keep buying, and creative good enough that <b>the first job turns into the next one.</b>"</p>
  <p class="who mono rv">The agency era, in one sentence</p>
</div></section>

<!-- 10 · BREAK · dark -->
<div class="break">
  <img loading="lazy" decoding="async" src={`${AOV}/msi/msi-06.jpg`} alt="MSI campaign on location">
  <span class="cap">✳ MSI × Art of Visuals · on location for the creator-laptop launch</span>
</div>

<!-- 11 · LEDGER · light -->
<section class="paper"><div class="wrap bob">
  <div class="bar"><span class="mono"><b>The book of business</b> · campaigns delivered under this roof</span><span class="mono" style="color:#8f8d88">every row is a case file ↗</span></div>
  <div class="bob-rows">
    <a class="bob-row" href="/work/sony-this-moment"><img loading="lazy" decoding="async" src="/case-studies/sony-this-moment/gallery/tm-05.jpg" alt="Sony This Moment"><span class="bt">Sony · This Moment</span><span class="bm mono">XM4 · national campaign film · director + CD</span><span class="ba mono">↗</span></a>
    <a class="bob-row" href="/work/sony-xm5"><img loading="lazy" decoding="async" src={`${AOV}/gallery/xm5-01.jpg`} alt="Sony XM5"><span class="bt">Sony · XM5</span><span class="bm mono">influencer activation · 1.3M impressions · 9% engagement</span><span class="ba mono">↗</span></a>
    <a class="bob-row" href="/work/adorama-music"><img loading="lazy" decoding="async" src="/case-studies/adorama-music/gallery/am-01.jpg" alt="Adorama Music"><span class="bt">Adorama · Create No Matter What</span><span class="bm mono">content series · Shorty finalist</span><span class="ba mono">↗</span></a>
    <a class="bob-row" href="/work/on-camera"><img loading="lazy" decoding="async" src={`${AOV}/gallery/podcast-cover.jpg`} alt="On Camera"><span class="bt">Creator Clubhouse · On Camera</span><span class="bm mono">the agency podcast · 30K monthly · 12 tapes</span><span class="ba mono">↗</span></a>
  </div>
</div></section>

<!-- 12 · CTA · accent -->
<section class="cta"><div class="wrap in">
  <div>
    <span class="ck mono">✳ Being forgettable is expensive</span>
    <p class="big">Let's build something<br><span class="serif">worth remembering.</span></p>
  </div>
  <a class="talk" href="/contact">Let's talk ↗</a>
</div></section>

<!-- credits sit on light before the closer -->
<section class="paper"><div class="wrap credits">
  <CallSheet code="MC-2024-01" sub="Art of Visuals · The 4x era" filed="MMXXI-MMXXIV" tone="light"
    rows={[
      { k: 'Strategy', v: 'Shaped what the agency sold, then packaged it into an offer brands actually bought', select: true },
      { k: 'Creative direction', v: 'Owned all creative on the agency side, first pitch to final delivery' },
      { k: 'Team', v: 'Ran a core crew of five, scaling with crew and designers per production' },
      { k: 'Client lead', v: 'The point of contact brands trusted, the reason they kept us as their AOR' },
    ]} />
</div></section>

<!-- 13 · NEXT FILE · dark -->
<NextFile href="/work/sony-this-moment" name="Sony · This Moment" img="/case-studies/sony-this-moment/gallery/tm-05.jpg" code="MC-2022-06" />
<PageFooter tag="Case: Art of Visuals" />

<script is:inline>
// reveal-on-scroll
(function(){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.01,rootMargin:'0px 0px 220px 0px'});document.querySelectorAll('.rv').forEach(function(el){io.observe(el);});})();
// hero + break parallax + companion drift
(function(){
  var hImg=document.querySelector('.hero>img'),hT=document.querySelector('.hero .t'),nfo=document.querySelector('.hero .nfo'),kck=document.querySelector('.hero .kck'),brk=document.querySelectorAll('.break img'),c=document.querySelector('.companion');
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var k=false;
  addEventListener('scroll',function(){if(k)return;k=true;requestAnimationFrame(function(){
    var y=scrollY,vh=innerHeight;
    if(y<vh&&hImg){hImg.style.transform='translateY('+(y*.22)+'px) scale(1.02)';if(hT){hT.style.transform='translate(-50%,-50%) translateY('+(y*-.1)+'px)';hT.style.opacity=String(Math.max(0,1-y/(vh*.9)));}if(nfo)nfo.style.transform='translateY('+(y*-.16)+'px)';if(kck)kck.style.transform='translateY('+(y*-.06)+'px)';}
    brk.forEach(function(b){var r=b.parentElement.getBoundingClientRect();if(r.bottom>0&&r.top<vh){var p=(r.top+r.height/2-vh/2)/vh;b.style.transform='translateY('+(p*-56)+'px)';}});
    if(c)c.style.transform='translateY('+(Math.sin(y/420)*34).toFixed(1)+'px) rotate('+(y*0.22).toFixed(1)+'deg)';
    k=false;
  });},{passive:true});
})();
// LA clock
function clock(){var el=document.getElementById('clock');if(!el)return;el.textContent='LA '+new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});}
clock();setInterval(clock,30000);
</script>
</body>
</html>
