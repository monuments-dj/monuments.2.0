---
// page-template.astro — the STARTING POINT for any case / content page.
// Copy this file, rename it under src/pages/work/, and swap the content in each
// block. Every section is a named, self-contained block (see src/components/):
//   PageHero · StatRow · TextBlock · MediaBlock · QuoteBlock · CallSheet · CtaBlock · NextFile · PageFooter
// Compose them in any order. Alternate TextBlock and MediaBlock for rhythm.
// Nothing here is bespoke, so adding copy or images can't break the layout.
// Not linked in nav + noindexed — it's a reference, not a shipped page.
import PageHero from '../components/PageHero.astro';
import StatRow from '../components/StatRow.astro';
import TextBlock from '../components/TextBlock.astro';
import MediaBlock from '../components/MediaBlock.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import CallSheet from '../components/CallSheet.astro';
import CtaBlock from '../components/CtaBlock.astro';
import NextFile from '../components/NextFile.astro';
import PageFooter from '../components/PageFooter.astro';
const G = '/case-studies/flashpoint/gallery'; // demo images only — swap per page
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Page template · Monuments</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Fragment+Mono:ital@0;1&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style is:global>
:root{
  --ink:#161514; --paper:#F5F3EF; --rose:#EFA1AD; --red:#E0311A;
  --dim:#8f8d88; --line:#dcd9d2; --lined:#2c2b29;
  --wrap:1380px; --pad:clamp(22px,4.6vw,44px);
  --disp:'Bricolage Grotesque',sans-serif; --dispw:800; --dispw2:600;
  --serif:'Instrument Serif',serif;
  --mono:'Fragment Mono',monospace;
  --spark:var(--rose); --struct:var(--rose); --on-rgb:22,21,20;
}
*{margin:0;box-sizing:border-box}
body{background:var(--ink);color:var(--paper);font-family:var(--disp);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}html{overflow-x:clip}
a{color:inherit;text-decoration:none}
.corners{position:fixed;inset:0;z-index:60;pointer-events:none;mix-blend-mode:difference}
.corners span{position:absolute;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#fff}
.corners .c1{top:20px;left:38px;pointer-events:auto}
.corners .c1 b{font-family:var(--disp);font-weight:var(--dispw);font-size:34px;letter-spacing:-.01em}
.corners .c1 i{font-style:normal;color:#fff;display:inline-block;animation:tplspin 7s linear infinite}
.corners .c2{top:26px;right:22px;pointer-events:auto}
.corners .c2 a{font-size:15px;letter-spacing:.06em;margin-left:22px}
.corners .c3{bottom:20px;left:22px}
.corners .c4{bottom:20px;right:22px}
@keyframes tplspin{to{transform:rotate(360deg)}}
.tpl-credits{background:var(--paper);color:var(--ink)}
.tpl-credits .in{max-width:var(--wrap);margin:0 auto;padding:clamp(48px,9vh,90px) var(--pad)}
@media (max-width:680px){.corners .c2,.corners .c3{display:none}}
</style>
</head>
<body>
<div class="corners">
  <span class="c1"><a href="/"><b>M<i>✳</i>NUMENTS</b></a></span>
  <span class="c2"><a href="/work">Work</a><a href="/about">About</a><a href="/contact">Contact</a></span>
  <span class="c3">MC-0000-00 · Page template · Basic structure</span>
  <span class="c4" id="clock">LA --:--</span>
</div>

<PageHero
  image={`${G}/fp-03.jpg`}
  title={`Page title, <span class="serif">two lines.</span>`}
  kicker={`<b>\\ Case file</b><br>Client · Project name<br>Discipline · Discipline · Year`}
  role="creative direction · your role"
  nfoHead="NFO"
  nfo={["Client · Name", "Role · Your role", "Agency · If any", "Frame · MC-0000-00"]}
/>

<StatRow
  stats={[
    { value: "4x", label: "a headline number" },
    { value: "2M+", label: "another number" },
    { value: "$200K+", label: "a third number" },
  ]}
  note="One supporting line, right-aligned. Nothing goes here you wouldn't say in an interview."
/>

<TextBlock variant="statement" kicker="\ The insight" heading={`The one big idea, <span class="tb-serif">stated plainly.</span>`}>
  <p>Open on the insight. One or two short paragraphs. This is the statement variant: a large headline and a tight lede, for openers and closers.</p>
</TextBlock>

<MediaBlock layout="duo" images={[
  { src: `${G}/fp-01.jpg`, alt: "Demo image", caption: "A two-up caption" },
  { src: `${G}/fp-02.jpg`, alt: "Demo image", caption: "A two-up caption" },
]} />

<TextBlock kicker="\ The work" heading={`A section heading at a <span class="tb-serif">readable size.</span>`}>
  <p>Body copy in complete sentences. This is the default variant, the workhorse for explanation. Drop in as many paragraphs as the section needs and it stays clean.</p>
  <p>Follow it with a MediaBlock for rhythm, or another TextBlock for a second beat.</p>
</TextBlock>

<MediaBlock layout="trio" images={[
  { src: `${G}/fp-04.jpg`, alt: "Demo image", caption: "One" },
  { src: `${G}/fp-06.jpg`, alt: "Demo image", caption: "Two" },
  { src: `${G}/fp-07.jpg`, alt: "Demo image", caption: "Three" },
]} />

<MediaBlock layout="full" images={[{ src: `${G}/fp-03.jpg`, alt: "Demo image", caption: "✳ A full-bleed banner between sections" }]} />

<QuoteBlock quote={`The line that <b>sums it up</b>, in one sentence.`} who="What the quote is" />

<section class="tpl-credits">
  <div class="in">
    <CallSheet
      code="MC-0000-00"
      sub="Page template · credits"
      filed="MMXXV"
      tone="light"
      rows={[
        { k: 'Role', v: 'DJ Ramirez', select: true },
        { k: 'Another role', v: 'DJ Ramirez' },
      ]}
    />
  </div>
</section>

<CtaBlock heading={`Let's build something <span class="serif">worth remembering.</span>`} />

<NextFile href="/work" name="All Work" img={`${G}/fp-01.jpg`} code="MC-0000-00" />
<PageFooter tag="Page template" />

<script is:inline>
(function(){var c=document.getElementById('clock');function t(){if(!c)return;c.textContent='LA '+new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});}t();setInterval(t,30000);})();
</script>
</body>
</html>
