  .mnav{display:flex;position:fixed;inset:0;z-index:80;background:var(--ink);flex-direction:column;justify-content:center;gap:2px;padding:0 var(--pad);transform:translateY(-100%);transition:transform .55s cubic-bezier(.76,0,.24,1)}
  #navtog:checked ~ .mnav{transform:none}
  .mnav a{font-family:var(--disp);font-weight:var(--dispw);font-size:clamp(34px,12vw,58px);line-height:1.05;text-transform:uppercase;letter-spacing:-.02em;color:var(--paper)}
