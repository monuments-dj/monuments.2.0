<script is:inline>
(function(){const g=document.getElementById('rays');let s='';for(let i=0;i<20;i++){s+=`<path d="M0,-34 L-8,-92 L8,-92 Z" transform="rotate(${i*18})"/>`}g.innerHTML=s})();
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

if(!matchMedia('(prefers-reduced-motion:reduce)').matches){
  const hImg=document.querySelector('.hero>img'),hT=document.querySelector('.hero .t'),crew=document.querySelector('.crew img');
  let tick=false;
  addEventListener('scroll',()=>{
    if(tick)return;tick=true;
    requestAnimationFrame(()=>{
      const y=scrollY,vh=innerHeight;
      if(y<vh){
        hImg.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        hT.style.transform=`translate(-50%,-50%) translateY(${y*-.1}px)`;
        hT.style.opacity=String(Math.max(0,1-y/(vh*.9)));
      }
      const r=crew.parentElement.getBoundingClientRect();
      if(r.bottom>0&&r.top<vh){const p=(r.top+r.height/2-vh/2)/vh;crew.style.transform=`translateY(${p*-52}px)`}
      document.querySelectorAll('.era .strip').forEach((s,i)=>{
        const er=s.getBoundingClientRect();
        if(er.bottom>0&&er.top<vh){const ep=(er.top+er.height/2-vh/2)/vh;s.style.translate=`${(ep*(i%2?36:-36)).toFixed(1)}px 0`}
      });
      tick=false;
    });
  },{passive:true});
}

const mag=document.querySelector('.magnetic');
if(mag&&matchMedia('(pointer:fine)').matches){
  let raf;const st={x:0,y:0,tx:0,ty:0};
  mag.addEventListener('mousemove',e=>{const r=mag.getBoundingClientRect();st.tx=(e.clientX-r.left-r.width/2)*.32;st.ty=(e.clientY-r.top-r.height/2)*.32;loop()});
  mag.addEventListener('mouseleave',()=>{st.tx=0;st.ty=0;loop()});
  function loop(){cancelAnimationFrame(raf);(function step(){st.x+=(st.tx-st.x)*.16;st.y+=(st.ty-st.y)*.16;mag.style.transform=`translate(${st.x}px,${st.y}px)`;if(Math.abs(st.tx-st.x)>.2||Math.abs(st.ty-st.y)>.2)raf=requestAnimationFrame(step)})()}
}
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});document.getElementById('clock').textContent='LA '+t}
clock();setInterval(clock,30000);

// career timeline scrub
(function(){
  const sec=document.querySelector('.tl'),track=document.getElementById('tlTrack'),
        word=document.getElementById('eraWord'),no=document.getElementById('eraNo'),
        fill=document.getElementById('tlFill'),nodes=[...document.querySelectorAll('.tl-rail .node')];
  if(!sec||!track)return;
  const eras=[...track.children];let cur=-1;
  function setEra(i){
    if(i===cur)return;cur=i;
    word.textContent=eras[i].dataset.word;
    word.classList.remove('swap');void word.offsetWidth;word.classList.add('swap');
    no.textContent=String(i+1).padStart(2,'0');
    nodes.forEach((n,j)=>n.classList.toggle('hit',j<=i));
  }
  setEra(0);
  if(matchMedia('(prefers-reduced-motion:reduce)').matches||innerWidth<=900)return;
  let k=false;
  addEventListener('scroll',()=>{
    if(k)return;k=true;
    requestAnimationFrame(()=>{
      const vh=innerHeight,r=sec.getBoundingClientRect();
      const total=r.height-vh;
      const p=Math.min(1,Math.max(0,-r.top/total));
      const max=track.scrollWidth-innerWidth+innerWidth*0.06;
      track.style.transform=`translateX(${-p*max}px)`;
      fill.style.width=(p*100)+'%';
      setEra(Math.min(eras.length-1,Math.floor(p*eras.length)));
      k=false;
    });
  },{passive:true});
})();


// footer under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  if(!uf||!over)return;
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
// spark companion: drifts + rotates with scroll
(function(){
  const c=document.querySelector('.companion');
  if(!c||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let cTick=false;
  addEventListener('scroll',()=>{
    if(cTick)return;cTick=true;
    requestAnimationFrame(()=>{
      c.style.transform=`translateY(${(Math.sin(scrollY/420)*34).toFixed(1)}px) rotate(${(scrollY*0.22).toFixed(1)}deg)`;
      cTick=false;
    });
  },{passive:true});
})();
// split-line rise
(function(){
  const els=document.querySelectorAll('[data-split]');
  if(!els.length)return;
  els.forEach(el=>{
    el.innerHTML=el.innerHTML.split(/<br\s*\/?>/i).map(l=>`<span class="sl"><span>${l}</span></span>`).join('');
  });
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.2});
  els.forEach(el=>io.observe(el));
})();


// scroll-lit rows: light up as they cross the center band
(function(){
  const rows=document.querySelectorAll('.litrow');
  if(!rows.length)return;
  const io=new IntersectionObserver(es=>es.forEach(e=>e.target.classList.toggle('lit',e.isIntersecting)),
    {rootMargin:'-32% 0px -32% 0px'});
  rows.forEach(r=>io.observe(r));
})();

</script>
<script is:inline>
// footer dock: mirror the corner descriptor + LA clock into the footer, and fade the
// floating pair once the visitor is truly at the bottom, so the page-end reads intentional.
(function(){
  var c3=document.querySelector('.corners .c3'),foot=document.querySelector('footer');
  if(!foot||!c3)return;
  var dock=document.createElement('div');dock.className='foot-dock';
  var d=document.createElement('span');d.className='fd-desc';d.textContent=c3.textContent.trim();
  var k=document.createElement('span');k.className='fd-clock';
  dock.appendChild(d);dock.appendChild(k);foot.insertBefore(dock,foot.firstChild);
  function tick(){var t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});k.textContent='LA '+t;}
  tick();setInterval(tick,30000);
  function atBottom(){return window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-4;}
  function upd(){document.body.classList.toggle('at-foot',atBottom());}
  addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd,{passive:true});setTimeout(upd,400);
})();
</script>
