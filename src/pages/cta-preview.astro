---
// TEMP preview — delete after DJ signs off on the unified CTA.
import CircledCTA from '../components/CircledCTA.astro';
---
<html>
<head>
<meta charset="utf-8" />
<meta name="robots" content="noindex" />
<title>CTA preview</title>
<style>
  :root{
    --ink:#201e1d; --paper:#F5F3EF; --mono:'Space Mono',ui-monospace,monospace;
    --disp:'Inter',sans-serif; --dispw:800; --serif:'Fraunces',serif; --red:#E0311A;
  }
  *{box-sizing:border-box;margin:0}
  body{font-family:var(--disp)}
  .band{padding:9vh clamp(24px,6vw,64px)}
  .dark{background:var(--ink);color:var(--paper)}
  .light{background:var(--paper);color:var(--ink)}
  .tag{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:.6;margin-bottom:26px;display:block}
  .kick{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--red);display:block;margin-bottom:18px}
  .big{font-weight:800;font-size:clamp(30px,5vw,60px);line-height:1;letter-spacing:-.03em;text-transform:uppercase;max-width:16ch;margin-bottom:40px}
  .big .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
  .row{display:flex;gap:40px;align-items:center;flex-wrap:wrap;margin-top:20px}
  /* current drift, for contrast */
  .pill{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding:15px 28px;border-radius:99px;background:var(--paper);color:var(--ink)}
  .talk{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;border:1.5px solid rgba(245,243,239,.75);padding:16px 26px;border-radius:50%}
  .mail{font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;border:1px solid rgba(245,243,239,.4);padding:14px 26px;border-radius:99px}
  .lbl{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;opacity:.5;display:block;margin-bottom:10px}
</style>
</head>
<body>
  <!-- THE ONE — dark ground -->
  <section class="band dark">
    <span class="tag">The one CTA · dark band · paper oval</span>
    <span class="kick">✳ Being forgettable is expensive</span>
    <div class="big">Let's build something<br><span class="serif">worth remembering.</span></div>
    <CircledCTA tone="dark" />
  </section>

  <!-- THE ONE — light ground, BLACK oval -->
  <section class="band light">
    <span class="tag">The one CTA · light band · BLACK oval (your note)</span>
    <span class="kick">✳ Being forgettable is expensive</span>
    <div class="big">Let's build something<br><span class="serif">worth remembering.</span></div>
    <CircledCTA tone="light" />
  </section>

  <!-- the drift being replaced -->
  <section class="band dark">
    <span class="tag">↓ what it replaces (the drift, all shipping today)</span>
    <div class="row">
      <div><span class="lbl">index / work / about / giving / capabilities</span><a class="pill" href="#">Let's talk ↗</a></div>
      <div><span class="lbl">photography</span><a class="talk" href="#">Let's talk ↗</a></div>
      <div><span class="lbl">ai</span><a class="mail" href="#">Let's talk ↗</a></div>
    </div>
  </section>
</body>
</html>
