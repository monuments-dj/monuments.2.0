<script is:inline>
// gallery: 9 real frames, wide frame every 4th
(function(){
  const imgs=['xperia-01','xm4-01','xperia-02','xm3-bts','yt-thismoment','stansport-01','podcast-cover'].map(n=>`/case-studies/art-of-visuals/gallery/${n}.jpg`);
  const el=document.getElementById('frames');
  el.innerHTML=imgs.map((src,i)=>`
    <figure class="fr${i%4===0?' wide':''}" style="--d:${i*45}ms">
      <img src="${src}" alt="Art of Visuals frame ${i+1}" loading="lazy">
      <figcaption class="cap">FR-${String(i+1).padStart(2,'0')} · AOV ARCHIVE</figcaption>
    </figure>`).join('');
  new IntersectionObserver((es,o)=>{es.forEach(e=>{if(e.isIntersecting){el.classList.add('show');o.disconnect()}})},{threshold:.05,rootMargin:'0px 0px 100px 0px'}).observe(el);
})();

// MSI BTS sheet: same .show reveal, static markup
(function(){
  const el=document.getElementById('msiFrames');if(!el)return;
  new IntersectionObserver((es,o)=>{es.forEach(e=>{if(e.isIntersecting){el.classList.add('show');o.disconnect()}})},{threshold:.05,rootMargin:'0px 0px 100px 0px'}).observe(el);
})();

// header loop: fade in only on the real playing state (no blind timers)
(function(){
  const v=document.querySelector('.hero-loop');if(!v)return;
  if(matchMedia('(prefers-reduced-motion:reduce)').matches){v.remove();return;}
  v.addEventListener('playing',()=>v.classList.add('live'),{once:true});
})();

const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// hero layers + break parallax + companion
(function(){
  const hImg=document.querySelector('.hero>img'),hT=document.querySelector('.hero .t'),
        nfo=document.querySelector('.hero .nfo'),kck=document.querySelector('.hero .kck'),
        brk=document.querySelectorAll('.break img'),c=document.querySelector('.companion');
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let k=false;
  addEventListener('scroll',()=>{
    if(k)return;k=true;
    requestAnimationFrame(()=>{
      const y=scrollY,vh=innerHeight;
      if(y<vh&&hImg&&hT){
        hImg.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        const hVid=document.querySelector('.hero-loop');
        if(hVid)hVid.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        hT.style.transform=`translate(-50%,-50%) translateY(${y*-.1}px)`;
        hT.style.opacity=String(Math.max(0,1-y/(vh*.9)));
        if(nfo)nfo.style.transform=`translateY(${y*-.16}px)`;
        if(kck)kck.style.transform=`translateY(${y*-.06}px)`;
      }
      brk.forEach(b=>{const r=b.parentElement.getBoundingClientRect();if(r.bottom>0&&r.top<vh){const p=(r.top+r.height/2-vh/2)/vh;b.style.transform=`translateY(${p*-56}px)`}});
      if(c)c.style.transform=`translateY(${(Math.sin(y/420)*34).toFixed(1)}px) rotate(${(y*0.22).toFixed(1)}deg)`;
      k=false;
    });
  },{passive:true});
})();

// under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});document.getElementById('clock').textContent='LA '+t}
clock();setInterval(clock,30000);
// film lightbox: generalized - the film block AND the To the Point episodes
// each open their own id in the same reelbox
(function(){
  const REEL='VMubUUZ2tdU';
  const sec=document.querySelector('.film');
  const filmVid=(sec&&sec.dataset.video)||REEL;
  const box=document.getElementById('reelbox'),mount=document.getElementById('reelMount');
  function open(vid){
    mount.innerHTML=`<iframe src="https://www.youtube.com/embed/${vid}?autoplay=1&rel=0&modestbranding=1" allow="autoplay; encrypted-media; fullscreen" allowfullscreen title="Campaign film"></iframe>`;
    box.classList.add('on');document.body.style.overflow='hidden';
  }
  function close(){box.classList.remove('on');mount.innerHTML='';document.body.style.overflow=''}
  document.getElementById('filmPoster').addEventListener('click',()=>open(filmVid));
  document.querySelectorAll('.ttp-ep[data-yt]').forEach(ep=>{
    ep.addEventListener('click',()=>open(ep.dataset.yt));
  });
  document.getElementById('reelClose').addEventListener('click',close);
  box.addEventListener('click',e=>{if(e.target===box)close()});
  addEventListener('keydown',e=>{if(e.key==='Escape')close()});
})();
</script>
<script is:inline>
// at-foot: mark when the visitor reaches the very bottom (the pinned descriptor + clock
// stay put; the rest of the footer meta settles into one centered line beneath them).
(function(){
  function atBottom(){return window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-4;}
  function upd(){document.body.classList.toggle('at-foot',atBottom());}
  addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd,{passive:true});setTimeout(upd,400);
})();
</script>
