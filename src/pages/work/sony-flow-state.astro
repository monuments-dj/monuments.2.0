const fsComments = [
  { u: 'jayrmcdonald', t: 'THUE ABSOLUTELY SLAYS 😍😍😍 10/10!! Also need to try these headphones! Need the noise cancelling for flying 🙌', l: 4 },
  { u: 'morgylove', t: 'The sheer amount of talent on the AOV team is insane. Killer work!', l: 1 },
