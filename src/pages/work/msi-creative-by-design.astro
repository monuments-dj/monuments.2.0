---
import CallSheet from '../../components/CallSheet.astro';
import NextFile from '../../components/NextFile.astro';
import StatRow from '../../components/StatRow.astro';
import PageFooter from '../../components/PageFooter.astro';
import RoleTag from '../../components/RoleTag.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import MasonryGallery from '../../components/MasonryGallery.astro';
import '../../styles/work.css';
import { work } from '../../data/work.js';
// MSI · Creative by Design (intake/msi-creative-by-design.md, DJ 2026-07-12).
// Cutdowns section BUILT 2026-07-12 from DJ's share link: the ultra-wide 1928x558
// Times Square boards + standard 16:9 cuts, self-hosted, tap for sound.
const hh = work.find(w => w.slug === 'msi-creative-by-design');
const gallery = Array.from({ length: 13 }, (_, i) => ({
  src: `/case-studies/art-of-visuals/msi/msi-${String(i + 1).padStart(2, '0')}.jpg`,
  cap: 'MSI · LOS ANGELES',
  alt: `MSI Creative by Design BTS frame ${i + 1}`
}));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>MSI · Creative by Design · Monuments</title>
  <!-- og:begin · generated by tools/add-og.mjs · re-run after domain swap -->
  <meta name="description" content="Case study from the creative portfolio of DJ Ramirez, Creative Director.">
  <link rel="canonical" href="https://monuments-2-0.vercel.app/work/msi-creative-by-design">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Monuments">
  <meta property="og:title" content="MSI · Creative by Design · Monuments">
  <meta property="og:description" content="Case study from the creative portfolio of DJ Ramirez, Creative Director.">
  <meta property="og:url" content="https://monuments-2-0.vercel.app/work/msi-creative-by-design">
  <meta property="og:image" content="https://monuments-2-0.vercel.app/og/card.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://monuments-2-0.vercel.app/og/card.jpg">
  <!-- og:end -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Fragment+Mono:ital@0;1&family=Instrument+Serif:ital@0;1&family=Pirata+One&display=swap" rel="stylesheet">
<style is:global>
:root{
  --ink:#161514; --paper:#F5F3EF; --rose:#EFA1AD; --cobalt:#2438E8; --red:#E0311A;
  --dim:#8f8d88; --line:#dcd9d2; --lined:#2c2b29;
  --wrap:1380px; --pad:clamp(22px,4.6vw,44px);
  --disp:'Bricolage Grotesque',sans-serif; --dispw:800; --dispw2:600;
  --mono:'Fragment Mono',monospace;
  --spark:var(--red); --struct:var(--rose); --on-rgb:22,21,20;
}
*{margin:0;box-sizing:border-box}
body{background:var(--ink);color:var(--paper);font-family:var(--body,var(--disp));font-size:17px;line-height:1.6;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}

@keyframes spin{to{transform:rotate(360deg)}}
@media (max-width:900px),(prefers-reduced-motion:reduce){.companion{display:none}}

/* hero: BTS frame from the LA shoot carries the page */
.hero{position:relative;height:78svh;min-height:560px;overflow:hidden;background:var(--ink)}
.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:contrast(1.03) brightness(0.52)}
.hero .scrim{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 44%,rgba(22,21,20,.5),rgba(22,21,20,.16) 58%,rgba(22,21,20,.46))}
.hero .t{z-index:72;position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);width:104%;text-align:center;color:var(--paper);font-weight:var(--dispw);font-size:clamp(40px,7.4vw,98px);line-height:.92;letter-spacing:-.035em;text-transform:uppercase}
@media(max-width:640px){.hero .t{width:100%}}
.hero .t .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:-.01em}
.hero .t .spark{color:var(--spark)}
.hero .t .ln{display:block;overflow:hidden;padding-bottom:.18em;margin-bottom:-.18em}
.hero .t .ln>span{display:block;transform:translateY(125%);animation:rise 1s cubic-bezier(.22,1,.36,1) forwards}
.hero .t .ln:nth-child(2)>span{animation-delay:.12s}
@keyframes rise{to{transform:translateY(0)}}
.hero .nfo{z-index:72;position:absolute;right:var(--pad);bottom:11vh;text-align:left;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;line-height:1.9;color:var(--paper);opacity:0;animation:fade 1s .8s forwards}
.hero .nfo .h{color:var(--ink);background:var(--paper);padding:1px 7px;display:inline-block;margin-bottom:8px}
.hero .kck{z-index:72;position:absolute;left:var(--pad);bottom:11vh;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--paper);opacity:0;animation:fade 1s .7s forwards;line-height:1.9}
.hero .kck b{color:var(--spark);font-weight:400}
@keyframes fade{to{opacity:1}}


@media (max-width:900px){.story{grid-template-columns:1fr}}

/* the cutdowns: ultra-wide Times Square boards + standard cuts */
.cuts{background:var(--ink);color:var(--paper);padding:2vh 0 10vh}
.cuts .bar{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;padding-bottom:14px;border-bottom:1px solid var(--lined);margin-bottom:26px}
.cuts .bar .mono b{color:var(--spark)}
.cuts .cutsdim{color:#8f8d88}
.cutslead{color:#b5b2ac;font-size:clamp(15px,1.3vw,18px);line-height:1.6;max-width:66ch;margin-bottom:5vh}
.tsboards{display:flex;flex-direction:column;gap:20px;margin-bottom:26px}
.tsb{margin:0;position:relative;border:1px solid var(--lined);background:#000}
.tsb video{width:100%;aspect-ratio:1928/558;object-fit:cover;display:block}
.tsb figcaption{position:absolute;left:14px;bottom:12px;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(245,243,239,.9);background:rgba(22,21,20,.5);padding:5px 10px;backdrop-filter:blur(3px)}
.cutrow{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.cutcard{position:relative;border:0;padding:0;background:#000;cursor:pointer;display:block;width:100%;overflow:hidden;border-radius:8px}
.cutcard video{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.cutcard::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(22,21,20,.5),transparent 40%);pointer-events:none}
.cutcard .cut-chip{position:absolute;top:12px;right:12px;z-index:2;color:var(--paper);font-size:9px;letter-spacing:.12em;text-transform:uppercase;border:1px solid rgba(245,243,239,.55);border-radius:99px;padding:5px 11px;background:rgba(22,21,20,.4);backdrop-filter:blur(4px);transition:background .3s,color .3s}
.cutcard:hover .cut-chip,.cutcard.loud .cut-chip{background:var(--paper);color:var(--ink)}
.cutcard .cut-cap{position:absolute;left:12px;bottom:10px;z-index:2;color:var(--paper);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase}
@media (max-width:760px){.cutrow{grid-template-columns:1fr;max-width:440px;margin:0 auto}}

@media (max-width:900px){.frames{columns:2}}
@media (max-width:560px){.frames{columns:1}}

.quote .wrap{padding:11vh var(--pad)}
.quote .q{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-size:clamp(24px,3vw,42px);line-height:1.25;letter-spacing:-.01em;max-width:30ch}
.quote .q b{font-family:var(--disp);font-weight:var(--dispw);font-style:normal}


@media (max-width:680px){
  .corners .c2,.corners .c3,.corners .c4{display:none}
  .corners .c1 b{font-size:23px}
  .hero .t{font-size:clamp(34px,9.4vw,52px)}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  .hero .t .ln>span{transform:none}.hero .nfo,.hero .kck{opacity:1}.rv{opacity:1;transform:none}
  .frames .fr{opacity:1;transform:none}
}
</style>
</head>
<body>
<div class="companion" aria-hidden="true">✳</div>

<div class="corners">
  <span class="c1"><a href="/"><b>M<i>✳</i>NUMENTS</b></a></span>
  <span class="c2"><a href="/work">Work</a><a href="/photography">Photo</a><a href="/about">About</a><a href="/capabilities">Capabilities</a><a href="/contact">Contact</a></span>
  <span class="c3">MC-2022-10 · MSI · Creative by Design</span>
  <span class="c4" id="clock">LA --:--</span>
</div>

<div class="over">
<HeroHeader hLead={hh.hLead} hName={hh.hName} logline={hh.logline} role={hh.role} img="/case-studies/art-of-visuals/msi/msi-06.jpg" logo={hh.logo} logoColor={hh.logoColor} logoText={hh.logoText} brand={hh.brand} client={hh.client} />

<StatRow tone="paper"
  stats={[{ value: '3 weeks', label: 'concept to launch' }, { value: 'Times Square', label: 'digital boards + bus stations' }, { value: '60/30/15/6', label: 'second cutdowns' }, { value: '3', label: 'creative careers, one film' }]}
/>

<section class="paper">
  <div class="wrap story">
    <div class="side rv">
      <span class="k mono">\ The brief</span>
      <h2>A new kind of laptop, launched to the <span class="serif">loudest block in America.</span></h2>
    </div>
    <div class="body rv">
      <p>MSI built a laptop specifically for creators. We launched it on Times Square digital boards and the surrounding bus stations, Oct through Nov '22, cut into 60, 30, 15, and 6 second ads and distributed on the Art of Visuals Instagram and podcast.</p>
      <p>The challenge: competing for attention in an environment as crowded as Times Square while still showing real product features, for three target demographics with very different goals and use-cases.</p>
      <p>The solve: eye-catching motion graphics that grab attention fast, and three different creative careers highlighted in the film, maximizing the output and the placement options. Concept to launch in three weeks.</p>
    </div>
  </div>
</section>

<!-- The cutdowns (DJ 2026-07-12): the real MSI films. Lead with the ultra-wide
     1928x558 Times Square billboard sizing (the "weird" OOH format), then the
     standard cuts. Billboards loop muted (OOH = silent); cuts tap for sound. -->
<section class="cuts">
  <div class="wrap">
    <div class="bar">
      <span class="mono"><b>\ The cutdowns</b> · one film, every format</span>
      <span class="mono cutsdim">60 / 30 / 15 / 6s · Times Square boards + social</span>
    </div>
    <p class="cutslead">The same film, cut for wherever it ran. Up top: the Times Square boards, a 1928&times;558 sliver you have to design for on purpose. Below: the standard cuts that carried it to the AOV feed.</p>
    <div class="tsboards">
      <figure class="tsb">
        <video src="/case-studies/art-of-visuals/msi/cutdowns/ts-male-desk.mp4" poster="/case-studies/art-of-visuals/msi/cutdowns/ts-male-desk.jpg" autoplay muted loop playsinline preload="none" aria-label="MSI Times Square billboard cut, 1928x558"></video>
        <figcaption class="mono">TS-01 · 1928&times;558 · Times Square board</figcaption>
      </figure>
      <figure class="tsb">
        <video src="/case-studies/art-of-visuals/msi/cutdowns/ts-female-car.mp4" poster="/case-studies/art-of-visuals/msi/cutdowns/ts-female-car.jpg" autoplay muted loop playsinline preload="none" aria-label="MSI Times Square billboard cut, 1928x558"></video>
        <figcaption class="mono">TS-02 · 1928&times;558 · Times Square board</figcaption>
      </figure>
    </div>
    <div class="cutrow">
      <button class="cutcard" type="button" aria-label="Play with sound: MSI product cut">
        <video src="/case-studies/art-of-visuals/msi/cutdowns/cut-product-10.mp4" poster="/case-studies/art-of-visuals/msi/cutdowns/cut-product-10.jpg" autoplay muted loop playsinline preload="none"></video>
        <span class="cut-chip mono">Sound ↗</span>
        <span class="cut-cap mono">10s · Product</span>
      </button>
      <button class="cutcard" type="button" aria-label="Play with sound: MSI car cut">
        <video src="/case-studies/art-of-visuals/msi/cutdowns/cut-car-10.mp4" poster="/case-studies/art-of-visuals/msi/cutdowns/cut-car-10.jpg" autoplay muted loop playsinline preload="none"></video>
        <span class="cut-chip mono">Sound ↗</span>
        <span class="cut-cap mono">10s · The drive</span>
      </button>
      <button class="cutcard" type="button" aria-label="Play with sound: MSI couch cut">
        <video src="/case-studies/art-of-visuals/msi/cutdowns/cut-couch-15.mp4" poster="/case-studies/art-of-visuals/msi/cutdowns/cut-couch-15.jpg" autoplay muted loop playsinline preload="none"></video>
        <span class="cut-chip mono">Sound ↗</span>
        <span class="cut-cap mono">15s · At home</span>
      </button>
    </div>
  </div>
</section>

<section class="paper">
  <MasonryGallery title="\ On set · Los Angeles" note="13 frames · click to enlarge" images={gallery} />
</section>

<section class="quote">
  <div class="wrap">
    <p class="q rv">"Three demographics, one machine, three weeks. The format did the targeting so <b>the film could do the selling.</b>"</p>
    <p class="who mono rv">The campaign in one line</p>
  </div>
</section>

<section class="paper">
  <div class="wrap credits rv">
    <CallSheet
      code="MC-2022-10"
      sub="MSI · Creative by Design · Times Square OOH"
      filed="MMXXII"
      tone="light"
      rows={[
        { k: 'Client', v: 'MSI' },
        { k: 'Agency', v: 'Art of Visuals' },
        { k: 'Creative Direction', v: 'DJ Ramirez', select: true },
      ]}
    />
  </div>
</section>
</div><!--/over-->

<div class="underfoot">
<NextFile
  href="/work/sony-this-moment"
  name="Sony This Moment"
  img="/case-studies/sony-this-moment/gallery/tm-05.jpg"
  code="MC-2023-06"
/>
<PageFooter tag="Case: MSI · Creative by Design" />
</div><!--/underfoot-->

<script is:inline>
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// hero parallax + companion
(function(){
  const hImg=document.querySelector('.hero>img'),hT=document.querySelector('.hero .t'),
        nfo=document.querySelector('.hero .nfo'),kck=document.querySelector('.hero .kck'),
        c=document.querySelector('.companion');
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let k=false;
  addEventListener('scroll',()=>{
    if(k)return;k=true;
    requestAnimationFrame(()=>{
      const y=scrollY,vh=innerHeight;
      if(y<vh&&hImg&&hT){
        hImg.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        hT.style.transform=`translate(-50%,-50%) translateY(${y*-.1}px)`;
        hT.style.opacity=String(Math.max(0,1-y/(vh*.9)));
        if(nfo)nfo.style.transform=`translateY(${y*-.16}px)`;
        if(kck)kck.style.transform=`translateY(${y*-.06}px)`;
      }
      if(c)c.style.transform=`translateY(${(Math.sin(y/420)*34).toFixed(1)}px) rotate(${(y*0.22).toFixed(1)}deg)`;
      k=false;
    });
  },{passive:true});
})();

// under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});document.getElementById('clock').textContent='LA '+t}
clock();setInterval(clock,30000);

// cutdowns: tap a standard cut for sound, one loud at a time
(function(){
  var cards=[].slice.call(document.querySelectorAll('.cutcard'));
  function quiet(c){var v=c.querySelector('video');v.muted=true;c.classList.remove('loud');c.querySelector('.cut-chip').textContent='Sound ↗';}
  cards.forEach(function(c){
    c.addEventListener('click',function(){
      var v=c.querySelector('video'),wasMuted=v.muted;
      cards.forEach(quiet);
      if(wasMuted){v.muted=false;v.play().catch(function(){});c.classList.add('loud');c.querySelector('.cut-chip').textContent='Mute ✕';}
    });
  });
})();
</script>
</body>
</html>
