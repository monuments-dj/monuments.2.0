  { src: '/case-studies/clothing-merch/gallery/cm-05.jpg', cap: 'Creative Space · Crewneck', alt: 'Apparel design: Creative Space · Crewneck' },
  { src: '/case-studies/clothing-merch/gallery/cm-06.jpg', cap: 'Patches · The set', alt: 'Apparel design: Patches · The set' },
  { src: '/case-studies/clothing-merch/gallery/cm-07.jpg', cap: 'Patches · New here', alt: 'Apparel design: Patches · New here' },
  { src: '/case-studies/clothing-merch/gallery/cm-08.jpg', cap: 'Creative Space · Tee front', alt: 'Apparel design: Creative Space · Tee front' },
  { src: '/case-studies/clothing-merch/gallery/cm-09.jpg', cap: 'Creative Space · Tee back', alt: 'Apparel design: Creative Space · Tee back' },
  { src: '/case-studies/clothing-merch/gallery/cm-10.jpg', cap: 'Patch · Creator', alt: 'Apparel design: Patch · Creator' },
