<script is:inline>
// gallery: all 26 frames from the v1 page, masonry columns, line captions
(function(){
  const shots=[
    ['cm-01.jpg','Creative Space · Hoodie back',1228,1600],
    ['cm-02.jpg','Line sheet · Hats',1600,903],
    ['cm-03.jpg','Creative Space · Hoodie',1411,1600],
    ['cm-04.jpg','NYC cap · Corduroy',1225,1600],
    ['cm-05.jpg','Creative Space · Crewneck',1004,1600],
    ['cm-06.jpg','Patches · The set',1134,1600],
    ['cm-07.jpg','Patches · New here',1121,1600],
    ['cm-08.jpg','Creative Space · Tee front',1171,1600],
    ['cm-09.jpg','Creative Space · Tee back',1146,1600],
    ['cm-10.jpg','Patch · Creator',1600,566],
    ['cm-11.jpg','Patch · Storyteller',1600,571],
    ['cm-12.jpg','Patch · Human',1600,603],
    ['cm-13.jpg','Line sheet · The marks',1600,875],
    ['cm-14.jpg','Line sheet · Hoodies',1600,905],
    ['cm-15.jpg','Line sheet · Tees',1600,897],
    ['cm-16.jpg','Line sheet · Tote',1600,881],
    ['cm-17.jpg','Line sheet · Patches',1600,873],
    ['cm-18.jpg','Creative Space · On model',1208,1600],
    ['cm-19.jpg','NYC tee · On model',1114,1600],
    ['cm-20.jpg','NYC cap · In hand',1131,1600],
    ['cm-21.jpg','NYC cap · Back',498,509],
    ['cm-22.jpg','Line sheet · Crewneck',2000,1124],
    ['cm-23.jpg','Line sheet · Crewneck back',2000,1121],
    ['cm-24.jpg','DW Drums · Tee',2000,1245],
    ['cm-25.jpg','DW Drums · Snapback',2000,1162],
    ['cm-26.jpg','DW Drums · Tote',2000,1802],
    ['cm-27.jpg','Art of Visuals · Crew windbreaker',1528,1600],
    ['cm-28.jpg','Art of Visuals · Anorak',1562,1600],
    ['cm-29.jpg','Art of Visuals · Crop long sleeve',1588,1600],
    ['cm-30.jpg','Art of Visuals · Crew crop, back',1580,1600],
    ['cm-31.jpg','Art of Visuals · Tote, tan',1565,1600],
    ['cm-32.jpg','Art of Visuals · Tote, black mark',1588,1600],
    ['cm-33.jpg','Art of Visuals · Tote, yellow',1600,1493],
    ['cm-34.jpg','Creative Space · Mug',1568,1600]
  ];
  const el=document.getElementById('frames');
  el.innerHTML=shots.map((s,i)=>`
    <figure class="fr" style="--d:${i*45}ms">
      <img src="/case-studies/clothing-merch/gallery/${s[0]}" alt="Apparel design: ${s[1]}" width="${s[2]}" height="${s[3]}" loading="lazy">
      <figcaption class="cap">FR-${String(i+1).padStart(2,'0')} · ${s[1]}</figcaption>
    </figure>`).join('');
  new IntersectionObserver((es,o)=>{es.forEach(e=>{if(e.isIntersecting){el.classList.add('show');o.disconnect()}})},{threshold:.05,rootMargin:'0px 0px 100px 0px'}).observe(el);
})();

const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// hero layers + break parallax + companion
(function(){
  const hImg=document.querySelector('.hero>video, .hero>img'),hT=document.querySelector('.hero .t'),
        nfo=document.querySelector('.hero .nfo'),kck=document.querySelector('.hero .kck'),
        brk=document.querySelectorAll('.break img'),c=document.querySelector('.companion');
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let k=false;
  addEventListener('scroll',()=>{
    if(k)return;k=true;
    requestAnimationFrame(()=>{
      const y=scrollY,vh=innerHeight;
      if(y<vh){
        if(hImg)hImg.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        if(hT){hT.style.transform=`translate(-50%,-50%) translateY(${y*-.1}px)`;
        hT.style.opacity=String(Math.max(0,1-y/(vh*.9)));}
        if(nfo)nfo.style.transform=`translateY(${y*-.16}px)`;
        if(kck)kck.style.transform=`translateY(${y*-.06}px)`;
      }
      brk.forEach(b=>{const r=b.parentElement.getBoundingClientRect();if(r.bottom>0&&r.top<vh){const p=(r.top+r.height/2-vh/2)/vh;b.style.transform=`translateY(${p*-56}px)`}});
      if(c)c.style.transform=`translateY(${(Math.sin(y/420)*34).toFixed(1)}px) rotate(${(y*0.22).toFixed(1)}deg)`;
      k=false;
    });
  },{passive:true});
})();

// under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});document.getElementById('clock').textContent='LA '+t}
clock();setInterval(clock,30000);
</script>
<script is:inline async src="https://www.instagram.com/embed.js"></script>
<script is:inline>
// at-foot: mark when the visitor reaches the very bottom (the pinned descriptor + clock
// stay put; the rest of the footer meta settles into one centered line beneath them).
(function(){
  function atBottom(){return window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-4;}
  function upd(){document.body.classList.toggle('at-foot',atBottom());}
  addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd,{passive:true});setTimeout(upd,400);
})();
</script>
</body>
</html>
