// === Clothing & Merch · THE CUT case page ===
// Words ported verbatim from the v1 page (monuments.cc/portfolio/clothing-merch rebuild).
// cm-01..20: Creative Space apparel line. cm-21..23: cap detail + tee line sheets.
// cm-24..26: DW drummers collection (tee, cap, tote).
// The two Instagram reels are embedded inline (IG /embed/ iframes, play without leaving).
import PageFooter from '../../components/PageFooter.astro';
import RoleTag from '../../components/RoleTag.astro';
import HeroHeader from '../../components/HeroHeader.astro';
import StatRow from '../../components/StatRow.astro';
import MasonryGallery from '../../components/MasonryGallery.astro';
import { work } from '../../data/work.js';
import '../../styles/work.css';
const hh = work.find(w => w.slug === 'clothing-merch');
const gallery = [
