<script is:inline>
// contact sheet: the FULL 38-frame roll. 15 curated selects up front, the other 23
// develop on demand (appended on click so the lazy images never load until asked for).
(function(){
  var G='/case-studies/adorama-music/gallery/';
  // [file, w, h, caption] - portraits 33-35 break the 3:2 rhythm on purpose
  var selects=[
    ['am-02.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-04.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-05.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-06.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-10.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-33.jpg',1366,2048,'#CreateNoMatterWhat'],
    ['am-11.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-12.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-34.jpg',1366,2048,'#CreateNoMatterWhat'],
    ['am-14.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-15.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-35.jpg',1366,2048,'#CreateNoMatterWhat'],
    ['am-16.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-17.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-19.jpg',2048,1366,'#CreateNoMatterWhat']
  ];
  var roll=[
    ['am-18.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-20.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-21.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-22.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-23.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-24.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-25.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-26.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-27.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-28.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-29.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-30.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-31.jpg',2048,1366,'Rehearsal · Mid-hit'],
    ['am-32.jpg',2048,1366,'#CreateNoMatterWhat'],
    ['am-01.jpg',2048,1366,'Studio · Piano takes'],
    ['am-03.jpg',2048,1366,'Garage · First songs'],
    ['am-07.jpg',2048,1366,'Stage · The rig'],
    ['am-08.jpg',2048,1366,'Studio · Behind the kit'],
    ['am-09.jpg',2048,1366,'Stage · Facing the lights'],
    ['am-13.jpg',2048,1366,'Stage · Lights up'],
    ['am-36.jpg',800,534,'On set · Behind the film'],
    ['am-37.jpg',1024,683,'On set · Behind the film'],
    ['am-38.jpg',800,534,'On set · Behind the film']
  ];
  var el=document.getElementById('frames');
  function frame(s,i){
    return '<figure class="fr" style="--d:'+(i%15)*45+'ms">'
      +'<img src="'+G+s[0]+'" alt="Adorama Music: The Journey, '+s[3]+'" width="'+s[1]+'" height="'+s[2]+'" loading="lazy">'
      +'<figcaption class="cap">FR-'+String(i+1).padStart(2,'0')+' · '+s[3]+'</figcaption></figure>';
  }
  el.innerHTML=selects.map(frame).join('');
  new IntersectionObserver(function(es,o){es.forEach(function(e){if(e.isIntersecting){el.classList.add('show');o.disconnect()}})},{threshold:.05,rootMargin:'0px 0px 100px 0px'}).observe(el);

  var btn=document.getElementById('developBtn');
  btn.addEventListener('click',function(){
    var t=document.createElement('template');
    t.innerHTML=roll.map(function(s,i){return frame(s,i+selects.length)}).join('');
    var frs=Array.prototype.slice.call(t.content.querySelectorAll('.fr'));
    frs.forEach(function(f,i){f.classList.add('pre');f.style.setProperty('--d',(i%12)*40+'ms')});
    el.appendChild(t.content);
    el.classList.add('show');
    void el.offsetHeight; // commit the .pre state before releasing it
    requestAnimationFrame(function(){frs.forEach(function(f){f.classList.remove('pre')})});
    btn.parentElement.remove();
    var c=document.getElementById('galCount');
    if(c)c.textContent='Full roll · 38 frames';
  },{once:true});
})();

const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// hero layers + break parallax + companion
(function(){
  const hImg=document.querySelector('.hero>img'),hT=document.querySelector('.hero .t'),
        nfo=document.querySelector('.hero .nfo'),kck=document.querySelector('.hero .kck'),
        brk=document.querySelector('.break img'),c=document.querySelector('.companion');
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let k=false;
  addEventListener('scroll',()=>{
    if(k)return;k=true;
    requestAnimationFrame(()=>{
      const y=scrollY,vh=innerHeight;
      if(y<vh){
        hImg.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        hT.style.transform=`translate(-50%,-50%) translateY(${y*-.1}px)`;
        hT.style.opacity=String(Math.max(0,1-y/(vh*.9)));
        if(nfo)nfo.style.transform=`translateY(${y*-.16}px)`;
        if(kck)kck.style.transform=`translateY(${y*-.06}px)`;
      }
      const r=brk.parentElement.getBoundingClientRect();
      if(r.bottom>0&&r.top<vh){const p=(r.top+r.height/2-vh/2)/vh;brk.style.transform=`translateY(${p*-56}px)`}
      if(c)c.style.transform=`translateY(${(Math.sin(y/420)*34).toFixed(1)}px) rotate(${(y*0.22).toFixed(1)}deg)`;
      k=false;
    });
  },{passive:true});
})();

// under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});document.getElementById('clock').textContent='LA '+t}
clock();setInterval(clock,30000);

// films: click-to-play, privacy-enhanced embed injected in place (main film + behind the film)
document.querySelectorAll('[data-film]').forEach(function(poster){
  poster.addEventListener('click',function(){
    if(poster.classList.contains('playing'))return;
    poster.classList.add('playing');
    var f=document.createElement('iframe');
    f.src='https://www.youtube-nocookie.com/embed/'+poster.dataset.video+'?autoplay=1&rel=0&modestbranding=1&playsinline=1';
    f.allow='autoplay; encrypted-media; fullscreen';
    f.allowFullscreen=true;
    f.title=poster.dataset.title||'Campaign film';
    poster.innerHTML='';
    poster.appendChild(f);
  });
});

// header loop: reveal only once it's actually PLAYING (poster still shows until then),
// so the hero never flashes the black YouTube loading state. Event + short state-poll
// backup, NO blind timer - if it never plays, the poster stays. Ported from waffle-me-up
// (this exact mechanism fixed a prod-only black flash there). Reduced-motion keeps the poster.
(function () {
  var wrap = document.querySelector('[data-hero-video]');
  if (!wrap) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var shown = false;
  function reveal() { if (!shown) { shown = true; wrap.classList.add('is-playing'); } }
  var tag = document.createElement('script');
  tag.src = 'https://www.youtube.com/iframe_api';
  document.head.appendChild(tag);
  window.onYouTubeIframeAPIReady = function () {
    try {
      var p = new YT.Player('amHeaderVideo', {
        events: {
          onReady: function () {
            // YouTube can auto-enable captions on muted autoplay - keep the hero clean
            try { p.unloadModule('captions'); p.unloadModule('cc'); } catch (_) {}
            try { p.playVideo(); } catch (_) {}
          },
          onStateChange: function (e) { if (e.data === 1) { try { p.unloadModule('captions'); p.unloadModule('cc'); } catch (_) {} reveal(); } },
          // YT loads the captions module on its own schedule for muted autoplay -
          // onApiChange fires exactly when it appears, so unload it right there
          onApiChange: function () { try { p.unloadModule('captions'); p.unloadModule('cc'); } catch (_) {} }
        }
      });
      var tries = 0;
      var iv = setInterval(function () {
        tries++;
        try { if (p.getPlayerState && p.getPlayerState() === 1) reveal(); } catch (_) {}
        if (shown || tries > 40) clearInterval(iv); // stop polling after ~12s (poster stays)
      }, 300);
    } catch (_) {}
  };
})();
</script>
