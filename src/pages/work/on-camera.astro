<script is:inline>
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// ELEMENT 22 word switcher (HOST/PRESENT/INTERVIEW): auto-cycle bar-timed, click to jump, pause on hover
(function(){
  var sec=document.getElementById('cdd');if(!sec)return;
  var reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var words=[].slice.call(sec.querySelectorAll('.cdd-word')),
      panels=[].slice.call(sec.querySelectorAll('.cdd-panel')),
      cur=0,timer=null,vis=false,paused=false;
  function show(i){
    cur=(i+panels.length)%panels.length;
    words.forEach(function(w,j){w.classList.toggle('on',j===cur);});
    panels.forEach(function(p,j){p.classList.toggle('on',j===cur);});
    sec.setAttribute('data-i',cur);
  }
  function arm(){if(timer||reduced)return;timer=setInterval(function(){if(vis&&!paused)show(cur+1);},4600);}
  function disarm(){clearInterval(timer);timer=null;}
  words.forEach(function(w,i){w.addEventListener('click',function(){disarm();show(i);arm();});});
  sec.addEventListener('mouseenter',function(){paused=true;});
  sec.addEventListener('mouseleave',function(){paused=false;});
  new IntersectionObserver(function(es){es.forEach(function(e){vis=e.isIntersecting;vis?arm():disarm();});},{threshold:.2}).observe(sec);
})();

// the wall: click a tape, poster swaps for a nocookie embed, playing from the top.
// one deck at a time: starting a new tape puts the previous one back on its poster.
(function(){
  let current=null;
  function stop(card){
    const f=card.querySelector('iframe');
    if(f)f.remove();
    card.classList.remove('on');
    if(current===card)current=null;
  }
  document.querySelectorAll('.vid').forEach(card=>{
    card.querySelector('.ph').addEventListener('click',()=>{
      if(card.classList.contains('on'))return;
      if(current)stop(current);
      const id=card.dataset.id;
      const f=document.createElement('iframe');
      f.src=`https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      f.allow='autoplay; encrypted-media; fullscreen';
      f.allowFullscreen=true;
      f.title=card.dataset.title||'Video';
      card.querySelector('.ph').appendChild(f);
      card.classList.add('on');
      current=card;
    });
  });
  addEventListener('keydown',e=>{if(e.key==='Escape'&&current)stop(current)});
})();

// the podcast: click an episode row, a Spotify player docks open under it.
// one player at a time; embeds load lazily on first open.
(function(){
  let open=null;
  function close(li){
    li.classList.remove('on');
    li.querySelector('.go').textContent='Play +';
    if(open===li)open=null;
  }
  document.querySelectorAll('.pod .eps li[data-ep]').forEach(li=>{
    li.querySelector('.row').addEventListener('click',()=>{
      if(li.classList.contains('on')){close(li);return}
      if(open)close(open);
      const dock=li.querySelector('.dock');
      if(!dock.querySelector('iframe')){
        const f=document.createElement('iframe');
        f.src=`https://open.spotify.com/embed/episode/${li.dataset.ep}?theme=0`;
        f.loading='lazy';
        f.allow='autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
        f.title='Creator Clubhouse episode player';
        dock.appendChild(f);
      }
      li.classList.add('on');
      li.querySelector('.go').textContent='Close ✕';
      open=li;
    });
  });
})();

// companion drift
(function(){
  const c=document.querySelector('.companion');
  if(!c||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let k=false;
  addEventListener('scroll',()=>{
    if(k)return;k=true;
    requestAnimationFrame(()=>{
      const y=scrollY;
      c.style.transform=`translateY(${(Math.sin(y/420)*34).toFixed(1)}px) rotate(${(y*0.22).toFixed(1)}deg)`;
      k=false;
    });
  },{passive:true});
})();

// under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});document.getElementById('clock').textContent='LA '+t}
clock();setInterval(clock,30000);

// header loop: reveal only once it's actually PLAYING (poster still shows until then),
// so the hero never flashes the black YouTube loading state. Event + short state-poll
// backup, NO blind timer - if it never plays, the poster stays. Ported from waffle-me-up
// (this exact mechanism fixed a prod-only black flash there). Reduced-motion keeps the poster.
(function () {
  var wrap = document.querySelector('[data-hero-video]');
  if (!wrap) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var shown = false;
  function reveal() { if (!shown) { shown = true; wrap.classList.add('is-playing'); } }
  var tag = document.createElement('script');
  tag.src = 'https://www.youtube.com/iframe_api';
  document.head.appendChild(tag);
  window.onYouTubeIframeAPIReady = function () {
    try {
      var p = new YT.Player('ocHeaderVideo', {
        events: {
          onReady: function () {
            // YouTube can auto-enable captions on muted autoplay - keep the hero clean
            try { p.unloadModule('captions'); p.unloadModule('cc'); } catch (_) {}
            try { p.playVideo(); } catch (_) {}
          },
          onStateChange: function (e) { if (e.data === 1) { try { p.unloadModule('captions'); p.unloadModule('cc'); } catch (_) {} reveal(); } },
          // YT loads the captions module on its own schedule for muted autoplay -
          // onApiChange fires exactly when it appears, so unload it right there
          onApiChange: function () { try { p.unloadModule('captions'); p.unloadModule('cc'); } catch (_) {} }
        }
      });
      var tries = 0;
      var iv = setInterval(function () {
        tries++;
        try { if (p.getPlayerState && p.getPlayerState() === 1) reveal(); } catch (_) {}
        if (shown || tries > 40) clearInterval(iv); // stop polling after ~12s (poster stays)
      }, 300);
    } catch (_) {}
  };
})();
</script>
<script is:inline>
// at-foot: mark when the visitor reaches the very bottom (the pinned descriptor + clock
// stay put; the rest of the footer meta settles into one centered line beneath them).
(function(){
  function atBottom(){return window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-4;}
  function upd(){document.body.classList.toggle('at-foot',atBottom());}
  addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd,{passive:true});setTimeout(upd,400);
})();
</script>
