---
// Boise Schools · Good Neighbors. First page on the CaseStudy template — the
// shell (head, tokens, chrome, nav, over/underfoot, scripts) lives in
// src/layouts/CaseStudy.astro now, so what is left here IS the case.
import CaseStudy from '../../layouts/CaseStudy.astro';
import CallSheet from '../../components/CallSheet.astro';
import StatRow from '../../components/StatRow.astro';
import MasonryGallery from '../../components/MasonryGallery.astro';

const bsGallery = [
  ['bs-01.jpg','The crossing guard · The Bench'],
  ['bs-02.jpg','The front doors'],
  ['bs-03.jpg','Bike to school · POV'],
  ['bs-04.jpg','The hallway · Golden hour'],
  ['bs-05.jpg','After school · The long table'],
  ['bs-06.jpg','The end card · From the drone'],
].map(([f, label], i) => ({ src: `/case-studies/boise-schools/${f}`, cap: `FR-${String(i+1).padStart(2,'0')} · ${label}`, alt: `Boise Schools Good Neighbors film: ${label}` }));

// The stills set from the shoot (DJ's drop 2026-08-13), ordered the way the film
// reads a day: the morning bus, the ride in, the walk, the school day, after the
// last bell, then Friday night. Captions describe only what is IN the frame.
// Dawson Gutierrez confirmed as the stills photographer by DJ, 2026-08-13.
const bsStills = [
  ['st-07.jpg','The morning bus'],
  ['st-04.jpg','The ride in'],
  ['st-01.jpg','The walk home · the North End'],
  ['st-03.jpg','The locker bank'],
  ['st-02.jpg','Passing period'],
  ['st-06.jpg','Coffee after class'],
  ['st-05.jpg','Sidewalk chalk'],
  ['st-08.jpg','Borah · under the lights'],
  ['st-10.jpg','Borah · at the gate'],
  ['st-09.jpg','Borah · watching the field'],
].map(([f, label], i) => ({ src: `/case-studies/boise-schools/stills/${f}`, cap: `ST-${String(i+1).padStart(2,'0')} · ${label}`, alt: `Boise Schools Good Neighbors stills: ${label}` }));
---
<CaseStudy
  slug="boise-schools"
  code="MC-2026-03"
  title="Boise Schools"
  desc="Boise Schools make good neighbors: the Good Neighbors campaign film for Boise School District, directed by DJ Ramirez with Stoltz."
  chrome="Boise Schools · Good Neighbors"
  heroImg="/case-studies/boise-schools/bs-01.jpg"
  next={{ href: '/work/cwi-lets-get-started', name: "CWI · Let's Get Started", img: '/case-studies/cwi/hero-poster.jpg', code: 'MC-2023-05' }}
>
  <style slot="css" is:global>
  /* ONLY this page's own sections. The shell's CSS is in the layout — nothing
     here may restate it. (The old copy of this page also carried .merchband,
     .prods, .prod, .duo and .film rules for markup it never had, inherited from
     whichever page it was copied off. All gone.) */
  .statrow b{color:rgb(var(--on-rgb));font-weight:400}
  .story .side{position:static}
  .story .body.rv{transition-delay:.12s}
  .story .body a{border-bottom:1px solid var(--line)}
  .story .body a:hover{color:var(--struct);border-color:var(--struct)}

  /* what I did: slate rows under the role story */
  .did{list-style:none;margin-top:38px;padding:0;max-width:60ch}
  .did li{display:grid;grid-template-columns:120px 1fr;gap:26px;align-items:baseline;padding:16px 4px 14px;border-top:1px solid var(--line)}
  .did li:last-child{border-bottom:1px solid var(--line)}
  .did .k{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--red)}
  .did .v{font-size:17px;line-height:1.5;color:var(--ink)}

  /* the launch film: click-to-play poster (the layout's [data-film] script runs it) */
  .poster16{position:relative;aspect-ratio:16/9;overflow:hidden;cursor:pointer;background:#000}
  .poster16 img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.78);transition:transform .8s cubic-bezier(.22,1,.36,1)}
  .poster16:hover img{transform:scale(1.03)}
  .poster16 .play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:118px;height:118px;border-radius:50%;border:1.5px solid rgba(245,243,239,.8);display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.7;padding:0 12px;color:var(--paper);font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;background:rgba(22,21,20,.35);backdrop-filter:blur(6px);transition:background .3s,color .3s,transform .3s}
  .poster16:hover .play{background:var(--paper);color:var(--ink);transform:translate(-50%,-50%) scale(1.06)}
  .poster16 .fcap{position:absolute;left:18px;bottom:16px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:rgba(245,243,239,.85)}
  .poster16.playing{cursor:default}
  .poster16 iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .poster16 .pvid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none}
  .poster16.playing .pvid{display:none}

  @media (max-width:900px){
    .story{grid-template-columns:1fr}.story .side{position:static}
    .statrow>.in{justify-content:center;gap:14px 32px}
    .did li{grid-template-columns:1fr;gap:6px}
  }
  </style>

  <StatRow tone="paper"
    stats={[{ value: '2', label: 'Production days · March 2026' }, { value: '4', label: 'Neighborhoods, one per high school' }, { value: ':60', label: 'The film, plus cutdowns and social' }]}
    note="Boise School District · <b>the Good Neighbors platform · with Stoltz</b>"
  />

  <section class="paper">
    <div class="wrap story">
      <div class="side rv">
        <span class="k mono">\ The idea</span>
        <h2>The neighborhood is the <span class="serif">main character.</span></h2>
      </div>
      <div class="body rv">
        <p>Stoltz brought DJ in to direct the flagship film for Boise School District's Good Neighbors platform. The thinking: Boise's public schools are the heartbeat of its neighborhoods, so the film never argues the point, it just watches a school day give the neighborhood its rhythm. Busy mornings, the midday lull, the after-school swell.</p>
        <p>Four high schools stand in for four parts of the city: Boise High for the North End, Borah for the Bench, Capital for the West End, Timberline for Southeast Boise. One line carries the whole platform: Boise Schools make good neighbors.</p>
      </div>
    </div>
  </section>

  <section class="paper">
    <div class="wrap story">
      <div class="side rv">
        <span class="k mono">\ The role</span>
        <h2>Directed quiet, shot <span class="serif">at golden hour.</span></h2>
      </div>
      <div class="body rv">
        <p>DJ directed the film: two production days in March 2026, a slim crew built to move fast, real students and real school moments over staging. Mornings at golden hour and evenings at dusk, stills running alongside the motion, drone for the neighborhood scale. The style stays cinematic and quiet: film grain, natural motion blur, a Wonder Years style narration riding over real street sound.</p>
        <ul class="did">
          <li><span class="k">Direction</span><span class="v">Directed the shoot: the blocking, the talent, the calls on set.</span></li>
          <li><span class="k">The look</span><span class="v">Golden hour and dusk, film grain, low frame rate beats. Cinematic, never loud.</span></li>
          <li><span class="k">Post</span><span class="v">Director selects and review through the cut with the Stoltz edit team.</span></li>
        </ul>
        <div class="poster16 rv" data-film="Ngs97t0FZ6Q" data-film-title="Boise Schools Make Good Neighbors" style="margin-top:26px">
          <img loading="lazy" decoding="async" src="/case-studies/boise-schools/bs-01.jpg" alt="Boise Schools Good Neighbors film poster: the crossing guard" width="1600" height="900">
          <video class="pvid" src="/snips/boise-schools.mp4" autoplay muted loop playsinline preload="none" aria-hidden="true"></video>
          <span class="play">Play · The film</span>
          <span class="fcap">✳ Good Neighbors · Boise School District · 2026</span>
        </div>
      </div>
    </div>
  </section>

  <section class="paper">
    <MasonryGallery title="The frames · From the film" note="Frames from the finished film · DP Nathan Zanders · click to enlarge" images={bsGallery} />
  </section>

  {/* tone="dark" on purpose: the page ran hero -> one long light stretch -> footer,
      and CLAUDE.md's FLOW RULE says a page must never sit flat. */}
  <MasonryGallery tone="dark" title="The stills · From the shoot" note="Stills from the shoot · Dawson Gutierrez · click to enlarge" images={bsStills} />

  <section class="paper">
    <div class="wrap credits rv">
      <CallSheet
        code="MC-2026-03"
        sub="Boise School District · Good Neighbors"
        filed="MMXXVI"
        tone="light"
        rows={[
          { k: 'Client', v: 'Boise School District' },
          { k: 'Agency', v: 'Stoltz' },
          { k: 'Executive Creative Director', v: 'Mitch Kuhn · Stoltz' },
          { k: 'Director', v: 'DJ Ramirez', select: true },
          { k: 'Producer', v: 'Tessanie Rizvi' },
          { k: 'DP', v: 'Nathan Zanders' },
          { k: 'Photographer', v: 'Dawson Gutierrez' },
          { k: 'Art Direction + Edit', v: 'Cam Fast · Stoltz' },
          { k: 'Key Grip', v: 'Colton Machado' },
          { k: 'Drone', v: 'Ethan Moody' },
        ]}
      />
    </div>
  </section>
</CaseStudy>
