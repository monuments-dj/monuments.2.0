<script is:inline>
function buildRays(id){const g=document.getElementById(id);let s='';for(let i=0;i<20;i++){s+=`<path d="M0,-34 L-8,-92 L8,-92 Z" transform="rotate(${i*18})"/>`}g.innerHTML=s}
buildRays('rays');buildRays('rays2');

const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// cursor-trailing service preview
const pv=document.getElementById('preview'),pimg=pv.querySelector('img'),pcap=pv.querySelector('.cap');
if(matchMedia('(pointer:fine)').matches){
  let px=0,py=0,tx=0,ty=0,raf=null;
  document.querySelectorAll('.srow').forEach(row=>{
    row.addEventListener('mouseenter',()=>{pimg.src=row.dataset.img;pcap.textContent=row.dataset.cap;pv.classList.add('on')});
    row.addEventListener('mouseleave',()=>pv.classList.remove('on'));
  });
  addEventListener('mousemove',e=>{tx=e.clientX+30;ty=e.clientY-120;if(!raf)step()},{passive:true});
  function step(){raf=requestAnimationFrame(()=>{
    px+=(tx-px)*.13;py+=(ty-py)*.13;
    pv.style.left=px+'px';pv.style.top=py+'px';
    (Math.abs(tx-px)>.5||Math.abs(ty-py)>.5)?step():raf=null;
  })}
}

const mag=document.querySelector('.magnetic');
if(mag&&matchMedia('(pointer:fine)').matches){
  let raf;const st={x:0,y:0,tx:0,ty:0};
  mag.addEventListener('mousemove',e=>{const r=mag.getBoundingClientRect();st.tx=(e.clientX-r.left-r.width/2)*.32;st.ty=(e.clientY-r.top-r.height/2)*.32;loop()});
  mag.addEventListener('mouseleave',()=>{st.tx=0;st.ty=0;loop()});
  function loop(){cancelAnimationFrame(raf);(function step(){st.x+=(st.tx-st.x)*.16;st.y+=(st.ty-st.y)*.16;mag.style.transform=`translate(${st.x}px,${st.y}px)`;if(Math.abs(st.tx-st.x)>.2||Math.abs(st.ty-st.y)>.2)raf=requestAnimationFrame(step)})()}
}
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});document.getElementById('clock').textContent='LA '+t}
clock();setInterval(clock,30000);
// sun watermark rides the scroll
(function(){
  const s=document.querySelector('.sunwm');
  if(!s||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  s.style.animation='none';
  let k=false;
  addEventListener('scroll',()=>{
    if(k)return;k=true;
    requestAnimationFrame(()=>{
      s.style.transform=`translateY(calc(-50% + ${(scrollY*.12).toFixed(1)}px)) rotate(${(scrollY*.05).toFixed(2)}deg)`;
      k=false;
    });
  },{passive:true});
})();
// velocity marquee with decay back to base
(function(){
  let ly=scrollY,decaying=false;
  const anims=()=>[...document.querySelectorAll('.cli .track')].map(el=>el.getAnimations&&el.getAnimations()[0]).filter(Boolean);
  function decay(){
    let live=false;
    anims().forEach(a=>{if(a.playbackRate>1.03){a.playbackRate=1+(a.playbackRate-1)*0.92;live=true}else a.playbackRate=1});
    decaying=live;if(live)requestAnimationFrame(decay);
  }
  addEventListener('scroll',()=>{
    const vel=Math.min(3,Math.abs(scrollY-ly)/18);ly=scrollY;
    anims().forEach(a=>a.playbackRate=Math.max(a.playbackRate,1+vel));
    if(!decaying){decaying=true;requestAnimationFrame(decay)}
  },{passive:true});
})();

// footer under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  if(!uf||!over)return;
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
// spark companion: drifts + rotates with scroll
(function(){
  const c=document.querySelector('.companion');
  if(!c||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let cTick=false;
  addEventListener('scroll',()=>{
    if(cTick)return;cTick=true;
    requestAnimationFrame(()=>{
      c.style.transform=`translateY(${(Math.sin(scrollY/420)*34).toFixed(1)}px) rotate(${(scrollY*0.22).toFixed(1)}deg)`;
      cTick=false;
    });
  },{passive:true});
})();
// split-line rise
(function(){
  const els=document.querySelectorAll('[data-split]');
  if(!els.length)return;
  els.forEach(el=>{
    el.innerHTML=el.innerHTML.split(/<br\s*\/?>/i).map(l=>`<span class="sl"><span>${l}</span></span>`).join('');
  });
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.2});
  els.forEach(el=>io.observe(el));
})();


// scroll-lit rows: light up as they cross the center band
(function(){
  const rows=document.querySelectorAll('.litrow');
  if(!rows.length)return;
  const io=new IntersectionObserver(es=>es.forEach(e=>e.target.classList.toggle('lit',e.isIntersecting)),
    {rootMargin:'-32% 0px -32% 0px'});
  rows.forEach(r=>io.observe(r));
})();

</script>
<script is:inline>
// at-foot: mark when the visitor reaches the very bottom (the pinned descriptor + clock
// stay put; the rest of the footer meta settles into one centered line beneath them).
(function(){
  function atBottom(){return window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-4;}
  function upd(){document.body.classList.toggle('at-foot',atBottom());}
  addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd,{passive:true});setTimeout(upd,400);
})();
</script>
