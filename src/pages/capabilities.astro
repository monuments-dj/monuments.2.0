  stroke-dasharray:1;stroke-dashoffset:1}
/* only run once the band is on screen (.in), so it isn't looping off-screen */
.thebar .bq.in .scrib path{animation:scrib 4s cubic-bezier(.5,0,.5,1) infinite}
.thebar .bq.in .scrib .s2{animation-delay:.18s}
@keyframes scrib{
  0%   {stroke-dashoffset:1; opacity:1}
  18%  {stroke-dashoffset:0; opacity:1}   /* drawn */
  80%  {stroke-dashoffset:0; opacity:1}   /* hold */
  92%  {stroke-dashoffset:0; opacity:0}   /* fade out */
  100% {stroke-dashoffset:1; opacity:0}   /* reset, ready to redraw */
}
