/* the kit: fluency manifest, mono rows under a thin bar */
.kit{padding-top:9vh;padding-bottom:4vh}  /* padding-block only - see .refuse note */
.kit .bar{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;padding-bottom:13px;border-bottom:2px solid var(--ink)}
.kit .bar .mono b{color:var(--red)}
/* tightened 2026-07-14: rows were wrapping to 2-3 lines (name + note competed for
   the same track) and the columns held 4/3/2/3 items, so every rule ended at a
   different height = the ragged look. Now: names hold ONE line, notes shrink
   before the name does, columns align to the top. */
/* DJ 2026-07-14: "overall this is too small" - I had over-shrunk it in the tightening
   pass. Sizes back up (13px names / 11px notes); the one-line + no-wrap discipline and
   the top-aligned columns from that pass stay. */
.kitgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(20px,2.2vw,34px);margin-top:32px;align-items:start}
.kitcol .kh{display:block;color:var(--red);font-size:12px;letter-spacing:.1em;margin-bottom:13px;white-space:nowrap}
.kitcol ul{list-style:none;margin:0;padding:0}
.kitcol li{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-family:var(--mono);font-size:13px;letter-spacing:.045em;text-transform:uppercase;color:#55524c;padding:11px 0;border-bottom:1px solid var(--line);white-space:nowrap}
.kitcol li:first-child{border-top:1px solid var(--line)}
/* the name never wraps; the note is what gives way (ellipsis) if the track is tight */
.kitcol .kt{flex:0 0 auto}
.kitcol .kn{font-size:11px;letter-spacing:.03em;text-transform:none;color:#8f8d88;text-align:right;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis}
@media (max-width:1000px){.kitgrid{grid-template-columns:1fr 1fr;gap:20px}}
@media (max-width:560px){.kitgrid{grid-template-columns:1fr;gap:18px}}

/* the rolodex: index cards flipping over an axle (the one non-text moment) */
.rolo{padding:10vh 0}
.rolo .bar{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;padding-bottom:13px;border-bottom:2px solid var(--ink)}
.rolo .bar .mono b{color:var(--red)}
.rologrid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(28px,4vw,64px);align-items:center;margin-top:34px}
@media (max-width:860px){.rologrid .rolodex{order:2}.rologrid .rolotxt{order:1}} /* text first when stacked */
.rolotxt h3{font-weight:var(--dispw);font-size:clamp(24px,2.9vw,42px);letter-spacing:-.028em;line-height:1.04;text-transform:uppercase}
.rolotxt h3 .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:-.01em}
.rolotxt p{margin-top:16px;color:#4c4a45;max-width:48ch}
.rolodex{position:relative;height:262px;perspective:1000px}
.raxle{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);width:min(360px,86%);height:10px;border-radius:6px;background:var(--ink)}
.rcard{position:absolute;left:50%;bottom:30px;transform:translateX(-50%) rotateX(104deg);transform-origin:50% 100%;width:min(320px,78vw);height:192px;background:#fff;border:1px solid var(--line);border-radius:10px 10px 4px 4px;box-shadow:0 14px 34px rgba(20,20,20,.12);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;backface-visibility:hidden;opacity:0;transition:transform .55s cubic-bezier(.22,1,.36,1),opacity .3s;will-change:transform}
.rcard.live{transform:translateX(-50%) rotateX(0);opacity:1}
.rcard.out{transform:translateX(-50%) rotateX(-104deg);opacity:0}
.rcard::before,.rcard::after{content:'';position:absolute;bottom:9px;width:10px;height:10px;border-radius:50%;background:var(--paper);border:1px solid var(--line)}
.rcard::before{left:calc(50% - 64px)}
.rcard::after{left:calc(50% + 54px)}
.rcard b{font-weight:var(--dispw2);font-size:clamp(22px,2vw,30px);letter-spacing:-.02em;line-height:1.05;text-align:center;padding:0 22px;max-width:100%}
.rcard .mono{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#8f8d88}
/* rolodex cards stay light even when the .rolo band is flipped to ink (see grounds.css) */
[data-ground="ink"] .rcard,[data-ground="ink"] .rcard b{color:#161514!important}
[data-ground="ink"] .rcard .mono{color:#8f8d88!important}
/* the axle is ink by default — it would vanish on the ink band. Flip it to paper. */
[data-ground="ink"] .raxle{background:var(--paper)}
@media (max-width:860px){.rologrid{grid-template-columns:1fr;gap:22px}.rolodex{height:236px}}
@media (prefers-reduced-motion:reduce){.rcard{transition:none}}
