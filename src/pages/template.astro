<script is:inline>
(function(){
  // ELEMENT 24 · header slider (auto-advance, dots, arrows, inline edit + JSON export)
  var hs=document.getElementById('el-headerslider');
  if(hs){
    var slides=[].slice.call(hs.querySelectorAll('.hs-slide'));
    var dotsWrap=hs.querySelector('#hsDots'),i=0,timer=null,DUR=5200;
    slides.forEach(function(_,n){
      var d=document.createElement('button');d.className='hs-dot'+(n===0?' on':'');d.type='button';
      d.setAttribute('aria-label','Slide '+(n+1));
      d.addEventListener('click',function(){go(n);reset();});
      dotsWrap.appendChild(d);
    });
    var dots=[].slice.call(dotsWrap.children);
    function go(n){i=(n+slides.length)%slides.length;slides.forEach(function(s,k){s.classList.toggle('on',k===i);});dots.forEach(function(d,k){d.classList.toggle('on',k===i);});}
    function next(){go(i+1);} function prev(){go(i-1);}
    function reset(){if(timer)clearInterval(timer);timer=setInterval(next,DUR);}
    hs.querySelector('.hs-next').addEventListener('click',function(){next();reset();});
    hs.querySelector('.hs-prev').addEventListener('click',function(){prev();reset();});
    hs.addEventListener('mouseenter',function(){if(timer)clearInterval(timer);});
    hs.addEventListener('mouseleave',function(){if(!editing)reset();});
    var editBtn=document.getElementById('hsEdit'),exportBtn=document.getElementById('hsExport'),note=document.getElementById('hsNote'),editing=false;
    editBtn.addEventListener('click',function(){
      editing=!editing;editBtn.classList.toggle('on',editing);hs.classList.toggle('editing',editing);
      slides.forEach(function(s){s.querySelector('.hs-did').contentEditable=editing;s.querySelector('.hs-blurb').contentEditable=editing;});
      note.textContent=editing?'editing · change any role or blurb, then Export':'edit the role + blurb inline, then export';
      if(editing){if(timer)clearInterval(timer);}else{reset();}
    });
    exportBtn.addEventListener('click',function(){
      var data=slides.map(function(s){return{title:s.querySelector('h2').innerText.replace(/\s+/g,' ').trim(),did:s.querySelector('.hs-did').innerText.trim(),blurb:s.querySelector('.hs-blurb').innerText.trim()};});
      var json=JSON.stringify(data,null,2);
      var done=function(){note.textContent='copied '+data.length+' slides ✓';setTimeout(function(){note.textContent='edit the role + blurb inline, then export';},2600);};
      if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(json).then(done,function(){window.prompt('Copy slider copy:',json);});}
      else{window.prompt('Copy slider copy:',json);}
    });
    reset();
  }
  // ELEMENT 25 · numbers count up when they scroll in
  var cues=[].slice.call(document.querySelectorAll('[data-count]'));
  if(cues.length){
    var run=function(el){
      var target=parseFloat(el.getAttribute('data-count'))||0,suf=el.getAttribute('data-suffix')||'',dur=1400,t0=null;
      var step=function(ts){if(!t0)t0=ts;var p=Math.min((ts-t0)/dur,1),e=1-Math.pow(1-p,3);el.textContent=Math.round(target*e).toLocaleString('en-US')+suf;if(p<1)requestAnimationFrame(step);};
      requestAnimationFrame(step);
    };
    var cio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){run(e.target);cio.unobserve(e.target);}});},{threshold:.6});
    cues.forEach(function(c){cio.observe(c);});
  }
  // ELEMENT 26 · masonry lightbox
  var grid=document.getElementById('kitMgrid'),lb=document.getElementById('kitLbox');
  if(grid&&lb){
    var lbImg=document.getElementById('kitLboxImg'),cells=[].slice.call(grid.querySelectorAll('.mcell'));
    var capEl=document.getElementById('kitLboxCap'),campEl=capEl.querySelector('.lb-camp'),camEl=capEl.querySelector('.lb-cam');
    var srcs=cells.map(function(c){return c.getAttribute('data-full');}),idx=0;
    function openL(n){idx=(n+srcs.length)%srcs.length;var c=cells[idx];lbImg.src=c.getAttribute('data-full');campEl.textContent=c.getAttribute('data-cap')||'';camEl.textContent=c.getAttribute('data-cam')||'';lb.classList.add('on');}
    function closeL(){lb.classList.remove('on');lbImg.src='';}
    cells.forEach(function(c,n){c.addEventListener('click',function(){openL(n);});});
    lb.querySelector('.lb-close').addEventListener('click',closeL);
    lb.querySelector('.lb-next').addEventListener('click',function(){openL(idx+1);});
    lb.querySelector('.lb-prev').addEventListener('click',function(){openL(idx-1);});
    lb.addEventListener('click',function(e){if(e.target===lb)closeL();});
    document.addEventListener('keydown',function(e){if(!lb.classList.contains('on'))return;if(e.key==='Escape')closeL();else if(e.key==='ArrowRight')openL(idx+1);else if(e.key==='ArrowLeft')openL(idx-1);});
  }
})();
</script>

