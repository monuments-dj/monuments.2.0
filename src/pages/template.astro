<script is:inline>
// read-more: clamp long loglines on the index cards + header blurb, inject a toggle only when the copy overflows
(function(){
  function init(el){
    if(el.dataset.rmInit) return;
    if(el.scrollHeight <= el.clientHeight + 2) return; // fits within the clamp, no toggle needed
    el.dataset.rmInit='1';
    var inLink = !!el.closest('a');
    var btn=document.createElement(inLink ? 'span' : 'button');
    btn.className='rm-btn'; btn.textContent='Read more';
    if(inLink){ btn.setAttribute('role','button'); btn.tabIndex=0; } else { btn.type='button'; }
    function toggle(e){ if(e){ e.preventDefault(); e.stopPropagation(); }
      var open=el.classList.toggle('rm-open'); btn.textContent=open?'Read less':'Read more'; }
    btn.addEventListener('click', toggle);
    if(inLink) btn.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' ') toggle(e); });
    el.insertAdjacentElement('afterend', btn);
  }
  function run(){ [].slice.call(document.querySelectorAll('[data-rm]')).forEach(init); }
  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(function(){ requestAnimationFrame(run); }); }
  else { window.addEventListener('load', run); }
})();
</script>

