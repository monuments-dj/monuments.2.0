[data-motion="lock"] .mimg{opacity:calc(var(--p,0) * 2.6 - 1.3);transform:scale(calc(.86 + var(--p,0) * .14));transform-origin:50% 80%}
[data-motion="lock"] .mlab-stats .m-el,[data-motion="lock"] .mlab-duo .m-el,[data-motion="lock"] .mlab-cta .m-el{opacity:0;transition:opacity .8s cubic-bezier(.19,1,.22,1) var(--d,0s),transform .8s cubic-bezier(.19,1,.22,1) var(--d,0s);transform:translateY(22px)}
[data-motion="lock"] .mlab-stats .m-el.in,[data-motion="lock"] .mlab-duo .m-el.in,[data-motion="lock"] .mlab-cta .m-el.in{opacity:1;transform:none}

/* 06 BLEND · DJ's pick: LOCK the thesis (pins + assembles), DRIFT everything after */
[data-motion="blend"] .m-el{opacity:1}
[data-motion="blend"] .mlab-lockseg{height:240svh}
[data-motion="blend"] .mlab-stage{position:sticky;top:0;min-height:100svh;display:flex;align-items:center;overflow:hidden}
[data-motion="blend"] .mlab-title{padding:0}
[data-motion="blend"] .mimg img{aspect-ratio:auto;height:min(30svh,340px);width:100%;object-fit:cover}
[data-motion="blend"] .mh .mline:nth-child(1) .mi{transform:translateX(calc((1 - var(--p,0)) * -26%));opacity:calc(var(--p,0) * 2)}
[data-motion="blend"] .mh .mline:nth-child(2) .mi{transform:translateX(calc((1 - var(--p,0)) * 26%));opacity:calc(var(--p,0) * 2)}
[data-motion="blend"] .mk{opacity:calc(var(--p,0) * 3 - .2)}
[data-motion="blend"] .mlede{opacity:calc(var(--p,0) * 2.4 - 1);transform:translateY(calc((1 - var(--p,0)) * 30px))}
[data-motion="blend"] .mimg{opacity:calc(var(--p,0) * 2.6 - 1.3);transform:scale(calc(.86 + var(--p,0) * .14));transform-origin:50% 80%}
/* post-pin = the drift entrance (bigger float + scale), + ambient parallax in JS */
[data-motion="blend"] .mlab-stats .m-el,[data-motion="blend"] .mlab-duo .m-el,[data-motion="blend"] .mlab-cta .m-el{opacity:0;transform:translateY(56px) scale(.985);transition:opacity 1.15s cubic-bezier(.22,1,.36,1) var(--d,0s),transform 1.15s cubic-bezier(.22,1,.36,1) var(--d,0s)}
[data-motion="blend"] .mlab-stats .m-el.in,[data-motion="blend"] .mlab-duo .m-el.in,[data-motion="blend"] .mlab-cta .m-el.in{opacity:1;transform:none}
.mlab-btns button.rec{border-color:var(--spark);color:var(--spark)}
.mlab-btns button.rec.on{background:var(--spark);color:var(--ink);border-color:var(--spark)}

/* 05 SNAP · hard word flips, images stamp with an outline flash, no soft tweens */
[data-motion="snap"] .m-el{opacity:0}
