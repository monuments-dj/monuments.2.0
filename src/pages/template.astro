<script is:inline>
/* MOTION LAB engine · Kit-only. Modes restyle the same .m-el set; IO drives
   entrances, rAF drives drift parallax + the lock scrub. Persist: mnmt-mlab. */
(function(){
  var lab=document.getElementById('mlab');if(!lab)return;
  var reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var DESC={
    settle:"01 · Everything settles in: soft fade, small lift, blur clears. Calm, fast, invisible.",
    rise:"02 · The masked line rise, re-timed: expo ease, short travel, honest stagger. The current grammar done right.",
    drift:"03 · Ambient parallax: elements float up on entry, media counter-drifts as you scroll. Never stops moving, never shouts.",
    lock:"04 · The screen locks and scroll assembles the thesis: lines slide in from the wings, the frame scales up, then the page lets go.",
    snap:"05 · No tweens. Words flip on like a slate board, frames stamp with a flash, everything lands with attitude.",
    blend:"06 · The blend (your pick): the thesis LOCKS and assembles as you scroll, then everything after DRIFTS up and keeps floating. Lock's moment, drift's life."
  };
  var desc=document.getElementById('mlabDesc'),btns=[].slice.call(lab.querySelectorAll('.mlab-btns button'));
  var els=[].slice.call(lab.querySelectorAll('.m-el'));
  var lockseg=document.getElementById('mlabLockseg');

  // word delays for SNAP (checkerboard-ish flip order)
  [].slice.call(lab.querySelectorAll('.m-el')).forEach(function(el){
    [].slice.call(el.querySelectorAll('.w')).forEach(function(w,i){w.style.setProperty('--wd',(i*0.07+((i%3)*0.02))+'s');});
  });

  // stat count-up on entry (all modes but lock-scrub; lock counts by progress)
  function countStat(b,t){ // t: 0..1
    var n=+b.getAttribute('data-n'),fmt=b.getAttribute('data-fmt');
    var v=Math.round(n*t);
    if(fmt==='k')b.textContent=(v>=1000?(Math.round(v/100)/10)+'K':v)+(t>=1?'+':'');
    else if(fmt==='x')b.textContent=v+'×';
    else if(fmt==='range')b.textContent='2→'+v+(t>=1?'+':'');
    else if(fmt==='emmy')b.textContent=t>=1?'Emmy':['E','Em','Emm','Emmy'][Math.min(3,Math.floor(t*4))];
  }
  function animateStats(){
    if(reduced)return;
    [].slice.call(lab.querySelectorAll('.stat b[data-n]')).forEach(function(b){
      var st=null;
      function step(ts){if(!st)st=ts;var t=Math.min(1,(ts-st)/900);countStat(b,t);if(t<1)requestAnimationFrame(step);}
      requestAnimationFrame(step);
    });
  }

  // entrance observer
  var io;
  function observe(){
    if(io)io.disconnect();
    io=new IntersectionObserver(function(es){es.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('in');
        if(e.target.classList.contains('stat'))animateStats._once||(animateStats(),animateStats._once=true);
        io.unobserve(e.target);
      }
    });},{threshold:.12,rootMargin:'0px 0px -6% 0px'});
    els.forEach(function(el){io.observe(el);});
  }

  function mode(){return lab.getAttribute('data-motion');}
  function reset(){
    animateStats._once=false;
    els.forEach(function(el){el.classList.remove('in');});
    // force reflow so re-added .in re-runs transitions/animations
    void lab.offsetHeight;
    if(reduced){els.forEach(function(el){el.classList.add('in');});return;}
    observe();
  }

  // picker
  btns.forEach(function(b){b.addEventListener('click',function(){
    btns.forEach(function(x){x.classList.remove('on');});
    b.classList.add('on');
    lab.setAttribute('data-motion',b.getAttribute('data-mo'));
    try{localStorage.setItem('mnmt-mlab',b.getAttribute('data-mo'));}catch(e){}
    desc.textContent=DESC[b.getAttribute('data-mo')];
    reset();
  });});
  var saved=null;try{saved=localStorage.getItem('mnmt-mlab');}catch(e){}
  if(saved&&DESC[saved]){var b=btns.filter(function(x){return x.getAttribute('data-mo')===saved;})[0];if(b)b.click();}

  document.getElementById('mlabReplay').addEventListener('click',function(){
    var top=lab.getBoundingClientRect().top+scrollY-60;
    scrollTo({top:top,behavior:'auto'});
    reset();
  });

  // rAF: drift parallax + lock scrub (scoped to the lab, cheap when idle)
  var ticking=false;
  function frame(){
    ticking=false;
    if(reduced)return;
    var m=mode(), driftish=(m==='drift'||m==='blend');
    var img=lab.querySelector('.mimg img'), mh=lab.querySelector('.mh'),
        fa=lab.querySelector('.mfloat-a'), fb=lab.querySelector('.mfloat-b');
    // clear the JS-driven inline transforms where the mode no longer owns them.
    // In blend/lock the thesis image + headline are driven by CSS (--p), so their
    // inline drift transform must be cleared or a stale scale would fight the lock.
    if(img && m!=='drift') img.style.transform='';
    if(mh && m!=='drift') mh.style.transform='';
    if(!driftish){ if(fa)fa.style.transform=''; if(fb)fb.style.transform=''; }
    // DRIFT-only: thesis image + headline counter-drift (in blend they're locked)
    if(m==='drift'){
      if(img){var r=img.parentElement.getBoundingClientRect();var t=(r.top+r.height/2-innerHeight/2)/innerHeight;img.style.transform='scale(1.12) translateY('+(t*7)+'%)';}
      if(mh){var r2=mh.getBoundingClientRect();var t2=(r2.top-innerHeight*.3)/innerHeight;mh.style.transform='translateY('+(Math.max(-1,Math.min(1,t2))*-14)+'px)';}
    }
    // duo floats DRIFT in both drift + blend
    if(driftish){[[fa,-4.5],[fb,4.5]].forEach(function(p){if(!p[0])return;var r=p[0].getBoundingClientRect();var t=(r.top+r.height/2-innerHeight/2)/innerHeight;p[0].style.transform='translateY('+(t*p[1]*10)+'px)';});}
    // LOCK scrub in both lock + blend
    if((m==='lock'||m==='blend')&&lockseg){
      var r3=lockseg.getBoundingClientRect();
      var total=lockseg.offsetHeight-innerHeight;
      var p=total>0?Math.max(0,Math.min(1,-r3.top/total)):1;
      lockseg.style.setProperty('--p',p.toFixed(4));
    }
  }
  function onScroll(){if(!ticking){ticking=true;requestAnimationFrame(frame);}}
  addEventListener('scroll',onScroll,{passive:true});
  addEventListener('resize',onScroll,{passive:true});

  if(reduced){els.forEach(function(el){el.classList.add('in');});}
  else observe();
  onScroll();
})();
</script>

