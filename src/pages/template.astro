// 01B header annotations draw on when each header enters view
(function(){
  var heads=[].slice.call(document.querySelectorAll('.herob'));if(!heads.length)return;
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('drawn');io.unobserve(e.target);}});},{threshold:.35});
  heads.forEach(function(h){io.observe(h);});
