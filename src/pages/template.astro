---
import CallSheet from '../components/CallSheet.astro';
import PageFooter from '../components/PageFooter.astro';
import RoleTag from '../components/RoleTag.astro';
import SocialWall from '../components/SocialWall.astro';
import NextFile from '../components/NextFile.astro';
import TextBlock from '../components/TextBlock.astro';
import MediaBlock from '../components/MediaBlock.astro';
import PageHero from '../components/PageHero.astro';
import StatRow from '../components/StatRow.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import QuoteBlock from '../components/QuoteBlock.astro';
import CtaBlock from '../components/CtaBlock.astro';
import '../styles/filmsplit.css';
import { work as workAll } from '../data/work.js';
import '../styles/work.css';

// specimen for the insight block (ELEMENT 31) — proves the per-page data wiring
const cwiIns = workAll.find((w) => w.slug === 'cwi-lets-get-started') || {};

// (header title is now a two-line client:/campaign lockup — sizing lives in CSS,
//  fluid vw so it scales with the viewport)

// === THE KIT · case-page element library ===
// The single source of truth for case-page elements. When an element needs a fix
// or a new page needs building, pull the markup + CSS from HERE, not from another
// page (that is how the drift happened). Every element consumes the identity
// tokens (--disp/--dispw, --spark/--struct/--on-rgb), so the accent + type
// switcher previews the whole system live on this one page.
// Not linked from nav. noindex. Placeholder media borrowed from existing assets.

// workAll now comes from the shared source of truth: src/data/work.js (imported above).
// Edit copy there and it updates the slider (24), the work index (29), and the hover
// cards (28) at once. The `logline` field is the named summary text.

// kPairs: DJ's worked-out closed set (ELEMENT 27). kicker + CTA heading, paired. DO NOT
// invent new ones; this is the locked set.
const kPairs = [
  { kicker: "Being forgettable is expensive", cta: "Let's build something worth remembering.", btn: "Let's talk" },
  { kicker: "Good work starts with good questions", cta: "Tell us what you're building.", btn: "Reach Out" },
  // 3rd pair: kicker supplied by DJ 2026-07-14 for the "Culture is talking" statement,
  // which until now had no kicker in the closed set.
  { kicker: "Ear to the street", cta: "Culture is talking. Most brands aren't listening.", btn: "Let's talk" },
];
// tickerItems: the looping work-page ticker (ELEMENT 30). DJ's real one-liners.
const tickerItems = [
  "A problem defined is a problem half solved.",
  "Being forgettable is expensive.",
  "Good work starts with good questions.",
];
// statrowDemo: real data, not a placeholder — the LOCKED Art of Visuals stat
// row, verbatim from docs/WORK-PAGES-COPY-HANDOFF.md ("Stat row — REVISED (v2)").
// Used to demo StatRow's tone prop (accent/paper/ink) with real content.
const srStats = [
  { value: '4x', label: 'agency revenue growth' },
  { value: '2M+', label: 'the community behind the agency' },
  { value: '$200K+', label: 'commercial budgets by the end' },
];
const srNote = 'Roster · Sony · Adorama · MSI · Intel · Lexar · Peak Design · WANDRD';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>The Kit · element library · Monuments</title>
  <!-- og:begin · generated by tools/add-og.mjs · re-run after domain swap -->
  <meta name="description" content="The Kit. The element library behind the site.">
  <link rel="canonical" href="https://monuments-2-0.vercel.app/template">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Monuments">
  <meta property="og:title" content="The Kit · element library · Monuments">
  <meta property="og:description" content="The Kit. The element library behind the site.">
  <meta property="og:url" content="https://monuments-2-0.vercel.app/template">
  <meta property="og:image" content="https://monuments-2-0.vercel.app/og/card.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://monuments-2-0.vercel.app/og/card.jpg">
  <!-- og:end -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Fragment+Mono:ital@0;1&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style is:global>
:root{
  --ink:#161514; --paper:#F5F3EF; --rose:#EFA1AD; --cobalt:#2438E8; --red:#E0311A;
  --red-accent:var(--accent, var(--red)); /* the hand-drawn CTA circle + accent marks; retheme HERE */
  --dim:#8f8d88; --line:#dcd9d2; --lined:#2c2b29;
  --wrap:1380px; --pad:clamp(22px,4.6vw,44px);
  --disp:'Bricolage Grotesque',sans-serif; --dispw:800; --dispw2:600;
  --mono:'Fragment Mono',monospace;
  --spark:var(--rose); --struct:var(--rose); --on-rgb:22,21,20;
  /* ── TYPE SCALE · THE COPY RULES (DJ 2026-07-13) ─────────────────────────
     One small, modern scale for the whole site. Pull these tokens; never
     hard-code a size. This is what kills "every header is a different size." */
  --fs-display: clamp(46px,8vw,100px);    /* hero title ONLY */
  --fs-statement: clamp(28px,3.6vw,46px); /* one big opening/closing line, sparingly */
  --fs-h2: clamp(22px,2.3vw,31px);        /* section header — the workhorse, this is the ceiling */
  --fs-h3: clamp(17px,1.4vw,20px);        /* sub-head */
  --fs-lead: clamp(18px,1.4vw,21px);      /* lead paragraph (first line of a section) */
  --fs-body: 16.5px;                      /* body copy */
  --fs-cap: 12.5px;                       /* captions / small print */
  --fs-mono: 11px;                        /* mono kickers, labels, meta */
}
*{margin:0;box-sizing:border-box}
/* NOTE: html{overflow-x:clip} would block body's overflow from propagating to
   the viewport, making body the scroll container and silently KILLING every
   position:sticky inside it (the motion lab's pin + bar). Home has no html
   override for the same reason. If a pinned section ever fails site-wide,
   check for this combo first. */
body{background:var(--ink);color:var(--paper);font-family:var(--body,var(--disp));font-size:17px;line-height:1.6;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}

/* library chrome: the spec tag above every element */
.spec{background:var(--ink);border-top:1px dashed var(--lined);padding:34px 0 12px}
.spec .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
.spec .id{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--spark)}
.spec .use{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);max-width:70ch}
.spec .use .lives{color:var(--spark);font-weight:400}
.white .spec .id{color:var(--struct)}
.white .spec .use{color:#8f8d88}
.libhead{padding:16vh 0 6vh;text-align:left}
/* THE PRIVATE INDEX: everything pulled out of the public nav, reachable only from here */
.privindex{margin-top:34px;padding-top:22px;border-top:2px solid var(--ink)}
.privindex .pi-t{display:block;color:var(--red);margin-bottom:16px}
.pi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.pi-l{display:block;border:1px solid var(--line);border-radius:8px;padding:14px 16px;background:#fff;
  transition:translate .35s cubic-bezier(.22,1,.36,1),border-color .35s ease}
.pi-l:hover{translate:0 -3px;border-color:var(--ink)}
.pi-l b{display:block;font-weight:var(--dispw2);font-size:15px;letter-spacing:-.01em;color:var(--ink)}
.pi-l span{display:block;margin-top:3px;font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--dim)}
@media (max-width:900px){.pi-grid{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.pi-grid{grid-template-columns:1fr}}
/* decide-first: DJ's open calls, surfaced at the top, each linked to its element */
.decide{background:var(--paper);color:var(--ink);padding:6vh 0 7vh;margin-bottom:2vh}
.decide .dec-k{display:block;color:var(--red);letter-spacing:.12em;margin-bottom:14px}
.decide h2{font-weight:var(--dispw);font-size:clamp(28px,4.4vw,60px);letter-spacing:-.035em;line-height:.98;text-transform:uppercase}
.decide h2 .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none}
.decide .dec-sub{margin-top:16px;max-width:60ch;color:#4c4a45;font-size:clamp(15px,1.3vw,18px);line-height:1.6}
.dec-list{list-style:none;counter-reset:d;margin:34px 0 0;padding:0;display:grid;gap:2px;max-width:1000px}
.dec-list>li{counter-increment:d;position:relative;padding:16px 0 16px 44px;border-top:1px solid var(--line);font-size:clamp(15px,1.3vw,18px);line-height:1.45;color:var(--ink)}
.dec-list li a{display:block;color:var(--ink);transition:color .25s}
.dec-list li a:hover{color:var(--red)}
.dec-list li::before{content:counter(d,decimal-leading-zero);position:absolute;left:0;top:16px;font-family:var(--mono);font-size:12px;color:var(--red)}
.dec-list b{font-weight:var(--dispw2)}
.dec-list u{text-decoration-color:var(--red);text-underline-offset:3px}
.dec-go{float:right;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);margin-left:12px}
@media(max-width:640px){.dec-go{float:none;display:block;margin:6px 0 0}}
.libhead h1{font-weight:var(--dispw);font-size:clamp(40px,6.4vw,92px);line-height:.92;letter-spacing:-.035em;text-transform:uppercase}
.libhead h1 .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none}
.libhead p{margin-top:20px;color:var(--dim);max-width:62ch}
.libhead .k{color:var(--spark);display:block;margin-bottom:18px}
.kitctrl{margin-top:34px;display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;border-top:1px solid var(--lined);padding-top:20px}
.kitctrl .kc-t{color:var(--spark);letter-spacing:.1em}
.kitctrl .kc-p{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);border:1px solid var(--lined);border-radius:99px;padding:8px 14px;transition:color .25s,border-color .25s}
.kitctrl .kc-p:hover{color:var(--paper);border-color:var(--dim)}
.kitctrl .kc-p b{color:var(--spark);font-weight:400}
.acctool.pulse{animation:acctoolPulse 1.4s ease 2}
@keyframes acctoolPulse{0%,100%{box-shadow:0 0 0 0 rgba(224,49,26,0)}50%{box-shadow:0 0 0 6px rgba(224,49,26,.55)}}

/* TYPE SCALE specimen (the copy rules, shown) */
.tsc{padding:2vh 0 8vh;display:grid;gap:0}
.tsc-row{display:grid;grid-template-columns:210px 1fr;gap:18px 34px;align-items:baseline;border-top:1px solid var(--line);padding:20px 0}
.tsc-lbl{color:var(--dim);letter-spacing:.08em;text-transform:uppercase;font-size:10px;line-height:1.6}
.tsc-ex{font-family:var(--disp);font-weight:var(--dispw);letter-spacing:-.02em;line-height:1.02;text-transform:uppercase;color:var(--ink);margin:0;min-width:0;overflow-wrap:break-word}
.tsc-row{min-width:0}
.tsc-ex.tsc-body{font-weight:400;text-transform:none;letter-spacing:0;line-height:1.5;color:#4c4a45;max-width:62ch}
.tsc-ex.mono{font-family:var(--mono);font-weight:400;letter-spacing:.08em;text-transform:uppercase}
@media(max-width:680px){.tsc-row{grid-template-columns:1fr;gap:6px}}

/* ELEMENT 01 · case hero */
.hero{position:relative;height:70svh;min-height:520px;overflow:hidden;background:var(--ink)}
.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:contrast(1.03) brightness(0.5)}
.hero .scrim{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 44%,rgba(22,21,20,.52),rgba(22,21,20,.18) 58%,rgba(22,21,20,.46))}
.hero .t{z-index:72;position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);width:104%;text-align:center;color:var(--paper);font-weight:var(--dispw);font-size:clamp(46px,8.1vw,113px);line-height:.92;letter-spacing:-.035em;text-transform:uppercase}
@media(max-width:640px){.hero .t{width:100%}}
.hero .t .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:-.01em}
.hero .t .spark{color:var(--spark)}
.hero .t .ln{display:block;overflow:hidden;padding-bottom:.18em;margin-bottom:-.18em}
.hero .t .ln>span{display:block}
.hero .kck{z-index:72;position:absolute;left:var(--pad);bottom:9vh;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--paper);line-height:1.9}
.hero .kck b{color:var(--spark);font-weight:400}
.hero .nfo{z-index:72;position:absolute;right:var(--pad);bottom:9vh;text-align:left;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;line-height:1.9;color:var(--paper)}
.hero .nfo .h{color:var(--struct);background:var(--paper);padding:1px 7px;display:inline-block;margin-bottom:8px}

/* ELEMENT 01B · the old-site header cut (DJ prefers, 2026-07-12): giant plain
   left-aligned sans, tight leading, logo + scribbled-oval role under the stack */
.herob{position:relative;height:78svh;min-height:560px;overflow:hidden;background:var(--ink);display:flex;align-items:center}
.herob>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:contrast(1.02) brightness(.38)}
.herob .hb-in{position:relative;z-index:2;width:100%}
.herob h1{color:#fff;font-family:var(--disp);font-weight:var(--dispw2,600);font-size:clamp(54px,8.6vw,132px);line-height:1.02;letter-spacing:-.01em;text-transform:uppercase}
.herob .hb-ver{position:absolute;top:22px;left:0;color:#fff;letter-spacing:.14em;background:rgba(10,10,10,.5);padding:5px 10px;backdrop-filter:blur(3px);z-index:3}
.herob .hb-role{display:flex;align-items:center;gap:26px;margin-top:30px}
.herob .hb-logoimg{height:26px;width:auto;filter:brightness(0) invert(1);opacity:.95}
.herob .hb-scrib{position:relative;display:inline-flex;align-items:center;justify-content:center;padding:10px 28px}
.herob .hb-scrib i{position:relative;z-index:1;font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-size:19px;color:#fff;white-space:nowrap}
/* HAND-DRAWN ANNOTATIONS (#el-annot) · marker strokes that draw on, hold, then reset  · 
   a 4s loop that starts when the header scrolls in (.drawn). pathLength=1 normalizes the
   draw so it works at any path size. Slight rotation + loose overshoot paths = the drawn feel. */
.herob .hb-oval{position:absolute;inset:-9px -15px;width:calc(100% + 30px);height:calc(100% + 18px);overflow:visible;pointer-events:none;transform:rotate(-1.4deg)}
.herob .hb-oval path{fill:none;stroke:var(--annot);stroke-width:3.6;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1;stroke-dashoffset:1;opacity:0}
.herob.drawn .hb-oval path{animation:hbDraw 4s ease-in-out infinite}
/* double hand-drawn underline (two loose, slightly wavy strokes, staggered) */
.herob .hb-uline{padding:0 10px 18px}
.herob .hb-under{position:absolute;left:-3px;right:-3px;bottom:-1px;width:calc(100% + 6px);height:24px;overflow:visible;pointer-events:none}
.herob .hb-under path{fill:none;stroke:var(--annot);stroke-width:3.5;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;opacity:0}
.herob.drawn .hb-under .u1{animation:hbDraw 4s ease-in-out infinite}
.herob.drawn .hb-under .u2{animation:hbDraw 4s ease-in-out .22s infinite}
@keyframes hbDraw{0%{stroke-dashoffset:1;opacity:0}6%{opacity:1}30%{stroke-dashoffset:0;opacity:1}84%{stroke-dashoffset:0;opacity:1}94%{stroke-dashoffset:0;opacity:0}100%{stroke-dashoffset:1;opacity:0}}
.herob .hb-blurb{margin-top:26px;max-width:52ch;color:rgba(245,243,239,.82);font-size:clamp(14px,1.1vw,16px);line-height:1.6}
@media (prefers-reduced-motion:reduce){.herob .hb-oval path,.herob .hb-under path{stroke-dashoffset:0;opacity:1;animation:none}}
/* service color legend */
.svcsec{padding:9vh 0}
.svcgrid{display:flex;flex-wrap:wrap;gap:14px 26px}
.svc{display:inline-flex;align-items:center;gap:10px;font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink)}
.svc i{width:16px;height:16px;border-radius:50%;background:var(--c);flex:none;box-shadow:0 2px 8px color-mix(in srgb,var(--c) 55%,transparent)}
@media (max-width:680px){.herob h1{font-size:clamp(40px,11vw,64px)}.herob .hb-role{flex-wrap:wrap;gap:14px}}

/* ELEMENT 02 · statrow (accent-proof: text rides --on-rgb) */
@media(max-width:900px){.statrow .stat:has(.note){margin-left:0}.statrow .stat .note{text-align:left}}

/* ELEMENT 03 · the brief on paper */
.story .svc{list-style:none;margin:26px 0 0;padding:0}
.story .svc li{font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:#6d6a64;padding:9px 0;border-top:1px solid var(--line)}
.story .svc li i{font-style:normal;color:var(--red);margin-right:10px}
@media (max-width:900px){.story{grid-template-columns:1fr}}

/* ELEMENT 04 · chapter head (the fhead device) */
.white{background:#fff;color:var(--ink)}
.front{padding:7vh 0 8vh}
.fhead{display:grid;grid-template-columns:auto 1fr auto;gap:6px 28px;align-items:baseline;border-top:2px solid var(--ink);padding-top:20px;margin-bottom:clamp(26px,4vh,40px)}
.fhead .fn{grid-column:1;grid-row:1/3;font-family:var(--mono);font-size:clamp(34px,3.6vw,54px);line-height:.9;color:var(--red)}
.fhead h3{grid-column:2;grid-row:1;font-weight:var(--dispw);font-size:clamp(24px,2.9vw,40px);letter-spacing:-.03em;line-height:1;text-transform:uppercase}
.fhead h3 .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none}
.fhead .dek{grid-column:2/4;grid-row:2;color:#6d6a64;font-size:16px;max-width:62ch}
.fhead .tag{grid-column:3;grid-row:1;justify-self:end;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
@media(max-width:900px){.fhead{grid-template-columns:1fr}.fhead .fn,.fhead h3,.fhead .dek{grid-column:1;grid-row:auto}.fhead .tag{display:none}}

/* ELEMENT 05 · plates (borderless frames on white; .doc adds a hairline) */
.duo{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,2.2vw,26px)}
.pl{position:relative}
.pl img{width:100%;height:auto;display:block}
.pl .cap{display:block;padding:9px 0 0;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;color:var(--dim);text-transform:uppercase}
.pl .cap b{color:var(--red);font-weight:400}
.pl.doc img{border:1px solid var(--line)}
.pl.off{width:min(76%,940px);margin-left:auto}
@media (max-width:900px){.duo{grid-template-columns:1fr}.pl.off{width:100%}}

/* ELEMENT 06 · full-bleed break */

/* ELEMENT 07 · browser frame */
.browser{border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 26px 70px rgba(22,21,20,.12);background:#fff;max-width:980px}
.browser .bbar{display:flex;align-items:center;gap:6px;padding:11px 16px;background:#faf9f6;border-bottom:1px solid var(--line)}
.browser .bbar i{width:9px;height:9px;border-radius:50%;background:var(--line)}
.browser .burl{margin:0 auto;font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;color:#6d6a64;background:#fff;border:1px solid var(--line);border-radius:99px;padding:3px 22px}
.browser img{width:100%;height:auto;display:block}

/* ELEMENT 08 · quote band (flips to ink automatically in B/W mode) */

/* ELEMENT 09 · testimonial card */
.tstwrap{padding:8vh 0}
.tst-card{margin:0;background:rgba(245,243,239,.04);border:1px solid rgba(245,243,239,.1);border-radius:11px;padding:26px 22px 20px;display:flex;flex-direction:column;gap:18px;min-height:190px;max-width:420px}
.tst-q{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-size:clamp(19px,1.9vw,25px);line-height:1.4;flex:1}
.tst-ph{color:rgba(245,243,239,.28)}
.tst-card figcaption{display:flex;flex-direction:column;gap:4px}
.tst-n{font-weight:var(--dispw2);font-size:15.5px}
.tst-r{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:#8f8d88;font-family:var(--mono)}
.tst-chip{align-self:flex-start;margin-top:6px;font-family:var(--mono);font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--spark);border:1px solid rgba(245,243,239,.25);border-radius:99px;padding:3px 9px}

/* ELEMENT 10 · pills + buttons */
.pillrow{display:flex;gap:16px;flex-wrap:wrap;align-items:center;padding:8vh 0}
.pill-dark{display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;border:1.5px solid var(--ink);border-radius:99px;padding:11px 20px;transition:background .3s,color .3s;color:var(--ink)}
.pill-dark:hover{background:var(--ink);color:var(--paper)}
.pill-light{display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;border:1.5px solid rgba(245,243,239,.6);border-radius:99px;padding:11px 20px;transition:background .3s,color .3s;color:var(--paper)}
.pill-light:hover{background:var(--paper);color:var(--ink)}

/* ELEMENT 11 · CTA hand-off band */
.cta{background:var(--struct);color:rgb(var(--on-rgb));padding:10vh 0}
.cta .in{display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap}
.cta .big{font-weight:var(--dispw);font-size:clamp(28px,4.2vw,60px);letter-spacing:-.03em;line-height:1;text-transform:uppercase;max-width:16ch}
.cta .ck{display:block;font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:rgba(var(--on-rgb),.7);margin-bottom:14px}
.cta .big .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none}
.cta a.talk{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;border:1.5px solid rgba(var(--on-rgb),.75);padding:16px 26px;border-radius:50%;transition:background .3s,color .3s,transform .3s;display:inline-block}
.cta a.talk:hover{background:rgb(var(--on-rgb));color:var(--struct);transform:scale(1.05)}

</style>
</head>
<body>

<div class="libhead">
  <div class="wrap">
    <span class="k mono">\ The kit · internal · not linked</span>
    <h1>Case-page <span class="serif">elements.</span></h1>
    <p>The single source of truth. Build new case pages by pulling elements from here; fix an element here first, then propagate. Every element rides the identity tokens, so the accent + type switcher (bottom center) previews the whole system on this one page.</p>
    <div class="kitctrl mono">
      <span class="kc-t">\ The controls</span>
      <button type="button" class="kc-p" id="kc-type">Type + accent switcher · <b>bottom-center pill ↓</b></button>
      <a href="#mlab" class="kc-p">Parallax / motion languages · <b>Element 13 ↓</b></a>
    </div>

    <!-- THE PRIVATE INDEX (DJ 2026-07-14). Everything pulled OUT of the public nav lives
         here, so he can still reach it from the menu (Menu -> The Kit) without a hiring
         manager stumbling into it. Pages are noindex'd; this is the only way in. -->
    <div class="privindex">
      <span class="pi-t mono">\ Off the nav · reachable only from here</span>
      <div class="pi-grid">
        <a class="pi-l" href="/photography"><b>Photography</b><span>the stills archive · pulled from nav</span></a>
        <a class="pi-l" href="/hire"><b>Hire · the one-page brief</b><span>the recruiter route</span></a>
        <a class="pi-l" href="/page-elements"><b>Page elements</b><span>the element library</span></a>
        <a class="pi-l" href="/page-template"><b>Page template</b><span>the reference flow</span></a>
        <a class="pi-l" href="/cta-preview"><b>CTA preview</b><span>TEMP · delete once a layout is locked</span></a>
        <a class="pi-l" href="/lab"><b>The lab · 26 pages</b><span>the draft graveyard</span></a>
      </div>
    </div>
  </div>
</div>

<div class="spec" id="el-statrow"><div class="wrap"><span class="id">ELEMENT 00 · BLOCK · StatRow</span><span class="use">the at-a-glance number band. Numbers count up EVERY time the band scrolls into view (resets when it scrolls back out, so scrolling past it again re-counts). Props: <b>stats</b> (a value + label each), <b>note</b>, <b>tone</b> (<code>accent</code>/<code>paper</code>/<code>ink</code> — pick per section to satisfy the sitewide light/dark alternation rule). Data below is real: the locked Art of Visuals stat row from docs/WORK-PAGES-COPY-HANDOFF.md, shown on all three grounds. <b class="lives">pull from:</b> StatRow.astro</span></div></div>
<p style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.5;max-width:var(--wrap);margin:0 auto;padding:20px var(--pad) 0">tone="accent" · default</p>
<StatRow tone="accent" stats={srStats} note={srNote} />
<p style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.5;max-width:var(--wrap);margin:0 auto;padding:20px var(--pad) 0">tone="paper" · light</p>
<StatRow tone="paper" stats={srStats} note={srNote} />
<p style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.5;max-width:var(--wrap);margin:0 auto;padding:20px var(--pad) 0">tone="ink" · dark</p>
<StatRow tone="ink" stats={srStats} note={srNote} />

<div class="spec" id="el-type"><div class="wrap"><span class="id">ELEMENT · TYPE SCALE · the copy rules</span><span class="use">one small, modern scale for the whole site. every header + paragraph pulls a token below — no page hard-codes its own size (that is what made every header a different size). section headers top out at <b>--fs-h2 · 31px</b>; only the hero goes big. <b class="lives">pull:</b> var(--fs-h2) / var(--fs-body) / etc. · defined in :root</span></div></div>
<section class="paper"><div class="wrap tsc">
  <div class="tsc-row"><span class="tsc-lbl mono">Display<br>--fs-display<br>hero title only</span><p class="tsc-ex" style="font-size:var(--fs-display)">Let's get started.</p></div>
  <div class="tsc-row"><span class="tsc-lbl mono">Statement<br>--fs-statement<br>one big line, rarely</span><p class="tsc-ex" style="font-size:var(--fs-statement)">The one big idea, stated plainly.</p></div>
  <div class="tsc-row"><span class="tsc-lbl mono">Section header<br>--fs-h2<br>the workhorse · ceiling</span><p class="tsc-ex" style="font-size:var(--fs-h2)">A section header at the workhorse size.</p></div>
  <div class="tsc-row"><span class="tsc-lbl mono">Sub-head<br>--fs-h3</span><p class="tsc-ex" style="font-size:var(--fs-h3)">A smaller sub-head.</p></div>
  <div class="tsc-row"><span class="tsc-lbl mono">Lead<br>--fs-lead<br>first line of a section</span><p class="tsc-ex tsc-body" style="font-size:var(--fs-lead)">The lead paragraph sits a touch larger than body, to open a section.</p></div>
  <div class="tsc-row"><span class="tsc-lbl mono">Body<br>--fs-body</span><p class="tsc-ex tsc-body" style="font-size:var(--fs-body)">Body copy at a readable measure. This is the default for every paragraph across the site, and it does not change from page to page.</p></div>
  <div class="tsc-row"><span class="tsc-lbl mono">Caption<br>--fs-cap</span><p class="tsc-ex tsc-body" style="font-size:var(--fs-cap)">Captions, footnotes, and small print.</p></div>
  <div class="tsc-row"><span class="tsc-lbl mono">Mono<br>--fs-mono</span><p class="tsc-ex mono" style="font-size:var(--fs-mono)">Kickers · meta · labels</p></div>
</div></section>

<section class="decide" id="decide-first">
  <div class="wrap">
    <span class="dec-k mono">🔴 Decide first</span>
    <h2>Your calls, up <span class="serif">top.</span></h2>
    <p class="dec-sub">The open decisions, each linked to the element it lives in. Make the call once here and it rolls out sitewide.</p>
    <ol class="dec-list">
      <li><a href="#el-headerslider"><b>Work headers.</b> Static (01B, oval vs underline) or the <u>slider</u>? Approve the 01C service colors. <span class="dec-go">01B / 01C / 24 ↓</span></a></li>
      <li><a href="#el-workview"><b>Work index.</b> Keep the grid, or switch to the <u>varied-size hover view</u>? <span class="dec-go">29 ↓</span></a></li>
      <li><a href="#el-masonry"><b>Galleries.</b> Contact sheet or <u>masonry + lightbox</u>, per page. <span class="dec-go">15 / 26 ↓</span></a></li>
      <li><a href="#el-kicker"><b>Kickers + CTA.</b> Pick a headline + a CTA style (incl the circled one), light or dark. <span class="dec-go">27 ↓</span></a></li>
      <li><a href="#el-insight"><b>Insight.</b> Design locked (editorial). Send the one-line insight for each case page and I'll wire them. <span class="dec-go">31 ↓</span></a></li>
      <li><a href="#acctool"><b>Type + accent.</b> Pick the pairing and confirm B/W, then I bake it and delete the switcher. <span class="dec-go">pill ↓</span></a></li>
      <li><b>Testimonials.</b> Send the real quotes for the 10 names and I drop them in. <span class="dec-go">09 ↓</span></li>
    </ol>
  </div>
</section>

<div class="spec" id="el-blocks"><div class="wrap"><span class="id">ELEMENT 00 · LAYOUT BLOCKS · the pull-from set</span><span class="use">the composable primitives — build any page section by stacking these, no bespoke markup, nothing to break. Six named blocks: <b>PageHero</b> (page-top) · <b>StatRow</b> (number band) · <b>TextBlock</b> (copy, <u>default</u>/<u>statement</u>) · <b>MediaBlock</b> (images, <u>full</u>/<u>duo</u>/<u>trio</u>/<u>stack</u>) · <b>QuoteBlock</b> (pull quote) · <b>CtaBlock</b> (closer). Each is demoed below. Alternate text and media for rhythm. <b class="lives">full page assembled from them:</b> /page-template · <b class="lives">shipping on:</b> flashpoint, rolling to every work page</span></div></div>

<TextBlock variant="statement" kicker="\ TextBlock · statement" heading={`Big and punchy, for openers and <span class="tb-serif">closers.</span>`}>
  <p>The statement variant carries a large headline and a short lede. Use it to open or close a page, or to land a single idea hard.</p>
</TextBlock>
<MediaBlock layout="duo" images={[
  { src: "/case-studies/flashpoint/gallery/fp-01.jpg", alt: "MediaBlock duo demo, left", caption: "MediaBlock · duo · 2-up" },
  { src: "/case-studies/flashpoint/gallery/fp-02.jpg", alt: "MediaBlock duo demo, right", caption: "MediaBlock · duo · 2-up" }
]} />
<TextBlock kicker="\ TextBlock · default" heading={`Kicker, heading, and copy at a <span class="tb-serif">readable measure.</span>`}>
  <p>The default variant is the workhorse for body copy. Drop in one paragraph or five and it stays clean, never stranding a headline or blowing out the layout.</p>
  <p>Put a MediaBlock above or below it and you have a section with rhythm.</p>
</TextBlock>
<MediaBlock layout="full" images={[{ src: "/case-studies/flashpoint/gallery/fp-03.jpg", alt: "MediaBlock full-bleed demo", caption: "✳ MediaBlock · full · edge-to-edge banner" }]} />

<div class="spec" id="el-hero"><div class="wrap"><span class="id">ELEMENT 00 · BLOCK · PageHero</span><span class="use">the page-top hero: background image + dark scrim + big title (serif accent line) + RoleTag + a case-file kicker bottom-left and an NFO block bottom-right. Props: <b>image, title, kicker, role, nfo[], nfoHead, height</b>. No fragile JS. <b class="lives">pull from:</b> PageHero.astro · assembled on /page-template</span></div></div>
<PageHero
  image="/case-studies/flashpoint/gallery/fp-03.jpg"
  title={`PageHero block, <span class="serif">named + safe.</span>`}
  kicker={`<b>\\ Case file</b><br>Client · Project name<br>Discipline · Year`}
  role="creative direction · your role"
  nfoHead="NFO"
  nfo={["Client · Name", "Role · Your role", "Frame · MC-0000-00"]}
  height="60svh"
/>

<div class="spec" id="el-quoteblock"><div class="wrap"><span class="id">ELEMENT 00 · BLOCK · QuoteBlock</span><span class="use">a pull quote + attribution, serif italic with an optional <code>&lt;b&gt;</code> display emphasis. Props: <b>quote, who, tone</b> (accent / paper / ink). <b class="lives">pull from:</b> QuoteBlock.astro</span></div></div>
<QuoteBlock quote={`The line that <b>sums it up</b>, in one sentence.`} who="What the quote is" tone="paper" />

<div class="spec" id="el-ctablock"><div class="wrap"><span class="id">ELEMENT 00 · BLOCK · CtaBlock</span><span class="use">the closing call-to-action band: kicker + big heading + a pill button that hovers to red. Defaults to the locked "Let's talk" CTA. Props: <b>kicker, heading, href, label</b>. <b class="lives">pull from:</b> CtaBlock.astro</span></div></div>
<CtaBlock heading={`Let's build something <span class="serif">worth remembering.</span>`} />

<div class="spec" id="el-01"><div class="wrap"><span class="id">ELEMENT 01 · CASE HERO</span><span class="use">70svh image hero · 3-line title, serif accent line last · kck bottom-left, NFO bottom-right · RoleTag under title · VIDEO VARIANT: dim poster + hero loop that fades in only on the real PLAYING state (see on-camera / sony-xm5) · <b class="lives">lives on:</b> most work pages</span></div></div>
<header class="hero">
  <img src="/case-studies/art-of-visuals/msi/msi-08.jpg" alt="Specimen hero image: the Camaro at golden hour, MSI shoot">
  <div class="scrim" aria-hidden="true"></div>
  <div class="t">
    <span class="ln"><span>Headline line,</span></span>
    <span class="ln"><span><span class="serif">payoff</span><span class="spark">.</span></span></span>
    <RoleTag text="what I did on this one" />
  </div>
  <div class="kck"><b>\ Case file</b><br>Client · The project in one line<br>Discipline · Discipline · Year</div>
  <div class="nfo"><span class="h">NFO</span><br>Client · Name<br>Role · Creative Director<br>Frame · MC-20XX-XX</div>
</header>

<div class="spec" id="el-01b"><div class="wrap"><span class="id">ELEMENT 01B · CASE HERO · THE OLD-SITE CUT</span><span class="use">DJ's preferred header (2026-07-12) · giant left sans + REAL client logo + a hand-drawn annotation that DRAWS ON and carries a service COLOR · A = with the blurb, B = without · A shows the oval, B shows the double-underline · service→color map in 01C below · this rolls to every work page once DJ picks · <b class="lives">lives on:</b> proposed for work headers</span></div></div>
<!-- A · with blurb · oval annotation -->
<header class="herob" data-annot="oval">
  <img loading="lazy" decoding="async" src="/case-studies/sony-xperia-summer/gallery/xp-02.jpg" alt="Specimen hero image">
  <div class="hb-in wrap">
    <span class="hb-ver mono">A · with blurb · circled</span>
    <h1>Summer<br>with<br>Xperia</h1>
    <div class="hb-role">
      <img class="hb-logoimg" src="/logos/sony.png" alt="Sony">
      <span class="hb-scrib" style="--annot:#E0311A">
        <svg class="hb-oval" viewBox="0 0 280 88" aria-hidden="true" preserveAspectRatio="none"><path pathLength="1" d="M30,54 C15,28 76,13 152,13 C230,13 270,28 259,52 C251,72 189,82 118,79 C56,77 20,66 21,45 C22,31 43,21 68,18" /></svg>
        <i class="serif">directing, photo + strategy</i>
      </span>
    </div>
    <p class="hb-blurb">Three summers of Sony Xperia launches. I led directing, stills, and strategy across every drop, from the Porsche film to the boardwalk cut.</p>
  </div>
</header>
<!-- B · no blurb · double-underline annotation -->
<header class="herob" data-annot="uline">
  <img loading="lazy" decoding="async" src="/case-studies/sony-flow-state/gallery/fs-05.jpg" alt="Specimen hero image">
  <div class="hb-in wrap">
    <span class="hb-ver mono">B · no blurb · double-underlined</span>
    <h1>Flow<br>State</h1>
    <div class="hb-role">
      <img class="hb-logoimg" src="/logos/sony.png" alt="Sony">
      <span class="hb-scrib hb-uline" style="--annot:#2FB8A0">
        <i class="serif">strategy, creative direction</i>
        <svg class="hb-under" viewBox="0 0 260 24" aria-hidden="true" preserveAspectRatio="none">
          <path class="u1" pathLength="1" d="M5,9 C58,4 118,13 176,7 C214,3 244,10 255,8"/>
          <path class="u2" pathLength="1" d="M7,18 C66,14 128,21 188,15 C220,12 248,18 253,17"/>
        </svg>
      </span>
    </div>
  </div>
</header>

<div class="spec" id="el-01c"><div class="wrap"><span class="id">ELEMENT 01C · SERVICE COLORS</span><span class="use">the annotation color = the service I provided · this is my PROPOSED map, you decide · swap any swatch and it drives the 01B annotation sitewide · <b class="lives">lives on:</b> drives the 01B annotation color</span></div></div>
<section class="paper svcsec">
  <div class="wrap">
    <div class="svcgrid">
      <span class="svc" style="--c:#E0311A"><i></i>Creative Direction</span>
      <span class="svc" style="--c:#FF6A1A"><i></i>Commercial Directing</span>
      <span class="svc" style="--c:#2438E8"><i></i>Photography</span>
      <span class="svc" style="--c:#7B3FE4"><i></i>Campaign Development</span>
      <span class="svc" style="--c:#E0A21A"><i></i>Experiential</span>
      <span class="svc" style="--c:#17B8A2"><i></i>Editing + Animation</span>
      <span class="svc" style="--c:#2FB8A0"><i></i>Brand Development</span>
      <span class="svc" style="--c:#EFA1AD"><i></i>Design</span>
      <span class="svc" style="--c:#3E6E94"><i></i>Strategy</span>
      <span class="svc" style="--c:#D6217A"><i></i>On-camera</span>
      <span class="svc" style="--c:#8f8d88"><i></i>Consulting</span>
    </div>
  </div>
</section>

<div class="spec" id="el-02"><div class="wrap"><span class="id">ELEMENT 02 · STATROW · the one bar</span><span class="use">The single bar at the top of every work page (19/19). Pull the <b>StatRow</b> component — value + label cells, optional right-aligned note, numbers count up on scroll-in. Default tone <b>paper</b> so it reads light under the dark header. <b class="lives">lives on:</b> all 19 work pages · the role/credits bar was killed 2026-07-14, credits live in the Call Sheet</span></div></div>
<StatRow tone="paper"
  stats={[{ value: 'Big', label: 'What it counts' }, { value: '04', label: 'Another count' }, { value: '20K+', label: 'A third count' }]}
  note="One supporting line with <b>the emphasis</b> inline"
/>
<div class="spec" id="el-03"><div class="wrap"><span class="id">ELEMENT 03 · THE BRIEF</span><span class="use">Paper ground · kicker + display h2 + services list left, body right · first paragraph is the lede size · <b class="lives">lives on:</b> every work page</span></div></div>
<section class="paper">
  <div class="wrap story">
    <div class="side">
      <span class="k mono">\ The brief</span>
      <h2>What this project was, in one <span class="serif">line.</span></h2>
      <ul class="svc"><li><i>✳</i>Service one</li><li><i>✳</i>Service two</li><li><i>✳</i>Service three</li></ul>
    </div>
    <div class="body">
      <p>The lede paragraph: client, context, and DJ's role, scoped honestly. If through an agency, say so here.</p>
      <p>The supporting paragraph carries the objective once. It does not repeat later; later sections reference it.</p>
    </div>
  </div>
</section>

<div class="spec" id="el-04"><div class="wrap"><span class="id">ELEMENT 04 · CHAPTER HEAD</span><span class="use">White ground · numbered fhead on a 2px rule: mono number, display title, right tag, dek · numbers tie back to the brief's index · <b class="lives">lives on:</b> dw-drums · flashpoint · msi</span></div></div>
<section class="white front">
  <div class="wrap">
    <div class="fhead">
      <span class="fn">01</span>
      <h3>The chapter <span class="serif">title.</span></h3>
      <span class="tag">Front 01 · What this chapter is</span>
      <p class="dek">One line on what this chapter shows and why it mattered.</p>
    </div>

    <div class="spec" id="el-05" style="background:none;border:none;padding:0 0 12px"><span class="id">ELEMENT 05 · PLATES</span>&nbsp;&nbsp;<span class="use">duo grid · .off offset wide · .doc hairline for white documents · mono caption under-left</span></div>
    <div class="duo">
      <figure class="pl"><img loading="lazy" decoding="async" src="/case-studies/flashpoint/gallery/fp-01.jpg" alt="Placeholder plate"><figcaption class="cap"><b>COMP-01</b> · What this frame is</figcaption></figure>
      <figure class="pl"><img loading="lazy" decoding="async" src="/case-studies/flashpoint/gallery/fp-02.jpg" alt="Placeholder plate"><figcaption class="cap"><b>COMP-02</b> · What this frame is</figcaption></figure>
    </div>

    <div class="spec" id="el-07" style="background:none;border:none;padding:26px 0 12px"><span class="id">ELEMENT 07 · BROWSER FRAME</span>&nbsp;&nbsp;<span class="use">for live sites and web work · url pill center · caption below like any plate</span></div>
    <figure class="pl">
      <div class="browser">
        <div class="bbar"><i></i><i></i><i></i><span class="burl">example.com</span></div>
        <img loading="lazy" decoding="async" src="/case-studies/flashpoint/site/web-hero.jpg" alt="Placeholder website capture">
      </div>
      <figcaption class="cap"><b>WEB-01</b> · The live site · Captured when</figcaption>
    </figure>
  </div>
</section>

<div class="spec" id="el-06"><div class="wrap"><span class="id">ELEMENT 06 · FULL-BLEED BREAK</span><span class="use">between chapters · parallax on the real pages · centered mono caption chip · <b class="lives">lives on:</b> most work pages</span></div></div>
<div class="break">
  <img loading="lazy" decoding="async" src="/case-studies/flashpoint/gallery/fp-08.jpg" alt="Placeholder break image">
  <span class="cap">✳ The break caption · context in one line</span>
</div>

<div class="spec" id="el-08"><div class="wrap"><span class="id">ELEMENT 08 · QUOTE BAND</span><span class="use">the system in one line · spark ground (flips to ink automatically in B/W mode) · serif italic + display bold emphasis · <b class="lives">lives on:</b> most work pages</span></div></div>
<section class="quote">
  <div class="wrap">
    <p class="q">"The whole project summed up in one serif line with <b>the bold bit</b> carrying the point."</p>
    <p class="who mono">Who said it, or what this line is</p>
  </div>
</section>

<div class="spec" id="el-09"><div class="wrap"><span class="id">ELEMENT 09 · TESTIMONIAL CARD</span><span class="use">ink ground · serif quote, name + role, chip while the quote is pending · NEVER fabricate a quote under a real name · <b class="lives">lives on:</b> capabilities + home (Testimonials.astro)</span></div></div>
<div class="tstwrap"><div class="wrap">
  <figure class="tst-card">
    <p class="tst-q"><span class="tst-ph">&ldquo;&nbsp;&hellip;&nbsp;&rdquo;</span></p>
    <figcaption><span class="tst-n">Name Here</span><span class="tst-r">Role · Project</span><span class="tst-chip">quote incoming</span></figcaption>
  </figure>
</div></div>

<div class="spec" id="el-10"><div class="wrap"><span class="id">ELEMENT 10 · PILLS</span><span class="use">mono uppercase, radius 99 · dark-on-light and light-on-dark variants · arrows for outbound · <b class="lives">lives on:</b> sitewide</span></div></div>
<section class="paper"><div class="wrap pillrow">
  <a class="pill-dark" href="#top">Pill on light ↗</a>
  <span style="background:var(--ink);border-radius:8px;padding:14px 18px;display:inline-flex"><a class="pill-light" href="#top">Pill on dark ↗</a></span>
</div></section>

<div class="spec" id="el-12"><div class="wrap"><span class="id">ELEMENT 12 · CALL SHEET</span><span class="use">credits slip · agency + client + collaborators + DJ's row marked select · keep roles truthful · <b class="lives">lives on:</b> every work page (CallSheet.astro)</span></div></div>
<section class="paper"><div class="wrap credits">
  <CallSheet code="MC-20XX-XX" sub="Client · Project · Scope" filed="MMXX" tone="light"
    rows={[
      { k: 'Client', v: 'Name' },
      { k: 'Collaborator', v: 'Name · role' },
      { k: 'Creative Direction', v: 'DJ Ramirez', select: true },
    ]} />
</div></section>

<div class="spec" id="el-11"><div class="wrap"><span class="id">ELEMENT 11 · CTA BAND</span><span class="use">the hand-off · accent ground, text rides --on-rgb · round talk button · <b class="lives">lives on:</b> work-page closers</span></div></div>
<section class="cta">
  <div class="wrap in">
    <div>
      <span class="ck mono">✳ Being forgettable is expensive</span>
      <p class="big">Let's build something<br><span class="serif">worth remembering.</span></p>
    </div>
    <a class="talk" href="/contact">Let's talk ↗</a>
