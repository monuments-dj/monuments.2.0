<style is:global>
/* ELEMENT 22 · word switcher (shared grammar with Turnstile's Concept/Design/Deliver) */
.cdd{padding:11vh 0}
.cdd-head{display:flex;gap:clamp(20px,3.4vw,54px);flex-wrap:wrap;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:18px}
.cdd-word{position:relative;background:none;border:0;padding:0 0 6px;cursor:pointer;font-family:var(--disp);font-weight:var(--dispw);font-size:clamp(30px,5.2vw,74px);letter-spacing:-.035em;line-height:1;text-transform:uppercase;color:rgba(22,21,20,.15);transition:color .5s cubic-bezier(.22,1,.36,1)}
.cdd-word.on{color:var(--ink)}
.cdd-word .cdd-bar{position:absolute;left:0;bottom:-19px;height:2px;width:0;background:var(--red);transition:none}
.cdd-word.on .cdd-bar{width:100%;transition:width 4.6s linear}
.cdd-stage{margin-top:6vh;display:grid}
.cdd-panel{grid-area:1/1;display:grid;grid-template-columns:1fr 1fr;gap:44px 64px;opacity:0;transform:translateY(16px);pointer-events:none;transition:opacity .6s cubic-bezier(.22,1,.36,1),transform .6s cubic-bezier(.22,1,.36,1)}
.cdd-panel.on{opacity:1;transform:none;pointer-events:auto}
.cdd-col p{color:#4c4a45;font-size:clamp(15px,1.15vw,17px);line-height:1.62;margin-bottom:1em}
.cdd-col p b{color:var(--ink);font-weight:var(--dispw2)}
.cdd-col p:first-child{font-size:clamp(16px,1.3vw,19px);color:var(--ink)}
@media (max-width:820px){.cdd-panel{grid-template-columns:1fr;gap:20px;opacity:1;transform:none;pointer-events:auto;display:none}.cdd-panel.on{display:grid}}
@media (prefers-reduced-motion:reduce){.cdd-word .cdd-bar{transition:none}}
</style>
<script is:inline>
// 01B header annotations draw on when each header enters view
(function(){
  var heads=[].slice.call(document.querySelectorAll('.herob'));if(!heads.length)return;
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('drawn');io.unobserve(e.target);}});},{threshold:.35});
  heads.forEach(function(h){io.observe(h);});
})();
// Kit controls callout: clicking "type switcher" scrolls to + pulses the pill
(function(){
  var btn=document.getElementById('kc-type');if(!btn)return;
  btn.addEventListener('click',function(){
    var t=document.getElementById('acctool');if(!t)return;
    t.style.display='';t.scrollIntoView({block:'end',behavior:'smooth'});
    t.classList.remove('pulse');void t.offsetWidth;t.classList.add('pulse');
  });
})();
(function(){
  var sec=document.getElementById('cddkit');if(!sec)return;
  var reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var words=[].slice.call(sec.querySelectorAll('.cdd-word')),
      panels=[].slice.call(sec.querySelectorAll('.cdd-panel')),cur=0,timer=null,vis=false,paused=false;
  function show(i){cur=(i+panels.length)%panels.length;
    words.forEach(function(w,j){w.classList.toggle('on',j===cur);});
    panels.forEach(function(p,j){p.classList.toggle('on',j===cur);});sec.setAttribute('data-i',cur);}
  function arm(){if(timer||reduced)return;timer=setInterval(function(){if(vis&&!paused)show(cur+1);},4600);}
  function disarm(){clearInterval(timer);timer=null;}
  words.forEach(function(w,i){w.addEventListener('click',function(){disarm();show(i);arm();});});
  sec.addEventListener('mouseenter',function(){paused=true;});
  sec.addEventListener('mouseleave',function(){paused=false;});
  new IntersectionObserver(function(es){es.forEach(function(e){vis=e.isIntersecting;vis?arm():disarm();});},{threshold:.2}).observe(sec);
})();
</script>

