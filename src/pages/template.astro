<script is:inline>
// ELEMENT 29 work index: expanded hover preview off to the side (autoplays the work's video)
(function(){
  var grid=document.getElementById('wvGrid'), panel=document.getElementById('wvPreview');
  if(!grid||!panel) return;
  if(window.matchMedia && matchMedia('(hover:none)').matches) return;
  var pImg=panel.querySelector('.wvp-img'), pVid=panel.querySelector('.wvp-vid'),
      pLogo=panel.querySelector('.wvp-logo'), pTitle=panel.querySelector('.wvp-title'),
      pRole=panel.querySelector('.wvp-role'), pBlurb=panel.querySelector('.wvp-blurb');
  function place(tile){
    var r=tile.getBoundingClientRect(), W=panel.offsetWidth, H=panel.offsetHeight;
    var preferRight=(r.left+r.width/2)<window.innerWidth/2;
    var left=preferRight? r.right+16 : r.left-W-16;
    left=Math.max(12, Math.min(left, window.innerWidth-W-12));
    var top=Math.min(Math.max(r.top,12), window.innerHeight-H-12);
    panel.style.left=left+'px'; panel.style.top=top+'px';
  }
  function show(t){
    var d=t.dataset;
    pImg.src=d.img||''; pTitle.textContent=d.title||''; pRole.textContent=d.role||''; pBlurb.textContent=d.blurb||'';
    if(d.logo){ pLogo.src=d.logo; pLogo.style.display='block'; pLogo.classList.toggle('is-color', d.logocolor==='1'); } else { pLogo.removeAttribute('src'); pLogo.style.display='none'; }
    if(d.vid){ if(pVid.getAttribute('src')!==d.vid){ pVid.setAttribute('src', d.vid); } panel.classList.add('playing'); var pr=pVid.play(); if(pr&&pr.catch)pr.catch(function(){}); }
    else { panel.classList.remove('playing'); pVid.removeAttribute('src'); }
    panel.classList.add('on'); panel.setAttribute('aria-hidden','false');
    place(t);
  }
  function hide(){ panel.classList.remove('on'); panel.setAttribute('aria-hidden','true'); try{pVid.pause();}catch(e){} }
  [].slice.call(grid.querySelectorAll('.wtile')).forEach(function(t){
    t.addEventListener('mouseenter', function(){ show(t); });
  });
  grid.addEventListener('mouseleave', hide);
  window.addEventListener('scroll', function(){ if(panel.classList.contains('on')) hide(); }, {passive:true});
})();
</script>

