<script is:inline>
/* ELEMENT 31 insight: parallax drift on the mark + staggered line reveal on scroll-in */
(function(){
  var sec=document.getElementById('el-insight'); if(!sec) return;
  var reduce=window.matchMedia && matchMedia('(prefers-reduced-motion:reduce)').matches;
  // reveal
  if(reduce){ sec.classList.add('in'); }
  else {
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){sec.classList.add('in');io.disconnect();}});},{threshold:.35});
    io.observe(sec);
  }
  // parallax
  if(reduce) return;
  var items=[].slice.call(sec.querySelectorAll('[data-parallax]')); if(!items.length) return;
  var tick=false;
  function update(){
    var vh=window.innerHeight||document.documentElement.clientHeight;
    items.forEach(function(el){
      var r=el.getBoundingClientRect(); var mid=r.top+r.height/2;
      var f=parseFloat(el.getAttribute('data-parallax'))||0;
      el.style.setProperty('--py', ((mid-vh/2)*f).toFixed(1)+'px');
    });
    tick=false;
  }
  function onScroll(){ if(!tick){ tick=true; requestAnimationFrame(update); } }
  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll, {passive:true});
  update();
})();
</script>

