  .mnav{display:flex;position:fixed;inset:0;z-index:80;background:var(--ink);flex-direction:column;justify-content:center;gap:2px;padding:0 var(--pad);transform:translateY(-100%);transition:transform .55s cubic-bezier(.76,0,.24,1)}
  #navtog:checked ~ .mnav{transform:none}
  .mnav a{font-family:var(--disp);font-weight:var(--dispw);font-size:clamp(34px,12vw,58px);line-height:1.05;text-transform:uppercase;letter-spacing:-.02em;color:var(--paper)}
  .mnav a:active{color:var(--spark)}
  .mnav .mnav-foot{margin-top:26px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim)}
}

/* CTA band — Kit ELEMENT 11, the hand-off after the archive */
.cta{background:var(--struct);color:rgb(var(--on-rgb));padding:10vh 0}
.cta .in{display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap}
.cta .big{font-weight:var(--dispw);font-size:clamp(28px,4.2vw,60px);letter-spacing:-.03em;line-height:1;text-transform:uppercase;max-width:16ch;margin:0}
.cta .ck{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:rgba(var(--on-rgb),.7);margin-bottom:14px}
.cta .big .serif{font-family:var(--serif,'Instrument Serif',serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:-.01em}
.cta a.talk{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;border:1.5px solid rgba(var(--on-rgb),.75);padding:16px 26px;border-radius:50%;transition:background .3s,color .3s,transform .3s;display:inline-block;color:rgb(var(--on-rgb))}
.cta a.talk:hover{background:rgb(var(--on-rgb));color:var(--struct);transform:scale(1.05)}
/* footer under-reveal: .over slides over a fixed .underfoot as you hit the bottom */
.over{position:relative;z-index:1;background:inherit}
.underfoot{position:fixed;left:0;right:0;bottom:0;z-index:0}
@media (max-width:900px),(prefers-reduced-motion:reduce){.underfoot{position:static}.over{margin-bottom:0!important}}

/* HERO EASE (DJ 2026-07-14: "fade works. ship"). The masked RISE is replaced by a plain
   fade sitewide. !important is deliberate: each page declares its own
   `.hero .t .ln>span` / `.hero h1 .ln>span` rule at HIGHER specificity than any
   override I can append here, so this is the only way it lands without rewriting seven
   separate hero blocks. The .ln mask keeps its descender padding - that is the standing
   rule and it must survive even though it no longer hides a rise. */
@keyframes heroFade{from{opacity:0}to{opacity:1}}
.hero .ln>span{transform:none!important;opacity:0;animation:heroFade .9s ease-out forwards!important}
.hero .ln:nth-child(1)>span{animation-delay:.08s!important}
.hero .ln:nth-child(2)>span{animation-delay:.20s!important}
@media (prefers-reduced-motion:reduce){.hero .ln>span{animation:none!important;opacity:1!important}}
</style>
