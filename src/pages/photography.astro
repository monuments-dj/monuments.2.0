  if(!c||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let k=false;
  addEventListener('scroll',()=>{if(k)return;k=true;requestAnimationFrame(()=>{
    c.style.transform=`translateY(${(Math.sin(scrollY/420)*34).toFixed(1)}px) rotate(${(scrollY*0.22).toFixed(1)}deg)`;k=false})},{passive:true});
})();
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});var el=document.getElementById('clock');if(el)el.textContent='LA '+t;}
clock();setInterval(clock,30000);

(function(){
  // ⚠️ TODO (DJ): placeholder mapping, 20 frames per roll by id. Swap for the real
  // photo-to-category sort when DJ delivers it; only c.ids below needs to change.
  const CHUNK=20;
  const CATS=[
    {name:'Brand',blurb:'Product, campaign, and launch frames. The photos brands hire for.'},
    {name:'Editorial',blurb:'People and places, told straight. Portraits and stories on location.'},
    {name:'Food',blurb:'Plates, kitchens, and the hands that make them.'},
    {name:'Motion',blurb:'Stills from moving work. Sets, behind the scenes, the frames between takes.'},
    {name:'Non-Profit',blurb:'Stories for causes. Some stories are not for sale.'}
  ];
  const slug=n=>n.toLowerCase().replace(/[^a-z]+/g,'-');
  CATS.forEach((c,i)=>{c.ids=Array.from({length:CHUNK},(_,k)=>String(i*CHUNK+k+1).padStart(3,'0'))});
  const FOLDERS=[{
    key:'all',name:'The full archive',tab:'Full archive',counter:'ARCHIVE',
    num:'One hundred',word:'frames',roll:'ROLLS 01-05',
    blurb:'Everything, newest first. Five rolls spliced into one long reel.',
    ids:CATS.reduce((a,c)=>a.concat(c.ids),[])
  }].concat(CATS.map((c,i)=>({
    key:slug(c.name),name:c.name,tab:c.name,counter:c.name.toUpperCase(),
    num:'Twenty',word:'frames of '+c.name.toLowerCase(),roll:'ROLL 0'+(i+1),
    blurb:c.blurb,ids:c.ids
  })));
  const byKey={};FOLDERS.forEach(f=>{byKey[f.key]=f});
  const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
  const row=document.getElementById('ftabs'),grid=document.getElementById('strips'),
        num=document.getElementById('rollNum'),word=document.getElementById('rollWord'),
        fpath=document.getElementById('fpath'),fblurb=document.getElementById('fblurb'),
        stCount=document.getElementById('stCount'),stSize=document.getElementById('stSize');

  // build the tab row: six simple switchable tabs on the folder's top edge
  row.innerHTML=FOLDERS.map(f=>
    '<button class="ftab" type="button" role="tab" aria-selected="false" data-key="'+f.key+'"'+
    ' aria-label="Open the '+f.name+' tab, '+f.ids.length+' frames">'+f.tab+' · '+f.ids.length+'</button>').join('');
  const tabs=[...row.children];

  let active=null,firstPick=true;
  function swapHero(f){
    num.textContent=f.num;word.textContent=f.word;
    if(reduce||firstPick)return;
    [num,word].forEach(el=>{el.classList.remove('swap');void el.offsetWidth;el.classList.add('swap')});
  }
  function renderMeta(f){
    fpath.textContent='Monuments HD : Archive'+(f.key==='all'?'':' : '+f.counter.replace(/\s+/g,' '));
    fblurb.textContent=f.blurb;
    stCount.textContent=f.ids.length+' object(s)';
    stSize.textContent=(f.ids.length*2.135).toFixed(1)+' MB';
  }
  // split a roll into film strips of ~10 frames; each reel runs wider than its viewport
  function chunks(ids,target){
    const n=ids.length,k=Math.max(1,Math.round(n/target)),out=[];
    let i=0;
    for(let s=0;s<k;s++){const size=Math.ceil((n-i)/(k-s));out.push(ids.slice(i,i+size));i+=size}
    return out;
  }
  function frameHTML(set,f,clone){
    return set.map(id=>
      '<figure class="fr" data-id="'+id+'" data-full="/gallery/full/p-'+id+'.jpg"'+
        (clone?' data-clone="1" aria-hidden="true"':' tabindex="0" aria-label="Open frame '+id+'"')+'>'+
        '<img src="/gallery/thumb/p-'+id+'.jpg" alt="'+(clone?'':f.name+' frame '+id)+'" loading="lazy" onerror="this.closest(\'.fr\').remove()">'+
        '<figcaption class="cap">FR-'+id+'</figcaption>'+
      '</figure>').join('');
  }
  function renderStrips(f){
    const holes=Math.ceil((grid.clientWidth||innerWidth)/24)+6;
    const holeRow='<span class="sprk" aria-hidden="true">'+'<i></i>'.repeat(holes)+'</span>';
    // pan-capable strips get a hidden second copy of the set so the loop wraps seamlessly
    const canPan=!reduce&&matchMedia('(min-width:761px)').matches;
    grid.innerHTML=chunks(f.ids,10).map((set,s)=>
      '<div class="strip" style="animation-delay:'+(reduce?0:Math.min(s*30,240))+'ms">'+holeRow+
        '<div class="frames"><div class="reel">'+frameHTML(set,f,false)+(canPan?frameHTML(set,f,true):'')+'</div></div>'+
        holeRow+
        '<span class="stock" aria-hidden="true">MNMTS 400 · '+f.roll+'</span>'+
      '</div>').join('');
    // real aspect ratios once each thumb reports in; frame widths follow, reels stay natural
    grid.querySelectorAll('.fr img').forEach(im=>{
      const fit=()=>{const fig=im.closest('.fr');if(fig&&im.naturalWidth&&im.naturalHeight)fig.style.setProperty('--r',(im.naturalWidth/im.naturalHeight).toFixed(4))};
      if(im.complete)fit();else im.addEventListener('load',fit,{once:true});
    });
    bindPan();
  }
  // hover-advance: while the pointer rests on a strip, pan its reel like film
  // pulling through a gate; ping-pong at both ends, freeze on leave, resume on
  // re-hover. Position + direction live on the strip element so state survives.
  function bindPan(){
    if(reduce)return;
    grid.querySelectorAll('.strip').forEach(st=>{
      const vp=st.querySelector('.frames'),reel=st.querySelector('.reel');
      if(!vp||!reel)return;
      const pan=st._pan={x:0,v:0,loop:0,raf:0,last:0,hov:false};
      const SPEED=45; /* slow projector pace, one direction, forever */
      const apply=()=>{reel.style.transform='translate3d('+(-pan.x).toFixed(2)+'px,0,0)'};
      const tick=t=>{
        const dt=Math.min((t-pan.last)/1000,.05);pan.last=t;
        pan.v+=((pan.hov?SPEED:0)-pan.v)*Math.min(1,dt*5); /* ease up / roll to a stop */
        if(pan.loop>2&&pan.v>.3){
          pan.x+=pan.v*dt;
          if(pan.x>=pan.loop)pan.x-=pan.loop; /* seamless wrap: one set has passed */
          apply();
        }
        if(!pan.hov&&pan.v<.3){pan.raf=0;return}
        pan.raf=requestAnimationFrame(tick);
      };
      st.addEventListener('mouseenter',()=>{
        if(matchMedia('(max-width:760px)').matches)return;
        pan.hov=true;
        const fc=reel.querySelector('[data-clone]');
        pan.loop=fc?fc.offsetLeft:0; /* the loop period, measured once per hover */
        if(pan.loop&&pan.x>=pan.loop)pan.x%=pan.loop;
        if(!pan.raf){pan.last=performance.now();pan.raf=requestAnimationFrame(tick)}
      });
      st.addEventListener('mouseleave',()=>{pan.hov=false});
      // keyboard: browsers scroll hidden-overflow viewports to reveal focus;
      // fold that into the pan position so the reel and the focus ring agree
      st.addEventListener('focusin',e=>{
        const fig=e.target.closest&&e.target.closest('.fr');
        if(!fig||matchMedia('(max-width:760px)').matches)return;
        vp.scrollLeft=0;
        const max=Math.max(0,reel.offsetWidth-vp.clientWidth);
        pan.x=Math.max(0,Math.min(max,fig.offsetLeft-(vp.clientWidth-fig.offsetWidth)/2));
        apply();
      });
    });
  }
  function select(key,setHash){
    const f=byKey[key]||byKey.all;
    if(active===f)return;
    active=f;
    tabs.forEach(b=>{const on=b.dataset.key===f.key;b.classList.toggle('on',on);b.setAttribute('aria-selected',on?'true':'false')});
    swapHero(f);renderMeta(f);renderStrips(f);
    if(setHash!==false)history.replaceState(null,'','#'+f.key);
    firstPick=false;
  }
  row.addEventListener('click',e=>{const b=e.target.closest('.ftab');if(b)select(b.dataset.key)});
  // hero desktop icons: same select(), then ride down to the folder
  const goFolder=document.querySelector('.folderzone');
  document.querySelectorAll('.dicon').forEach(b=>b.addEventListener('click',()=>{
    select(b.dataset.goto);
    if(!goFolder)return;
    if(window.lenis&&window.lenis.scrollTo)window.lenis.scrollTo(goFolder);
    else goFolder.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});
  }));
  addEventListener('hashchange',()=>{const k=location.hash.slice(1).toLowerCase();if(byKey[k])select(k,false)});
  let rzT=0,rzW=innerWidth;
  addEventListener('resize',()=>{clearTimeout(rzT);rzT=setTimeout(()=>{
    if(Math.abs(innerWidth-rzW)>120){rzW=innerWidth;if(active)renderStrips(active)}},250)});
  const initKey=location.hash.slice(1).toLowerCase();
  select(byKey[initKey]?initKey:'all',false);

  // DJ's filmstrip lightbox: auto-drift + grab momentum, scoped to the open tab
  const lb=document.getElementById('pglb'),strip=document.getElementById('lbStrip'),
        track=document.getElementById('lbTrack'),counter=document.getElementById('lbCounter');
  let list=[],dir=1,hover=false,busy=false,momRaf=0;
  function centered(){
    const c=strip.scrollLeft+strip.clientWidth/2;
    let best=0,bd=Infinity;
    for(let i=0;i<track.children.length;i++){
      const ph=track.children[i],m=ph.offsetLeft+ph.offsetWidth/2,d=Math.abs(m-c);
      if(d<bd){bd=d;best=i}
    }
    return best;
  }
  function setCounter(){if(list.length)counter.innerHTML=(centered()+1)+' / '+list.length+' · <b>'+(active?active.counter:'')+'</b>'}
  function centerOn(i,smooth){
    i=Math.max(0,Math.min(track.children.length-1,i));
    const ph=track.children[i];if(!ph)return;
    const left=ph.offsetLeft-(strip.clientWidth-ph.offsetWidth)/2;
    if(smooth)strip.scrollTo({left:left,behavior:'smooth'});else strip.scrollLeft=left;
  }
  function nudge(d){busy=true;centerOn(centered()+d,true);setTimeout(()=>{busy=false},650)}
  strip.addEventListener('scroll',setCounter,{passive:true});
  function openLb(fig){
    if(fig.dataset.clone)fig=grid.querySelector('.fr[data-id="'+fig.dataset.id+'"]:not([data-clone])')||fig;
    const figs=[...grid.querySelectorAll('.fr:not([data-clone])')];
    const start=Math.max(0,figs.indexOf(fig));
    list=figs;track.innerHTML='';
    figs.forEach(t=>{
      const sl=document.createElement('div');sl.className='pg-lb-slide';
      const im=document.createElement('img');im.className='pg-lb-photo';
      im.src=t.getAttribute('data-full');im.alt='';im.draggable=false;
      sl.appendChild(im);track.appendChild(sl);
    });
    lb.classList.add('open');lb.setAttribute('aria-hidden','false');
    document.body.style.overflow='hidden';if(window.lenis)window.lenis.stop();
    busy=true;dir=1;
    const recenter=()=>{centerOn(start,false);setCounter()};
    recenter();requestAnimationFrame(recenter);
    const im=track.children[start]&&track.children[start].querySelector('img');
    if(im&&!im.complete)im.addEventListener('load',recenter,{once:true});
    setTimeout(recenter,250);
    setTimeout(()=>{recenter();busy=false},720);
  }
  function closeLb(){
    lb.classList.remove('open');lb.setAttribute('aria-hidden','true');
    document.body.style.overflow='';if(window.lenis)window.lenis.start();
  }
  grid.addEventListener('click',e=>{const fig=e.target.closest('.fr');if(fig)openLb(fig)});
  grid.addEventListener('keydown',e=>{
    if(e.key!=='Enter'&&e.key!==' ')return;
    const fig=e.target.closest('.fr');if(fig){e.preventDefault();openLb(fig)}
  });
  document.getElementById('lbX').addEventListener('click',closeLb);
  document.getElementById('lbP').addEventListener('click',()=>nudge(-1));
  document.getElementById('lbN').addEventListener('click',()=>nudge(1));
  addEventListener('keydown',e=>{
    if(!lb.classList.contains('open'))return;
    if(e.key==='Escape')closeLb();
    else if(e.key==='ArrowRight')nudge(1);
    else if(e.key==='ArrowLeft')nudge(-1);
  });
  // gentle auto-drift; pauses while hovering the photos or interacting.
  // driftX keeps a float position because scrollLeft rounds to whole pixels
  // on 1x displays and a .45px step would never accumulate otherwise.
  strip.addEventListener('pointerenter',()=>{hover=true});
  strip.addEventListener('pointerleave',()=>{hover=false});
  let driftX=null;
  (function frame(){
    if(lb.classList.contains('open')&&!hover&&!busy&&!reduce){
      const max=strip.scrollWidth-strip.clientWidth;
      if(max>2){
        if(driftX===null||Math.abs(driftX-strip.scrollLeft)>1.5)driftX=strip.scrollLeft;
        driftX+=.45*dir;
        if(driftX>=max){driftX=max;dir=-1}else if(driftX<=0){driftX=0;dir=1}
        strip.scrollLeft=driftX;
      }
    }else{driftX=null}
    requestAnimationFrame(frame);
  })();
  // grab + weighted momentum
  (function(){
    let down=false,sx=0,ss=0,lx=0,v=0,captured=false;
    strip.addEventListener('pointerdown',e=>{
      if(e.pointerType!=='mouse')return;
      cancelAnimationFrame(momRaf);down=true;busy=true;captured=false;
      sx=e.clientX;lx=e.clientX;v=0;ss=strip.scrollLeft;
    });
    strip.addEventListener('pointermove',e=>{
      if(!down)return;
      const dx=e.clientX-sx;
      if(!captured&&Math.abs(dx)>6){captured=true;strip.classList.add('dragging');try{strip.setPointerCapture(e.pointerId)}catch(_){}}
      v=e.clientX-lx;lx=e.clientX;strip.scrollLeft=ss-dx;
    });
    const up=()=>{
      if(!down)return;down=false;strip.classList.remove('dragging');
      const max=strip.scrollWidth-strip.clientWidth;
      let vel=-v*1.6;
      (function glide(){
        if(Math.abs(vel)<.4){busy=false;return}
        let x=strip.scrollLeft+vel;
        if(x<=0){x=0;vel=0}else if(x>=max){x=max;vel=0}
        strip.scrollLeft=x;vel*=.94;momRaf=requestAnimationFrame(glide);
      })();
    };
    strip.addEventListener('pointerup',up);
    strip.addEventListener('pointercancel',up);
    strip.addEventListener('wheel',e=>{
      const d=Math.abs(e.deltaX)>=Math.abs(e.deltaY)?e.deltaX:e.deltaY;
      e.preventDefault();strip.scrollLeft+=d;
    },{passive:false});
  })();
})();
</script>
<script is:inline>
(function(){
  // P-VIEWER: hero photo-viewer window. Shuffled selection drawn across the whole
  // roll (every 7th id), hard cuts every 2.8s like a real 90s viewer; click = next.
  const img=document.getElementById('pvImg'),well=document.getElementById('pvWell'),status=document.getElementById('pvStatus');
  if(!img||!well||!status)return;
  const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
  const ids=[];
  for(let n=1;n<=100;n+=7)ids.push(String(n).padStart(3,'0'));
  for(let i=ids.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[ids[i],ids[j]]=[ids[j],ids[i]]}
  const src=id=>'/gallery/thumb/p-'+id+'.jpg';
  const mb=id=>(1.3+(parseInt(id,10)*37%19)/10).toFixed(1); /* stable fake size per frame */
  let i=0;
  function show(k){
    i=(k+ids.length)%ids.length;
    const id=ids[i];
    img.src=src(id);
    status.textContent='P-'+id+'.JPG · '+parseInt(id,10)+' of 100 · '+mb(id)+' MB';
    const nx=new Image();nx.src=src(ids[(i+1)%ids.length]); /* preload the next cut */
  }
  show(0);
  let t=0;
  function arm(){if(reduce)return;clearInterval(t);t=setInterval(()=>show(i+1),2800)}
  arm();
  well.addEventListener('click',()=>{show(i+1);arm()});
})();
</script>
<script is:inline>
(function(){
  // OS9 desktop: draggable windows (desktop only), the typed photography quote,
  // and the muted BTS clip that plays only while it's on screen. Visual-first pass.
  var wide=matchMedia('(min-width:1000px)');
  var reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;

  // ---- draggable windows (grab the title bar) ----
  var desk=document.querySelector('.hero-lay');
  var wins=Array.prototype.slice.call(document.querySelectorAll('[data-win]'));
  var ztop=20;
  wins.forEach(function(w){
    var bar=w.querySelector('[data-drag]'); if(!bar||!desk) return;
    bar.addEventListener('pointerdown',function(e){
      if(!wide.matches) return;
      if(e.button!==undefined && e.button!==0) return;
      e.preventDefault();
      ztop++; w.style.zIndex=ztop;
      var r=w.getBoundingClientRect(), dr=desk.getBoundingClientRect();
      w.style.left=(r.left-dr.left)+'px'; w.style.top=(r.top-dr.top)+'px'; w.style.right='auto';
      var ox=e.clientX-r.left, oy=e.clientY-r.top;
      try{bar.setPointerCapture(e.pointerId);}catch(_){}
      function mv(ev){
        var nx=Math.max(-26,Math.min(ev.clientX-dr.left-ox, dr.width-64));
        var ny=Math.max(0,Math.min(ev.clientY-dr.top-oy, dr.height-32));
        w.style.left=nx+'px'; w.style.top=ny+'px';
      }
      function up(){bar.removeEventListener('pointermove',mv);bar.removeEventListener('pointerup',up);try{bar.releasePointerCapture(e.pointerId);}catch(_){}}
      bar.addEventListener('pointermove',mv);
      bar.addEventListener('pointerup',up);
    });
  });

  // ---- desktop icons: draggable like the windows; a real drag suppresses the click ----
  document.querySelectorAll('.dicon').forEach(function(ic){
    var moved=false;
    ic.addEventListener('pointerdown',function(e){
      if(!wide.matches) return;
      if(e.button!==undefined&&e.button!==0) return;
      moved=false;
      var r=ic.getBoundingClientRect(), dr=desk.getBoundingClientRect();
      var ox=e.clientX-r.left, oy=e.clientY-r.top, sx=e.clientX, sy=e.clientY;
      function place(ev){
        if(ic.parentElement!==desk) desk.appendChild(ic);
        ic.style.position='absolute';
        ic.style.left=Math.max(-10,Math.min(ev.clientX-dr.left-ox,dr.width-50))+'px';
        ic.style.top=Math.max(0,Math.min(ev.clientY-dr.top-oy,dr.height-50))+'px';
        ztop++; ic.style.zIndex=ztop;
      }
      function mv(ev){
        if(!moved && Math.hypot(ev.clientX-sx,ev.clientY-sy)<7) return;
        moved=true; ev.preventDefault(); place(ev);
      }
      function up(){ic.removeEventListener('pointermove',mv);ic.removeEventListener('pointerup',up);try{ic.releasePointerCapture(e.pointerId);}catch(_){}}
      try{ic.setPointerCapture(e.pointerId);}catch(_){}
      ic.addEventListener('pointermove',mv);
      ic.addEventListener('pointerup',up);
    });
    // after a drag, swallow the click so the folder doesn't open
    ic.addEventListener('click',function(e){ if(moved){e.preventDefault();e.stopImmediatePropagation();moved=false;} },true);
  });

  // ---- the ✕ closes its window (classic Mac: gone till refresh) ----
  document.querySelectorAll('.win, .pviewer').forEach(function(w){
    var x=Array.prototype.slice.call(w.querySelectorAll('.win-btn, .pv-btn')).find(function(b){return /[✕×✖]/.test(b.textContent);});
    if(!x) return;
    x.style.cursor='pointer';
    x.setAttribute('role','button'); x.setAttribute('aria-label','Close window'); x.setAttribute('tabindex','0');
    function close(){ w.style.display='none'; }
    x.addEventListener('click',close);
    x.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){e.preventDefault();close();} });
    x.addEventListener('pointerdown',function(e){ e.stopPropagation(); }); // don't start a title-bar drag from the button
  });

  // ---- typed photography quotes (Stickies note cycles through them) ----
  var q=document.getElementById('quoteType'),
      qsig=document.getElementById('quoteSig'),
      qbody=document.querySelector('.win-note .nbody');
  var QUOTES=[
    {t:"For the world is movement, and you cannot be stationary in your attitude toward something that is moving.", a:"// Henri Cartier-Bresson"},
    {t:"You don't take a photograph, you make it.", a:"// Ansel Adams"}
  ];
  if(q){
    if(reduce){ q.textContent=QUOTES[0].t; if(qsig)qsig.textContent=QUOTES[0].a; }
    else{
      var k=0,started=false;
      function setSig(a){ if(qsig)qsig.textContent=a; }
      function typeOne(cb){
        var txt=QUOTES[k].t,i=0; setSig(QUOTES[k].a);
        (function step(){ if(i<=txt.length){q.textContent=txt.slice(0,i);i++;setTimeout(step, 40);} else { cb(); } })();
      }
      function cycle(){
        typeOne(function(){
          setTimeout(function(){                       // hold on the finished quote
            if(QUOTES.length<2){ return; }             // single quote: leave it up
            if(qbody)qbody.style.opacity='0';          // fade the note out
            setTimeout(function(){
              k=(k+1)%QUOTES.length; q.textContent='';
              if(qbody)qbody.style.opacity='1';
              cycle();
            },480);
          },4600);
        });
      }
      var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting&&!started){started=true;setTimeout(cycle,520);io.disconnect();}});},{threshold:.35});
      io.observe(q);
    }
  }

  // ---- muted BTS clip: play only while visible ----
  var v=document.getElementById('btsVid');
  if(v){
    v.muted=true;
    var io2=new IntersectionObserver(function(es){es.forEach(function(en){ if(en.isIntersecting){v.play().catch(function(){});} else {v.pause();} });},{threshold:.25});
    io2.observe(v);
  }
})();
</script>
<script is:inline>
// at-foot: mark when the visitor reaches the very bottom (the pinned descriptor + clock
// stay put; the rest of the footer meta settles into one centered line beneath them).
(function(){
  function atBottom(){return window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-4;}
  function upd(){document.body.classList.toggle('at-foot',atBottom());}
  addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd,{passive:true});setTimeout(upd,400);
})();
</script>

<script is:inline>
// footer under-reveal sizing: reserve the underfoot's height under .over
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  if(!uf||!over)return;
  function size(){
    if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px';
  }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
</script>
