---
// page-template.astro - THE ELEMENT LIBRARY. Every case-page element, named, in one
// place, filled with real copy so you can see it working and pull it into any page.
// Each element is preceded by a ◆ name tag saying what it is and which class to pull.
// Fix an element here, then propagate. Not linked in nav + noindexed.
import CallSheet from '../components/CallSheet.astro';
import NextFile from '../components/NextFile.astro';
import PageFooter from '../components/PageFooter.astro';
import RoleTag from '../components/RoleTag.astro';
import SocialWall from '../components/SocialWall.astro';
import '../styles/filmsplit.css';
const AOV = '/case-studies/art-of-visuals';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>Element index · Monuments</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Fragment+Mono:ital@0;1&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style is:global>
:root{
  --ink:#161514; --paper:#F5F3EF; --rose:#EFA1AD; --cobalt:#2438E8; --red:#E0311A; --red-accent:var(--red);
  --dim:#8f8d88; --line:#dcd9d2; --lined:#2c2b29;
  --wrap:1380px; --pad:clamp(22px,4.6vw,44px);
  --disp:'Bricolage Grotesque',sans-serif; --dispw:800; --dispw2:600;
  --serif:'Instrument Serif',serif; --mono:'Fragment Mono',monospace;
  --spark:var(--rose); --struct:var(--rose); --on-rgb:22,21,20; --marker:#e7e4dc; --marker-dark:#9a978f;
}
*{margin:0;box-sizing:border-box}
body{background:var(--ink);color:var(--paper);font-family:var(--disp);font-size:17px;line-height:1.6;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}html{overflow-x:clip}
.mono{font-family:var(--mono);font-size:11px;letter-spacing:.07em;text-transform:uppercase;font-weight:400}
.wrap{max-width:var(--wrap);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}
a{color:inherit;text-decoration:none}

/* chrome */
.corners{position:fixed;inset:0;z-index:60;pointer-events:none;mix-blend-mode:difference}
.corners span{position:absolute;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#fff}
.corners .c1{top:20px;left:38px;pointer-events:auto}
.corners .c1 b{font-family:var(--disp);font-weight:var(--dispw);font-size:34px;letter-spacing:-.01em}
.corners .c1 i{font-style:normal;display:inline-block;animation:spin 7s linear infinite}
.corners .c2{top:26px;right:22px;pointer-events:auto}
.corners .c2 a{font-size:15px;letter-spacing:.06em;margin-left:22px}
.corners .c3{bottom:20px;left:22px}
.corners .c4{bottom:20px;right:22px}
@keyframes spin{to{transform:rotate(360deg)}}
.companion{position:fixed;right:24px;top:50%;z-index:58;font-size:20px;color:#fff;mix-blend-mode:difference;pointer-events:none;will-change:transform;line-height:1}
@media (max-width:900px){.companion{display:none}}

/* library header + the ◆ name tag above every element */
.libhead{padding:16vh 0 5vh}
.libhead .k{color:var(--spark);display:block;margin-bottom:18px}
.libhead h1{font-weight:var(--dispw);font-size:clamp(40px,6.4vw,92px);line-height:.92;letter-spacing:-.035em;text-transform:uppercase}
.libhead h1 .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.libhead p{margin-top:20px;color:var(--dim);max-width:64ch}
.ename{background:var(--ink);border-top:1px dashed var(--lined);padding:30px 0 12px}
.ename .wrap{display:flex;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;align-items:baseline}
.ename .en{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--spark)}
.ename .eu{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);max-width:66ch}

/* HERO */
.hero{position:relative;height:74svh;min-height:540px;overflow:hidden;background:var(--ink)}
.hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:contrast(1.02) brightness(0.56)}
.hero .t{z-index:72;position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);width:104%;text-align:center;color:var(--paper);font-weight:var(--dispw);font-size:clamp(52px,10vw,132px);line-height:.9;letter-spacing:-.035em;text-transform:uppercase;mix-blend-mode:screen}
.hero .t .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:-.01em}
.hero .t .spark{color:var(--spark);mix-blend-mode:normal}
.hero .t .ln{display:block;overflow:hidden;padding-bottom:.18em;margin-bottom:-.18em}
.hero .t .ln>span{display:block;transform:translateY(125%);animation:rise 1s cubic-bezier(.22,1,.36,1) forwards}
.hero .t .ln:nth-child(2)>span{animation-delay:.12s}
@keyframes rise{to{transform:translateY(0)}}
.hero .nfo{z-index:72;position:absolute;right:var(--pad);bottom:10vh;text-align:left;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;line-height:1.9;color:var(--paper);opacity:0;animation:fade 1s .8s forwards}
.hero .nfo .h{color:var(--struct);background:var(--paper);padding:1px 7px;display:inline-block;margin-bottom:8px}
.hero .kck{z-index:72;position:absolute;left:var(--pad);bottom:10vh;font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--paper);opacity:0;animation:fade 1s .7s forwards;line-height:1.9}
.hero .kck b{color:var(--spark);font-weight:400}
@keyframes fade{to{opacity:1}}

/* STAT ROW + ROLE ROW */
.statrow{background:var(--struct);color:rgb(var(--on-rgb));border-bottom:1px solid rgba(var(--on-rgb),.18)}
.statrow>.in{display:flex;justify-content:center;align-items:flex-end;gap:clamp(30px,4.6vw,64px);flex-wrap:wrap;padding:20px var(--pad) 18px}
.stat b{display:block;font-weight:var(--dispw);font-size:clamp(26px,2.7vw,42px);letter-spacing:-.03em;line-height:.92}
.stat span{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:rgba(var(--on-rgb),.66);display:block;margin-top:8px}
.stat .note{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:rgba(var(--on-rgb),.66);line-height:1.9;max-width:30ch;text-align:right}
.stat .note b{font-family:var(--mono);font-size:11px;font-weight:400;letter-spacing:.08em;color:rgb(var(--on-rgb));display:inline}

/* PAPER + THE BRIEF / SIMPLE PARAGRAPH */
.paper{background:var(--paper);color:var(--ink)}
.story{display:grid;grid-template-columns:.62fr 1.38fr;gap:56px 64px;padding-top:9vh;padding-bottom:9vh;align-items:start}
.story .side .k{color:var(--red)}
.story h2{font-weight:var(--dispw);font-size:clamp(26px,3.2vw,44px);letter-spacing:-.03em;line-height:1.02;text-transform:uppercase;margin-top:14px}
.story h2 .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.story .svc{list-style:none;margin:26px 0 0;padding:0}
.story .svc li{font-family:var(--mono);font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:#6d6a64;padding:9px 0;border-top:1px solid var(--line)}
.story .svc li i{font-style:normal;color:var(--red);margin-right:10px}
.story .body p{color:#4c4a45;max-width:60ch;margin-bottom:1.2em;font-size:18px}
.story .body p:first-child{font-size:clamp(19px,1.8vw,24px);line-height:1.5;color:var(--ink)}

/* TWO-COLUMN */
.block{padding-top:9vh;padding-bottom:9vh}
.block .k{color:var(--red);display:block;margin-bottom:12px}
.block h2{font-weight:var(--dispw);font-size:clamp(26px,3.2vw,44px);letter-spacing:-.03em;line-height:1.02;text-transform:uppercase;max-width:24ch;margin:0}
.block h2 .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.block .cols{columns:2;column-gap:64px;margin-top:40px}
.block .cols p{color:#4c4a45;font-size:16.5px;line-height:1.62;margin:0 0 1.25em;break-inside:avoid}
.block .cols p b{color:var(--ink);font-weight:600}
.block-dark{background:var(--ink);color:var(--paper)}
.block-dark .k{color:var(--spark)}
.block-dark h2{color:var(--paper)}
.block-dark .cols p{color:rgba(245,243,239,.74)}
.block-dark .cols p b{color:var(--paper)}
@media(max-width:820px){.block .cols{columns:1}}

/* CHAPTER HEAD */
.white{background:#fff;color:var(--ink)}
.front{padding:8vh 0}
.fhead{display:grid;grid-template-columns:auto 1fr auto;gap:6px 28px;align-items:baseline;border-top:2px solid var(--ink);padding-top:20px}
.fhead .fn{grid-column:1;grid-row:1/3;font-family:var(--mono);font-size:clamp(34px,3.6vw,54px);line-height:.9;color:var(--red)}
.fhead h3{grid-column:2;grid-row:1;font-weight:var(--dispw);font-size:clamp(24px,2.9vw,40px);letter-spacing:-.03em;line-height:1;text-transform:uppercase}
.fhead h3 .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.fhead .dek{grid-column:2/4;grid-row:2;color:#6d6a64;font-size:16px;max-width:62ch}
.fhead .tag{grid-column:3;grid-row:1;justify-self:end;font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
@media(max-width:900px){.fhead{grid-template-columns:1fr}.fhead .fn,.fhead h3,.fhead .dek{grid-column:1;grid-row:auto}.fhead .tag{display:none}}

/* PLATES + BROWSER */
.duo{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,2.2vw,26px);padding:2vh 0 8vh}
.pl{position:relative}
.pl img{width:100%;height:auto;display:block}
.pl .cap{display:block;padding:9px 0 0;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;color:var(--dim);text-transform:uppercase}
.pl .cap b{color:var(--red);font-weight:400}
.browserwrap{padding:2vh 0 9vh}
.browser{border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:0 26px 70px rgba(22,21,20,.12);background:#fff;max-width:980px;margin:0 auto}
.browser .bbar{display:flex;align-items:center;gap:6px;padding:11px 16px;background:#faf9f6;border-bottom:1px solid var(--line)}
.browser .bbar i{width:9px;height:9px;border-radius:50%;background:var(--line)}
.browser .burl{margin:0 auto;font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;color:#6d6a64;background:#fff;border:1px solid var(--line);border-radius:99px;padding:3px 22px}
.browser img{width:100%;height:auto;display:block}
.browsercap{max-width:980px;margin:9px auto 0;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;color:var(--dim);text-transform:uppercase}
.browsercap b{color:var(--red);font-weight:400}

/* INSIGHT */
.insB{position:relative;overflow:hidden;background:var(--paper);color:var(--ink);padding:clamp(60px,12vh,120px) 0}
.insB-mark{position:absolute;top:-.34em;right:2vw;font-family:var(--serif);font-size:clamp(220px,40vw,600px);line-height:1;color:var(--red);opacity:.12;pointer-events:none}
.insB-in{position:relative;z-index:2}
.insB-kick{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin:0 0 20px}
.insB-q{font-family:var(--disp);font-weight:var(--dispw);font-size:clamp(27px,4.6vw,60px);line-height:1.08;letter-spacing:-.02em;text-transform:uppercase;max-width:20ch;margin:0}
.insB-em{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none;letter-spacing:-.01em;color:var(--red)}
.insB-src{margin-top:26px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
.insB .ins-line{opacity:0;transform:translateY(22px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
.insB.in .ins-line{opacity:1;transform:none}
.insB.in .insB-q{transition-delay:.12s}
.insB.in .insB-src{transition-delay:.22s}

/* STAT BEAT */
.statbeat{background:var(--struct);color:rgb(var(--on-rgb))}
.statbeat .in{display:flex;justify-content:center;gap:clamp(34px,7vw,100px);flex-wrap:wrap;text-align:center;padding:10vh var(--pad)}
.statbeat b{display:block;font-weight:var(--dispw);font-size:clamp(40px,5.6vw,86px);letter-spacing:-.04em;line-height:.85}
.statbeat span{display:block;margin-top:14px;font-family:var(--mono);font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:rgba(var(--on-rgb),.72);max-width:22ch}

/* COUNT-UP + CALLOUTS */
.cuwrap{padding:9vh 0 3vh}
.countrow{display:flex;justify-content:center;gap:clamp(30px,6vw,90px);flex-wrap:wrap;text-align:center}
.cu b{display:block;font-family:var(--disp);font-weight:var(--dispw);font-size:clamp(40px,6vw,90px);letter-spacing:-.04em;line-height:.85;color:var(--ink);font-variant-numeric:tabular-nums}
.cu span{display:block;margin-top:12px;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim)}
.calloutwrap{padding:3vh 0 9vh}
.co-body{max-width:60ch;color:var(--ink);font-size:clamp(16px,1.4vw,19px);line-height:1.65;opacity:.85}
.callout.co-pull{position:relative;display:flex;flex-direction:column;gap:10px;margin:34px 0;padding:4px 0 4px 26px}
.co-pull .co-bar{position:absolute;left:0;top:2px;bottom:2px;width:4px;border-radius:4px;background:var(--red)}
.co-pull p{font-family:var(--serif);font-style:italic;font-size:clamp(24px,3.2vw,40px);line-height:1.18;color:var(--ink);max-width:24ch;margin:0}
.co-pull .co-src{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}
.factchips{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}
.chip{font-family:var(--mono);font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink);border:1px solid var(--line);border-radius:99px;padding:9px 15px;display:inline-flex;align-items:center}
.chip b{font-family:var(--disp);font-weight:var(--dispw);font-size:15px;margin-right:7px;letter-spacing:-.02em}

/* FULL-BLEED BREAK */
.break{position:relative;height:52svh;overflow:hidden}
.break img{position:absolute;inset:-12% 0;width:100%;height:124%;object-fit:cover;object-position:50% 50%;will-change:transform}
.break .cap{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center;font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(245,243,239,.92);background:rgba(22,21,20,.42);padding:6px 12px;backdrop-filter:blur(2px)}

/* FILM POSTER */
.film{position:relative;background:var(--ink)}
.film .poster{position:relative;height:86svh;overflow:hidden;cursor:pointer;display:block}
.film .poster img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.72);transition:transform .8s cubic-bezier(.22,1,.36,1)}
.film .poster:hover img{transform:scale(1.03)}
.film .poster .pvid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none}
.film .play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:118px;height:118px;border-radius:50%;border:1.5px solid rgba(245,243,239,.8);display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.7;padding:0 12px;color:var(--paper);font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;background:rgba(22,21,20,.35);backdrop-filter:blur(6px);transition:background .3s,color .3s,transform .3s;z-index:2}
.film .poster:hover .play{background:var(--paper);color:var(--ink);transform:translate(-50%,-50%) scale(1.06)}
.film .fcap{position:absolute;left:var(--pad);bottom:24px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:rgba(245,243,239,.85);z-index:2}

/* CONTACT SHEET */
.gal{padding:9vh 0}
.gal .bar{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:12px;border-bottom:2px solid var(--ink);margin-bottom:16px}
.gal .bar .mono b{color:var(--red)}
.frames{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;grid-auto-flow:dense}
.fr{position:relative;background:#fff;border:1px solid var(--line);padding:8px 8px 26px;opacity:0;transform:translateY(16px) rotate(-.6deg)}
.frames.show .fr{opacity:1;transform:none;transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1),box-shadow .35s;transition-delay:var(--d,0ms)}
.fr img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;filter:saturate(.96)}
.fr .cap{position:absolute;left:9px;bottom:6px;font-family:var(--mono);font-size:9px;color:var(--dim);text-transform:uppercase}
.frames.show .fr:hover{transform:rotate(-1deg) scale(1.03);box-shadow:0 16px 40px rgba(20,20,20,.18);z-index:2;transition-delay:0ms}
.fr.wide{grid-column:span 2}
.fr.wide img{aspect-ratio:8/4.6}
@media (max-width:900px){.frames{grid-template-columns:1fr 1fr}}

/* MASONRY + LIGHTBOX */
.mwrap{padding:6vh 0 9vh}
.mwrap .bar{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;padding-bottom:14px;border-bottom:1px solid var(--line);margin-bottom:22px}
.mgrid{columns:3;column-gap:14px}
.mcell{display:block;width:100%;padding:0;margin:0 0 14px;border:0;background:none;cursor:zoom-in;break-inside:avoid;overflow:hidden;border-radius:2px}
.mcell img{width:100%;height:auto;display:block;transition:transform .6s cubic-bezier(.22,1,.36,1),filter .4s;filter:saturate(.97)}
.mcell:hover img{transform:scale(1.04);filter:saturate(1.05)}
@media(max-width:820px){.mgrid{columns:2}}@media(max-width:480px){.mgrid{columns:1}}
.lbox{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:rgba(8,8,8,.93);opacity:0;pointer-events:none;transition:opacity .32s}
.lbox.on{opacity:1;pointer-events:auto}
.lbox .lb-fig{margin:0;display:inline-flex;flex-direction:column;max-width:92vw;max-height:88vh}
.lbox img{max-width:92vw;max-height:80vh;width:auto;object-fit:contain;box-shadow:0 20px 70px rgba(0,0,0,.6)}
.lbox .lb-cap{width:100%;margin-top:13px;display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap}
.lb-cap .lb-camp{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#fff}
.lb-cap .lb-camp:empty{display:none}
.lb-cap .lb-cam{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:rgba(245,243,239,.4);margin-left:auto}
.lb-cap .lb-cam:empty{display:none}
.lbox button{position:absolute;background:none;border:0;color:#fff;cursor:pointer;font-family:var(--mono)}
.lbox .lb-close{top:20px;right:26px;font-size:24px}
.lbox .lb-prev{left:18px;top:50%;transform:translateY(-50%);font-size:44px;padding:12px}
.lbox .lb-next{right:18px;top:50%;transform:translateY(-50%);font-size:44px;padding:12px}

/* LEDGER */
.bob{padding:2vh 0 8vh}
.bob .bar{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:12px;margin-bottom:4px}
.bob .bar .mono b{color:var(--red)}
.bob-rows{border-top:2px solid var(--ink)}
.bob-row{display:grid;grid-template-columns:118px 1fr auto 28px;align-items:center;gap:18px 26px;padding:14px 2px;border-bottom:1px solid var(--line);transition:background .3s}
.bob-row img{width:118px;aspect-ratio:16/9;object-fit:cover;display:block;border-radius:5px;filter:grayscale(1) contrast(1.04);transition:filter .35s}
.bob-row .bt{font-weight:var(--dispw2);font-size:clamp(17px,1.7vw,23px);letter-spacing:-.015em;line-height:1.05;text-transform:uppercase}
.bob-row .bm{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:#8f8d88;text-align:right}
.bob-row .ba{font-size:14px;color:var(--red);transition:transform .35s cubic-bezier(.22,1,.36,1)}
.bob-row:hover{background:rgba(22,21,20,.035)}.bob-row:hover img{filter:none}.bob-row:hover .ba{transform:translate(4px,-3px)}
@media (max-width:680px){.bob-row{grid-template-columns:86px 1fr 20px}.bob-row .bm{display:none}.bob-row img{width:86px}}

/* QUOTE BAND */
.quote{background:var(--spark);color:var(--ink);padding:13vh 0}
.quote p.q{font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(28px,4vw,58px);line-height:1.14;max-width:26ch}
.quote p.q b{font-style:normal;font-family:var(--disp);font-weight:var(--dispw);text-transform:uppercase;font-size:.86em;letter-spacing:-.02em}
.quote .who{margin-top:28px;color:rgba(22,21,20,.6)}

/* WORD SWITCHER */
.cdd{padding:11vh 0}
.cdd-head{display:flex;gap:clamp(20px,3.4vw,54px);flex-wrap:wrap;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:18px}
.cdd-word{position:relative;background:none;border:0;padding:0 0 6px;cursor:pointer;font-family:var(--disp);font-weight:var(--dispw);font-size:clamp(30px,5.2vw,74px);letter-spacing:-.035em;line-height:1;text-transform:uppercase;color:rgba(22,21,20,.15);transition:color .5s cubic-bezier(.22,1,.36,1)}
.cdd-word.on{color:var(--ink)}
.cdd-word .cdd-bar{position:absolute;left:0;bottom:-19px;height:2px;width:0;background:var(--red)}
.cdd-word.on .cdd-bar{width:100%;transition:width 4.6s linear}
.cdd-stage{margin-top:6vh;display:grid}
.cdd-panel{grid-area:1/1;display:grid;grid-template-columns:1fr 1fr;gap:44px 64px;opacity:0;transform:translateY(16px);pointer-events:none;transition:opacity .6s cubic-bezier(.22,1,.36,1),transform .6s cubic-bezier(.22,1,.36,1)}
.cdd-panel.on{opacity:1;transform:none;pointer-events:auto}
.cdd-col p{color:#4c4a45;font-size:clamp(15px,1.15vw,17px);line-height:1.62;margin-bottom:1em}
.cdd-col p b{color:var(--ink);font-weight:600}
@media(max-width:820px){.cdd-panel{grid-template-columns:1fr;gap:20px}}

/* PILLS */
.pillrow{display:flex;gap:16px;flex-wrap:wrap;align-items:center;padding:8vh 0}
.pill-dark{display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;border:1.5px solid var(--ink);border-radius:99px;padding:11px 20px;transition:background .3s,color .3s;color:var(--ink)}
.pill-dark:hover{background:var(--ink);color:var(--paper)}
.pill-light{display:inline-block;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;border:1.5px solid rgba(245,243,239,.6);border-radius:99px;padding:11px 20px;transition:background .3s,color .3s;color:var(--paper)}
.pill-light:hover{background:var(--paper);color:var(--ink)}

/* KICKERS */
.kset{padding:7vh 0}
.kset-light{background:var(--paper);color:var(--ink)}
.kset-dark{background:var(--ink);color:var(--paper)}
.kset-tag{display:block;text-align:center;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);margin-bottom:5vh;font-size:10.5px}
.kset-dark .kset-tag{color:rgba(245,243,239,.5)}
.kpair{text-align:center;padding:4vh 0}
.kick-eyebrow{display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin-bottom:20px}
.kset-dark .kick-eyebrow{color:var(--spark)}
.k-big{font-family:var(--disp);font-weight:var(--dispw);font-size:clamp(26px,4vw,54px);letter-spacing:-.03em;line-height:1.02;text-transform:uppercase;max-width:20ch;margin:0 auto 26px}
.k-big .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.k-stmt{text-align:center;font-family:var(--disp);font-weight:var(--dispw);font-size:clamp(30px,4.6vw,64px);letter-spacing:-.035em;line-height:1.02;text-transform:uppercase;max-width:18ch;margin:0 auto}
.k-stmt .k-em{color:var(--spark)}
.kset-light .k-stmt .k-em{color:var(--red)}
.k-btn{display:inline-flex;align-items:center;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--paper);background:var(--ink);border-radius:99px;padding:15px 28px;transition:background .3s,color .3s}
.k-btn:hover{background:var(--red);color:#fff}
.k-btn.light{background:var(--paper);color:var(--ink)}

/* CTA BAND */
.cta{background:var(--struct);color:rgb(var(--on-rgb));padding:11vh 0}
.cta .in{display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap}
.cta .big{font-weight:var(--dispw);font-size:clamp(28px,4.2vw,60px);letter-spacing:-.03em;line-height:1;text-transform:uppercase;max-width:16ch}
.cta .ck{display:block;font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:rgba(var(--on-rgb),.7);margin-bottom:14px}
.cta .big .serif{font-family:var(--serif);font-style:italic;font-weight:400;text-transform:none}
.cta a.talk{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;border:1.5px solid rgba(var(--on-rgb),.75);padding:16px 26px;border-radius:50%;transition:background .3s,color .3s,transform .3s;display:inline-block}
.cta a.talk:hover{background:rgb(var(--on-rgb));color:var(--struct);transform:scale(1.05)}

/* CREDITS */
.credits{padding:9vh 0}

.rv{opacity:0;transform:translateY(28px);transition:opacity .85s cubic-bezier(.22,1,.36,1),transform .85s cubic-bezier(.22,1,.36,1)}
.rv.in{opacity:1;transform:none}

@media (max-width:900px){.story{grid-template-columns:1fr}.hero .kck{display:none}}
@media (max-width:680px){.corners .c2,.corners .c3,.corners .c4{display:none}.corners .c1 b{font-size:23px}.hero .t{width:100%!important;font-size:clamp(32px,8.8vw,48px)!important;padding:0 16px}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.hero .t .ln>span{transform:none}.hero .nfo,.hero .kck{opacity:1}.rv,.ins-line{opacity:1;transform:none}.frames .fr{opacity:1;transform:none}}
</style>
</head>
