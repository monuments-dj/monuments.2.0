<div class="lbox" id="kitLbox" role="dialog" aria-label="Image viewer">
  <button class="lb-close" type="button" aria-label="Close">✕</button>
  <button class="lb-prev" type="button" aria-label="Previous">←</button>
  <button class="lb-next" type="button" aria-label="Next">→</button>
  <figure class="lb-fig"><img id="kitLboxImg" alt=""><figcaption class="lb-cap" id="kitLboxCap"><span class="lb-camp"></span><span class="lb-cam"></span></figcaption></figure>
</div>

<script is:inline>
// contact sheet: 7 real frames, wide every 4th, reveal on scroll
(function(){
  var imgs=['xperia-01','xm4-01','xperia-02','xm3-bts','yt-thismoment','stansport-01','podcast-cover'].map(function(n){return '/case-studies/art-of-visuals/gallery/'+n+'.jpg';});
  var el=document.getElementById('frames');if(!el)return;
  el.innerHTML=imgs.map(function(src,i){return '<figure class="fr'+(i%4===0?' wide':'')+'" style="--d:'+(i*45)+'ms"><img src="'+src+'" alt="Contact sheet frame '+(i+1)+'" loading="lazy" decoding="async"><figcaption class="cap">FR-'+String(i+1).padStart(2,'0')+' · ARCHIVE</figcaption></figure>';}).join('');
  new IntersectionObserver(function(es,o){es.forEach(function(e){if(e.isIntersecting){el.classList.add('show');o.disconnect();}});},{threshold:.05,rootMargin:'0px 0px 100px 0px'}).observe(el);
})();

// reveal-on-scroll for .rv and the insight band
(function(){
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.01,rootMargin:'0px 0px 200px 0px'});
  document.querySelectorAll('.rv,[data-ins]').forEach(function(el){io.observe(el);});
})();

// count-up
(function(){
  var cues=[].slice.call(document.querySelectorAll('[data-count]'));if(!cues.length)return;
  var run=function(el){var target=parseFloat(el.getAttribute('data-count'))||0,suf=el.getAttribute('data-suffix')||'',dur=1400,t0=null;
    var step=function(ts){if(!t0)t0=ts;var p=Math.min((ts-t0)/dur,1),e=1-Math.pow(1-p,3);el.textContent=Math.round(target*e).toLocaleString('en-US')+suf;if(p<1)requestAnimationFrame(step);};requestAnimationFrame(step);};
  var cio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){run(e.target);cio.unobserve(e.target);}});},{threshold:.6});
  cues.forEach(function(c){cio.observe(c);});
})();

// word switcher: auto-cycle, click to jump, pause on hover
(function(){
  var sec=document.getElementById('cddkit');if(!sec)return;
  var reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var words=[].slice.call(sec.querySelectorAll('.cdd-word')),panels=[].slice.call(sec.querySelectorAll('.cdd-panel')),cur=0,timer=null,vis=false,paused=false;
  function show(i){cur=(i+panels.length)%panels.length;words.forEach(function(w,j){w.classList.toggle('on',j===cur);});panels.forEach(function(p,j){p.classList.toggle('on',j===cur);});sec.setAttribute('data-i',cur);}
  function arm(){if(timer||reduced)return;timer=setInterval(function(){if(vis&&!paused)show(cur+1);},4600);}
  function disarm(){clearInterval(timer);timer=null;}
  words.forEach(function(w,i){w.addEventListener('click',function(){disarm();show(i);arm();});});
  sec.addEventListener('mouseenter',function(){paused=true;});sec.addEventListener('mouseleave',function(){paused=false;});
  new IntersectionObserver(function(es){es.forEach(function(e){vis=e.isIntersecting;vis?arm():disarm();});},{threshold:.2}).observe(sec);
})();

// masonry lightbox
(function(){
  var grid=document.getElementById('kitMgrid'),lb=document.getElementById('kitLbox');if(!grid||!lb)return;
  var lbImg=document.getElementById('kitLboxImg'),cells=[].slice.call(grid.querySelectorAll('.mcell'));
  var capEl=document.getElementById('kitLboxCap'),campEl=capEl.querySelector('.lb-camp'),camEl=capEl.querySelector('.lb-cam'),idx=0;
  function openL(n){idx=(n+cells.length)%cells.length;var c=cells[idx];lbImg.src=c.getAttribute('data-full');campEl.textContent=c.getAttribute('data-cap')||'';camEl.textContent=c.getAttribute('data-cam')||'';lb.classList.add('on');}
  function closeL(){lb.classList.remove('on');lbImg.src='';}
  cells.forEach(function(c,n){c.addEventListener('click',function(){openL(n);});});
  lb.querySelector('.lb-close').addEventListener('click',closeL);
  lb.querySelector('.lb-next').addEventListener('click',function(){openL(idx+1);});
  lb.querySelector('.lb-prev').addEventListener('click',function(){openL(idx-1);});
  lb.addEventListener('click',function(e){if(e.target===lb)closeL();});
  document.addEventListener('keydown',function(e){if(!lb.classList.contains('on'))return;if(e.key==='Escape')closeL();else if(e.key==='ArrowRight')openL(idx+1);else if(e.key==='ArrowLeft')openL(idx-1);});
})();

// play film snips only while on-screen
(function(){
  var vids=[].slice.call(document.querySelectorAll('.pvid'));if(!vids.length)return;
  var io=new IntersectionObserver(function(es){es.forEach(function(e){var v=e.target;if(e.isIntersecting){var p=v.play();if(p&&p.catch)p.catch(function(){});}else{try{v.pause();}catch(x){}}});},{threshold:.25});
  vids.forEach(function(v){io.observe(v);});
})();

// hero + break parallax + companion drift
(function(){
  var hImg=document.querySelector('.hero>img'),hT=document.querySelector('.hero .t'),nfo=document.querySelector('.hero .nfo'),kck=document.querySelector('.hero .kck'),brk=document.querySelectorAll('.break img'),c=document.querySelector('.companion');
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  var k=false;
  addEventListener('scroll',function(){if(k)return;k=true;requestAnimationFrame(function(){
    var y=scrollY,vh=innerHeight;
    if(y<vh&&hImg){hImg.style.transform='translateY('+(y*.22)+'px) scale(1.02)';if(hT){hT.style.transform='translate(-50%,-50%) translateY('+(y*-.1)+'px)';hT.style.opacity=String(Math.max(0,1-y/(vh*.9)));}if(nfo)nfo.style.transform='translateY('+(y*-.16)+'px)';if(kck)kck.style.transform='translateY('+(y*-.06)+'px)';}
    brk.forEach(function(b){var r=b.parentElement.getBoundingClientRect();if(r.bottom>0&&r.top<vh){var p=(r.top+r.height/2-vh/2)/vh;b.style.transform='translateY('+(p*-56)+'px)';}});
    if(c)c.style.transform='translateY('+(Math.sin(y/420)*34).toFixed(1)+'px) rotate('+(y*0.22).toFixed(1)+'deg)';
    k=false;
  });},{passive:true});
})();

// LA clock
function clock(){var el=document.getElementById('clock');if(!el)return;el.textContent='LA '+new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});}
clock();setInterval(clock,30000);
</script>
</body>
