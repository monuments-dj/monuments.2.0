  let raf=null;
  function upd(){
    raf=null;
    if(sec.classList.contains('rr-live'))return;
    const r=sec.getBoundingClientRect();
    const total=r.height-innerHeight; if(total<=0)return;
    const ih=innerHeight;
    const raw=(ih-r.top)/ih;                       // approach travel: 1 = docked
    const p=Math.min(1,Math.max(0,-r.top/total));  // pin-ride progress
    const wp=Math.min(1,Math.max(0,(raw-0.28)/0.30));
    const wo=Math.max(0,1-Math.max(0,(raw-1.78)/0.24)); // hold solid nearly the whole fill, fade at the very end (DJ)
    const wx=(1-wp)*260;
    wl.style.transform=`translate(${-wx}%,-50%)`;
    wr.style.transform=`translate(${wx}%,-50%)`;
    wl.style.opacity=wr.style.opacity=(Math.min(1,wp*1.5)*wo).toFixed(3);
    const arrive=Math.min(1,Math.max(0,raw));
    // lock stays 55vw (.573 of the 96vw base); the ride now ends near full-bleed
    const s=p>0 ? Math.min(1,0.573+0.64*p) : 0.525+0.048*arrive;
    const dy=(1-arrive)*10;
    panel.style.transform=`translate(-50%,-50%) translateY(${dy.toFixed(2)}vh) scale(${s.toFixed(4)})`;
  }
  function req(){if(!raf)raf=requestAnimationFrame(upd)}
  addEventListener('scroll',req,{passive:true});addEventListener('resize',req,{passive:true});
  upd();
})();
</script>
<script is:inline>
// contact sheet: reshuffles every visit
const POOL=['p-001','p-004','p-008','p-011','p-013','p-017','p-021','p-023','p-025','p-028','p-029','p-030','p-038','p-043','p-044','p-049','p-054','p-057','p-058','p-061','p-066','p-067','p-069','p-076','p-090','p-094','p-098','p-099'];
const NOTES=['USE THIS','THE ONE','HOLD','PRINT IT'];
const shuffled=POOL.map(v=>[Math.random(),v]).sort((a,b)=>a[0]-b[0]).map(x=>x[1]).slice(0,12);
const pick=Math.floor(Math.random()*12),pick2=(pick+5)%12;
document.getElementById('frames').innerHTML=shuffled.map((id,i)=>`
