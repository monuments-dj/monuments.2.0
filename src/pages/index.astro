document.getElementById('tiles').innerHTML=TILES.join('')+TILES.join('');

// reveals
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// magnetic pill
const mag=document.querySelector('.magnetic');
if(mag&&matchMedia('(pointer:fine)').matches){
  let raf;const st={x:0,y:0,tx:0,ty:0};
  mag.addEventListener('mousemove',e=>{
    const r=mag.getBoundingClientRect();
    st.tx=(e.clientX-r.left-r.width/2)*.32;st.ty=(e.clientY-r.top-r.height/2)*.32;loop();
  });
  mag.addEventListener('mouseleave',()=>{st.tx=0;st.ty=0;loop()});
  function loop(){cancelAnimationFrame(raf);(function step(){
    st.x+=(st.tx-st.x)*.16;st.y+=(st.ty-st.y)*.16;
    mag.style.transform=`translate(${st.x}px,${st.y}px)`;
    if(Math.abs(st.tx-st.x)>.2||Math.abs(st.ty-st.y)>.2)raf=requestAnimationFrame(step);
  })()}
}

// clock
// velocity marquee with decay back to base
(function(){
  let ly=scrollY,decaying=false;
  const anims=()=>[...document.querySelectorAll('.tiles .track,.banner .big')].map(el=>el.getAnimations&&el.getAnimations()[0]).filter(Boolean);
  function decay(){
    let live=false;
    anims().forEach(a=>{if(a.playbackRate>1.03){a.playbackRate=1+(a.playbackRate-1)*0.92;live=true}else a.playbackRate=1});
    decaying=live;if(live)requestAnimationFrame(decay);
  }
  addEventListener('scroll',()=>{
    const vel=Math.min(3,Math.abs(scrollY-ly)/18);ly=scrollY;
    anims().forEach(a=>a.playbackRate=Math.max(a.playbackRate,1+vel));
    if(!decaying){decaying=true;requestAnimationFrame(decay)}
  },{passive:true});
})();
function clock(){
  const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});
  document.getElementById('clock').textContent='LA '+t;
}
clock();setInterval(clock,30000);
// the eye watches: pupils track the cursor (buttermax gesture, brand-book witness)
(function(){
  if(!matchMedia('(pointer:fine)').matches||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let mx=innerWidth/2,my=innerHeight/2,raf=null;const st={x:0,y:0};
  addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;if(!raf)step()},{passive:true});
  function step(){raf=requestAnimationFrame(()=>{
    let live=false;
    document.querySelectorAll('.tile.eye .pupil').forEach(pu=>{
      const r=pu.closest('svg').getBoundingClientRect();
      if(r.bottom<0||r.top>innerHeight){return}
      const dx=mx-(r.left+r.width/2),dy=my-(r.top+r.height/2);
      const d=Math.hypot(dx,dy)||1,lim=9;
      const tx=dx/d*Math.min(lim,d/16),ty=dy/d*Math.min(lim,d/16);
      st.x+=(tx-st.x)*.12;st.y+=(ty-st.y)*.12;
      pu.setAttribute('transform',`translate(${st.x.toFixed(2)},${st.y.toFixed(2)})`);
      if(Math.abs(tx-st.x)>.05||Math.abs(ty-st.y)>.05)live=true;
    });
    raf=live?requestAnimationFrame(step):null;if(!live)raf=null;
  })}
})();
// sound toggle on the hero reel (unseen verb)
(function(){
  const hm=document.getElementById('heroMedia');if(!hm)return;
  const btn=document.getElementById('soundTog');if(!btn)return;
  let on=false;
  btn.addEventListener('click',()=>{
    const f=hm.querySelector('iframe');if(!f)return;
    on=!on;
    f.contentWindow.postMessage(JSON.stringify({event:'command',func:on?'unMute':'mute',args:[]}),'*');
    if(on)f.contentWindow.postMessage(JSON.stringify({event:'command',func:'setVolume',args:[80]}),'*');
    btn.innerHTML=on?'<span class="dot" style="background:#3ddc84"></span>Sound on':'<span class="dot"></span>Sound off';
  });
})();
// reel: background video header (desktop, motion-ok) + sound-on lightbox
(function(){
  const REEL='VMubUUZ2tdU';
  const hm=document.getElementById('heroMedia');
  if(hm && matchMedia('(pointer:fine)').matches && innerWidth>900 && !matchMedia('(prefers-reduced-motion:reduce)').matches){
    const f=document.createElement('iframe');
    f.src=`https://www.youtube.com/embed/${REEL}?autoplay=1&mute=1&loop=1&playlist=${REEL}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&start=6&iv_load_policy=3&fs=0&disablekb=1&enablejsapi=1`;
    f.allow='autoplay; encrypted-media';f.title='Showreel background';
    hm.appendChild(f);
    setTimeout(()=>hm.classList.add('live'),1400);
  }
  const box=document.getElementById('reelbox'),mount=document.getElementById('reelMount');
  function open(){
    mount.innerHTML=`<iframe src="https://www.youtube.com/embed/${REEL}?autoplay=1&rel=0&modestbranding=1" allow="autoplay; encrypted-media; fullscreen" allowfullscreen title="Showreel"></iframe>`;
    box.classList.add('on');document.body.style.overflow='hidden';
  }
  function close(){box.classList.remove('on');mount.innerHTML='';document.body.style.overflow=''}
  const pr=document.getElementById('playReel');
  if(pr)pr.addEventListener('click',open);
  document.getElementById('reelClose').addEventListener('click',close);
  box.addEventListener('click',e=>{if(e.target===box)close()});
  addEventListener('keydown',e=>{if(e.key==='Escape')close()});
})();

// footer under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  if(!uf||!over)return;
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
// at-foot: the wordmark spark does a pressure-release spin once you reach the bottom
(function(){
  function atBottom(){return window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-4;}
  function upd(){document.body.classList.toggle('at-foot',atBottom());}
  addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd,{passive:true});setTimeout(upd,500);
})();
// spark companion: drifts + rotates with scroll
(function(){
  const c=document.querySelector('.companion');
  if(!c||matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  let cTick=false;
  addEventListener('scroll',()=>{
    if(cTick)return;cTick=true;
    requestAnimationFrame(()=>{
      c.style.transform=`translateY(${(Math.sin(scrollY/420)*34).toFixed(1)}px) rotate(${(scrollY*0.22).toFixed(1)}deg)`;
      cTick=false;
    });
  },{passive:true});
})();
// split-line rise
(function(){
  const els=document.querySelectorAll('[data-split]');
  if(!els.length)return;
  els.forEach(el=>{
    el.innerHTML=el.innerHTML.split(/<br\s*\/?>/i).map(l=>`<span class="sl"><span>${l}</span></span>`).join('');
  });
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.2});
  els.forEach(el=>io.observe(el));
})();

// reel cards: hover reveals the achievements panel + plays the case snippet (muted)
(function(){
  document.querySelectorAll('.reel-card').forEach(function(card){
    var imgs=card.querySelector('.imgs'); if(!imgs) return;
    var role=card.dataset.role, stats=(card.dataset.stats||'').split('|').filter(Boolean);
    if(role||stats.length){
      var panel=document.createElement('div'); panel.className='rc-panel';
      panel.innerHTML=(role?'<span class="role">'+role+'</span>':'')+(stats.length?'<ul>'+stats.map(function(x){return '<li>'+x+'</li>';}).join('')+'</ul>':'');
      imgs.appendChild(panel);
    }
    var snip=card.dataset.snip;
    if(snip){
      card.addEventListener('mouseenter',function(){
        if(card.querySelector('.imgs video')) return;
        var v=document.createElement('video'); v.src=snip; v.muted=true; v.loop=true; v.playsInline=true;
        v.setAttribute('playsinline',''); v.setAttribute('aria-hidden','true'); v.preload='metadata';
        imgs.appendChild(v); v.play().then(function(){v.classList.add('live');}).catch(function(){});
      });
    }
  });
})();

// pinned reel scrub (tinywins grammar)
(function(){
  const sec=document.querySelector('.reel'),track=document.getElementById('reelTrack'),
        word=document.getElementById('feelWord'),ticks=document.getElementById('ticks');
  if(!sec||!track)return;
  const cards=[...track.querySelectorAll('.reel-card:not(.spacer)')];
  ticks.innerHTML=cards.map(()=>'<i></i>').join('');
  const tickEls=[...ticks.children];
  let cur=-1;
  function setWord(i){
    if(i===cur)return;cur=i;
    word.textContent=cards[i].dataset.word;
    word.classList.remove('swap');void word.offsetWidth;word.classList.add('swap');
    tickEls.forEach((el,j)=>el.classList.toggle('on',j===i));
  }
  setWord(0);
  if(matchMedia('(prefers-reduced-motion:reduce)').matches||innerWidth<=900)return;
  let rTick=false;
  addEventListener('scroll',()=>{
    if(rTick)return;rTick=true;
    requestAnimationFrame(()=>{
      const vh=innerHeight,r=sec.getBoundingClientRect();
      const total=r.height-vh;
      const p=Math.min(1,Math.max(0,-r.top/total));
      const max=Math.max(0,track.scrollWidth-innerWidth);
      track.style.transform=`translateX(${-p*max}px)`;
      const rv=(p-(window.__rp||p))*140;window.__rp=p;
      cards.forEach((c,i)=>{c.style.transform=`translateY(${(Math.sin(p*5+i*1.7)*12).toFixed(1)}px) rotate(${(Math.max(-2.4,Math.min(2.4,rv))*(i%2?-.5:.5)).toFixed(2)}deg)`});
      setWord(Math.min(cards.length-1,Math.floor(p*cards.length)));
      rTick=false;
    });
  },{passive:true});
})();


// hero parallax: image drifts, type counter-drifts (guarded)
if(!matchMedia('(prefers-reduced-motion:reduce)').matches){
  const hImg=document.querySelector('.hero>img'),hT=document.querySelector('.hero .t');
  let hTick=false;
  addEventListener('scroll',()=>{
    if(hTick)return;hTick=true;
    requestAnimationFrame(()=>{
      const y=scrollY;
      if(y<innerHeight){
        const hm=document.getElementById('heroMedia');
        if(hm)hm.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        else if(hImg)hImg.style.transform=`translateY(${y*.22}px) scale(1.02)`;
        if(hT)hT.style.transform=`translate(-50%,-50%) translateY(${y*-.1}px)`;
        if(hT)hT.style.opacity=String(Math.max(0,1-y/(innerHeight*.9)));
        const nfo=document.querySelector('.hero .nfo'),sub=document.querySelector('.hero .sub');
        if(nfo)nfo.style.transform=`translateY(${y*-.16}px)`;
        if(sub)sub.style.transform=`translateY(${y*-.06}px)`;
      }
      hTick=false;
    });
  },{passive:true});
}
// contact sheet stagger
const framesEl=document.getElementById('frames');
if(framesEl){
  [...framesEl.children].forEach((f,i)=>f.style.setProperty('--d',(i*45)+'ms'));
  new IntersectionObserver((es,o)=>{es.forEach(e=>{if(e.isIntersecting){framesEl.classList.add('show');o.disconnect()}})},{threshold:.05,rootMargin:'0px 0px 100px 0px'}).observe(framesEl);
}

