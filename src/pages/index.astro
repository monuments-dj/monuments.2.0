    <rect x="-3" y="-17" width="6" height="34" rx="3" transform="rotate(120)"/>
  </g></g></g>
</svg></div></div>`;
const TILES=[
  EYE,
  `<div class="tile"><img loading="lazy" decoding="async" src="/gallery/thumb/p-067.jpg" alt=""></div>`,
  `<div class="tile ink stat"><b>4x</b><span>revenue growth</span></div>`,
  `<div class="tile"><img loading="lazy" decoding="async" src="/gallery/thumb/p-040.jpg" alt=""></div>`,
  `<div class="tile ros band">Less agency.<br>More rock &amp; roll.</div>`,
  `<div class="tile"><img loading="lazy" decoding="async" src="/gallery/thumb/p-021.jpg" alt=""></div>`,
  `<div class="tile ink stat"><b>Emmy</b><span>Know Vape campaign</span></div>`,
  `<div class="tile"><img loading="lazy" decoding="async" src="/gallery/thumb/p-013.jpg" alt=""></div>`,
  `<div class="tile cob">✳</div>`,
  `<div class="tile"><img loading="lazy" decoding="async" src="/gallery/thumb/p-069.jpg" alt=""></div>`,
  `<div class="tile ink stat"><b>18K+</b><span>conversations started</span></div>`,
  `<div class="tile"><img loading="lazy" decoding="async" src="/gallery/thumb/p-054.jpg" alt=""></div>`,
  `<div class="tile ros band">Every great story<br>is a human story.</div>`,
  `<div class="tile"><img loading="lazy" decoding="async" src="/gallery/thumb/p-098.jpg" alt=""></div>`,
  `<div class="tile ink stat"><b>5→30+</b><span>creatives led</span></div>`,
  `<div class="tile blk">m</div>`,
  `<div class="tile"><img loading="lazy" decoding="async" src="/gallery/thumb/p-090.jpg" alt=""></div>`,
  `<div class="tile ink stat"><b>Sony ×4</b><span>came back · Adorama ×3</span></div>`,
