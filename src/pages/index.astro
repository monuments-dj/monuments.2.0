// tile strip (doubled for seamless loop)
const EYE=`<div class="tile eye"><div class="eyewrap"><svg viewBox="0 0 100 100" aria-label="The Monuments eye">
  <path d="M8 50 C30 24 70 24 92 50 C70 76 30 76 8 50 Z" fill="none" stroke="currentColor" stroke-width="7"/>
