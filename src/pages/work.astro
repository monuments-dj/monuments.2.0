<script is:inline>
(function(){const g=document.getElementById('rays');let s='';for(let i=0;i<20;i++){s+=`<path d="M0,-34 L-8,-92 L8,-92 Z" transform="rotate(${i*18})"/>`}g.innerHTML=s})();

// hero contact-sheet spill: frames pulled from the archive rows themselves
(function(){
  const spill=document.getElementById('spill');if(!spill)return;
  const imgs=[...document.querySelectorAll('.rowp')].map(r=>r.dataset.img).filter(Boolean);
  if(!imgs.length)return;
  // slot: [left%, top%, width px, rotate deg, drift speed]
  const SLOTS=[
    [-2,4,225,-7,-.10],[13,-6,185,4,.07],[29,9,165,-3,-.05],[45,-7,210,6,.09],
    [61,7,180,-5,-.08],[79,-4,225,3,.06],[87,32,205,-6,-.11],[68,46,230,5,.08],
    [38,44,170,-4,-.06],[4,38,150,8,.10]
  ];
  const pick=[0,1,2,3,4,6,7,10,12,14]; // spread across the roll
  const frames=SLOTS.map((s,i)=>{
    const el=document.createElement('span');el.className='frm';
    el.style.cssText=`--l:${s[0]}%;--t:${s[1]}%;--w:${s[2]}px;--r:${s[3]}deg`;
    el.dataset.sp=s[4];
    el.innerHTML=`<img src="${imgs[pick[i]%imgs.length]}" alt="" loading="lazy" decoding="async">`;
    spill.appendChild(el);return el;
  });
  if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
  const hero=document.querySelector('.hero');let tick=false;
  function drift(){
    const y=scrollY;
    if(y<hero.offsetHeight+240)frames.forEach(f=>{
      f.style.transform=`translate3d(0,${(y*f.dataset.sp).toFixed(1)}px,0) rotate(${f.style.getPropertyValue('--r')})`;
    });
    tick=false;
  }
  addEventListener('scroll',()=>{if(!tick){tick=true;requestAnimationFrame(drift)}},{passive:true});
})();

// rose logo slider: every brand on file
(function(){
  const LOGOS=[['Sony','/logos/sony.png'],['Intel','/logos/intel.png'],['Adorama','/logos/adorama.png'],['MSI','/logos/msi.png'],['Lexar','/logos/lexar.png'],['Flashpoint','/logos/flashpoint.png'],['Art of Visuals','/logos/art-of-visuals.png'],['Blue Cross of Idaho','/logos/blue-cross.png'],['Donut Media','/logos/donut-media.svg'],['DW Drums','/logos/dw-drums.png'],['Against','/logos/against.png']];
  const t=LOGOS.map(([n,s])=>`<span class="lgi"><img src="${s}" alt="${n}" loading="lazy"></span>`).join('');
  document.getElementById('stripTrack').innerHTML=t+t;
})();

const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.01,rootMargin:'0px 0px 300px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));

// discipline lens: highlight matching rows, dim the rest (never hide)
(function(){
  const rows=[...document.querySelectorAll('.rowp')];
  const btns=[...document.querySelectorAll('#lens button')];
  // counts
  btns.forEach(b=>{
    const d=b.dataset.d;
    const n=d==='all'?rows.length:rows.filter(r=>(r.dataset.disc||'').split(',').includes(d)).length;
    b.querySelector('b').textContent=String(n).padStart(2,'0');
  });
  function set(d){
    btns.forEach(b=>b.classList.toggle('on',b.dataset.d===d));
    if(d==='all'){document.body.classList.remove('lensed');rows.forEach(r=>r.classList.remove('match'));return}
    document.body.classList.add('lensed');
    rows.forEach(r=>r.classList.toggle('match',(r.dataset.disc||'').split(',').includes(d)));
  }
  btns.forEach(b=>b.addEventListener('click',()=>set(b.dataset.d)));
})();

// grid view: sortable portfolio (FLIP reorder)
(function(){
  const rows=[...document.querySelectorAll('.rowp')];
  const grid=document.getElementById('grid');
  const DISC_ORDER=['commercial','cd','photo','experiential','campaign','oncam'];
  const DISC_LABEL={commercial:'Commercial directing',cd:'Creative direction',photo:'Photography',experiential:'Experiential',campaign:'Campaign development',oncam:'On-camera'};
  const items=rows.map((r,i)=>({
    href:r.getAttribute('href'),img:r.dataset.img,logo:r.dataset.logo||'',disc:(r.dataset.disc||'').split(','),
    video:r.dataset.video||'',vstart:r.dataset.vstart||'',
    title:r.querySelector('.t').textContent.trim(),
    fmt:(r.querySelector('.fmt')?.textContent||'').replace(/\\/,'').trim(),
    yr:parseInt(r.querySelector('.yr')?.textContent||'0',10),id:r.querySelector('.id')?.textContent.trim()||'' ,idx:i}));
  function el(it){const a=document.createElement('a');a.className='gcard'+(it.video?' vcard':'');a.href=it.href;a.dataset.key=it.idx;a.dataset.disc=it.disc.join(',');
    if(it.video){a.dataset.video=it.video;if(it.vstart)a.dataset.vstart=it.vstart}
    const cats=it.disc.map(d=>DISC_LABEL[d]).filter(Boolean).join(' · ');
    a.innerHTML=`<span class="iw"><img class="cv" src="${it.img}" alt="${it.title}" loading="lazy"></span><div class="band"><span class="lft"><span class="t">${it.title}</span><span class="cats">${cats}</span></span>${it.logo?`<img class="lg" src="${it.logo}" alt="">`:''}</div>`;return a}
  items.forEach(it=>grid.appendChild(el(it)));
  let sort='new';
  function currentFilter(){const on=document.querySelector('#lens button.on');return on?on.dataset.d:'all'}
  function apply(animate=true){
    window.__vprevOff?.(); // pause video previews: DOM moves reload iframes
    const first=new Map([...grid.children].map(c=>[c.dataset.key,c.getBoundingClientRect()]));
    let list=[...grid.children];
    const d=currentFilter();
    list.forEach(c=>{c.style.display=(d==='all'||c.dataset.disc.split(',').includes(d))?'':'none'});
    const vis=list.filter(c=>c.style.display!=='none');
    const key=c=>items[+c.dataset.key];
    vis.sort((a,b)=>{
      if(sort==='az')return key(a).title.localeCompare(key(b).title);
      if(sort==='disc')return DISC_ORDER.indexOf(key(a).disc[0])-DISC_ORDER.indexOf(key(b).disc[0])||key(b).yr-key(a).yr;
      return key(b).yr-key(a).yr;
    });
    vis.forEach(c=>grid.appendChild(c));
    if(!animate||matchMedia('(prefers-reduced-motion:reduce)').matches){window.__vprevOn?.();return}
    vis.forEach(c=>{
      const f=first.get(c.dataset.key),l=c.getBoundingClientRect();
      if(!f)return;const dx=f.left-l.left,dy=f.top-l.top;
      if(!dx&&!dy)return;
      c.classList.remove('flip');c.style.transform=`translate(${dx}px,${dy}px)`;
      void c.offsetWidth;c.classList.add('flip');c.style.transform='';
    });
    setTimeout(()=>window.__vprevOn?.(),600); // remount after the FLIP settles
  }
  document.querySelectorAll('.viewbar button[data-view]').forEach(b=>b.addEventListener('click',()=>{
    document.querySelectorAll('.viewbar button[data-view]').forEach(x=>x.classList.toggle('on',x===b));
    const gridOn=b.dataset.view==='grid';
    document.body.classList.toggle('gridview',gridOn);
    document.getElementById('sorters').style.display=gridOn?'':'none';
    if(gridOn)apply(false);
  }));
  // grid is the default view
  document.body.classList.add('gridview');
  apply(false);
  document.querySelectorAll('#sorters button').forEach(b=>b.addEventListener('click',()=>{
    document.querySelectorAll('#sorters button').forEach(x=>x.classList.toggle('on',x===b));
    sort=b.dataset.sort;apply();
  }));
  // lens buttons also drive the grid when grid view is on
  document.querySelectorAll('#lens button').forEach(b=>b.addEventListener('click',()=>{
    if(document.body.classList.contains('gridview'))setTimeout(()=>apply(),0);
  }));
})();

// grid video previews: muted loops that mount in view, unmount out of view (max 6, FIFO)
(function(){
  const mq=matchMedia('(min-width:901px)'),rm=matchMedia('(prefers-reduced-motion:reduce)');
  const cards=[...document.querySelectorAll('#grid .gcard.vcard')];
  if(!cards.length)return;
  const MAX=6;let mounted=[];
  function mount(c){
    if(c.querySelector('iframe'))return;
    while(mounted.length>=MAX)unmount(mounted[0]); // FIFO: oldest preview yields
    const id=c.dataset.video,st=c.dataset.vstart;
    const f=document.createElement('iframe');
    f.src=`https://www.youtube-nocookie.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&disablekb=1${st?`&start=${st}`:''}`;
    f.allow='autoplay; encrypted-media';f.loading='lazy';f.tabIndex=-1;f.setAttribute('aria-hidden','true');f.title='Case film preview';
    f.addEventListener('load',()=>setTimeout(()=>f.classList.add('live'),450));
    c.querySelector('.iw').appendChild(f);mounted.push(c);
  }
  function unmount(c){const f=c.querySelector('iframe');if(f)f.remove();mounted=mounted.filter(x=>x!==c)}
  const vio=new IntersectionObserver(es=>{
    if(!mq.matches||rm.matches)return;
    es.forEach(e=>e.isIntersecting?mount(e.target):unmount(e.target));
  },{rootMargin:'80px 0px 80px 0px',threshold:.01});
  window.__vprevOn=()=>{if(!mq.matches||rm.matches)return;cards.forEach(c=>vio.observe(c))};
  window.__vprevOff=()=>{vio.disconnect();mounted.slice().forEach(unmount)};
  if(mq.matches&&!rm.matches)window.__vprevOn();
  mq.addEventListener?.('change',()=>{(mq.matches&&!rm.matches)?window.__vprevOn():window.__vprevOff()});
})();

// scroll-lit rows
(function(){
  const rows=document.querySelectorAll('.litrow');
  const io2=new IntersectionObserver(es=>es.forEach(e=>e.target.classList.toggle('lit',e.isIntersecting)),{rootMargin:'-30% 0px -30% 0px'});
  rows.forEach(r=>io2.observe(r));
})();

// cursor-trailing preview
(function(){
  const pv=document.getElementById('preview'),pimg=pv.querySelector('img'),pcap=pv.querySelector('.cap');
  if(!matchMedia('(pointer:fine)').matches)return;
  let px=0,py=0,tx=0,ty=0,raf=null;
  document.querySelectorAll('.rowp').forEach(row=>{
    row.addEventListener('mouseenter',()=>{pimg.src=row.dataset.img;pcap.textContent=row.dataset.cap;pv.classList.add('on')});
    row.addEventListener('mouseleave',()=>pv.classList.remove('on'));
  });
  addEventListener('mousemove',e=>{tx=e.clientX+30;ty=e.clientY-120;if(!raf)step()},{passive:true});
  function step(){raf=requestAnimationFrame(()=>{
    px+=(tx-px)*.13;py+=(ty-py)*.13;
    pv.style.left=px+'px';pv.style.top=py+'px';
    (Math.abs(tx-px)>.5||Math.abs(ty-py)>.5)?step():raf=null;
  })}
})();

// under-reveal sizing
(function(){
  const uf=document.querySelector('.underfoot'),over=document.querySelector('.over');
  function size(){ if(matchMedia('(max-width:900px),(prefers-reduced-motion:reduce)').matches){over.style.marginBottom='0px';return}
    over.style.marginBottom=uf.offsetHeight+'px'; }
  size();addEventListener('resize',size);setTimeout(size,600);
})();
// companion
(function(){
  const c=document.querySelector('.companion');
  let k=false;
  addEventListener('scroll',()=>{
    if(k)return;k=true;
    requestAnimationFrame(()=>{
      if(c&&!matchMedia('(prefers-reduced-motion:reduce)').matches)
        c.style.transform=`translateY(${(Math.sin(scrollY/420)*34).toFixed(1)}px) rotate(${(scrollY*0.22).toFixed(1)}deg)`;
      k=false;
    });
  },{passive:true});
})();
// split-line rise
(function(){
  const els=document.querySelectorAll('[data-split]');
  els.forEach(el=>{el.innerHTML=el.innerHTML.split(/<br[^>]*>/i).map(l=>`<span class="sl"><span>${l}</span></span>`).join('')});
  const io3=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io3.unobserve(e.target)}}),{threshold:.2});
  els.forEach(el=>io3.observe(el));
})();
// magnetic pill
(function(){
  const mag=document.querySelector('.magnetic');
  if(!mag||!matchMedia('(pointer:fine)').matches)return;
  let raf;const st={x:0,y:0,tx:0,ty:0};
  mag.addEventListener('mousemove',e=>{const r=mag.getBoundingClientRect();st.tx=(e.clientX-r.left-r.width/2)*.32;st.ty=(e.clientY-r.top-r.height/2)*.32;loop()});
  mag.addEventListener('mouseleave',()=>{st.tx=0;st.ty=0;loop()});
  function loop(){cancelAnimationFrame(raf);(function step(){st.x+=(st.tx-st.x)*.16;st.y+=(st.ty-st.y)*.16;mag.style.transform=`translate(${st.x}px,${st.y}px)`;if(Math.abs(st.tx-st.x)>.2||Math.abs(st.ty-st.y)>.2)raf=requestAnimationFrame(step)})()}
})();
// velocity marquee with decay back to base
(function(){
  let ly=scrollY,decaying=false;
  const anims=()=>[...document.querySelectorAll('.strip .track')].map(el=>el.getAnimations&&el.getAnimations()[0]).filter(Boolean);
  function decay(){
    let live=false;
    anims().forEach(a=>{if(a.playbackRate>1.03){a.playbackRate=1+(a.playbackRate-1)*0.92;live=true}else a.playbackRate=1});
    decaying=live;if(live)requestAnimationFrame(decay);
  }
  addEventListener('scroll',()=>{
    const vel=Math.min(3,Math.abs(scrollY-ly)/18);ly=scrollY;
    anims().forEach(a=>a.playbackRate=Math.max(a.playbackRate,1+vel));
    if(!decaying){decaying=true;requestAnimationFrame(decay)}
  },{passive:true});
})();
function clock(){const t=new Date().toLocaleTimeString('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',minute:'2-digit'});document.getElementById('clock').textContent='LA '+t}
clock();setInterval(clock,30000);
</script>
